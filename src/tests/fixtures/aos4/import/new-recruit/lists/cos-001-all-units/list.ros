ypeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="7p18irh" name="Champion" entryId="b45e-2e9b-f0fa-31e7::1417-93de-02ac-d973::9c21-1746-9873-a5b5" entryGroupId="b45e-2e9b-f0fa-31e7::b723-1382-32aa-dbab" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="7qnsgej" name="Trailhound's Ferocious Bite" entryId="b45e-2e9b-f0fa-31e7::8929-815d-9166-2a73" number="1" type="upgrade" from="entry"><profiles><profile id="858b-f1bd-3bad-4e7e" name="Trailhound's Ferocious Bite" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="7ad6-4d15-5ec2-da40" name="CHAMPION (1/11)" entryId="7ad6-4d15-5ec2-da40" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /><category id="4acc-87fa-ee52-4e51" name="Sigmarite Infantry" entryId="4acc-87fa-ee52-4e51" primary="false" /></categories></selection><selection id="8bhg55" name="Gate Gargants" entryId="af55-6094-2090-2e3a::7998-c3aa-9d41-ee11" number="1" type="unit" from="entry"><profiles><profile id="0b8d-0188-cb6d-c396" name="Gate Gargants" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">10</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="9d6f-bfcc-2fcf-8f91" name="Aggressive Defenders" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 other visible friendly **^^Sigmarite^^** units in combat with any enemy units that are in combat with this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Each target can use **^^Shoot^^** and/or **^^Charge^^** abilitie even if it used a **^^Retreat^^** ability this turn. In addition, no mortal damage is inflicted on the targets by **^^Retreat^^** abilities for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="a0f1-03ef-6a56-5862" name="Open the Gates!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly non-**^^War Machine Cities of Sigmar^^** unit wholly within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 2 to charge rolls for the target for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="8chct4f" name="Gate Gargants" entryId="af55-6094-2090-2e3a::95b4-2ff9-c575-e0ec" number="2" type="model" from="entry"><selections><selection id="8c1gdvh" name="Massive Warmaul" entryId="af55-6094-2090-2e3a::79f4-3ba2-f18d-c462" number="2" type="upgrade" from="entry"><profiles><profile id="7f97-17ca-0ead-cc5e" name="Massive Warmaul" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="8cik2rr" name="Scattershot Cannon" entryId="af55-6094-2090-2e3a::53fe-6602-179b-ff7a" number="2" type="upgrade" from="entry"><profiles><profile id="c1e5-4a0a-5aa7-58d1" name="Scattershot Cannon" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">5</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="320" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /></categories></selection><selection id="90tkreh" name="Kharibdyss" entryId="1ca4-a67f-4c9a-d980::ae46-44ae-4d68-6386" number="1" type="unit" from="entry"><profiles><profile id="2ba8-9ff7-25bf-31a3" name="Kharibdyss" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="9fcb-40dd-c4b9-deed" name="Goaded and Whipped" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Double the Attacks characteristic of this unit's **Companion** melee weapons for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="0b9d-2620-aa0c-0e4f" name="Abyssal Howl" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, the target has a maximum control score of
1 for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="90jjy3f" name="Kharibdyss" entryId="1ca4-a67f-4c9a-d980::c913-eb20-6004-52ad" number="1" type="model" from="entry"><selections><selection id="91oxoc" name="Fanged Tentacles and Spiked Tail" entryId="1ca4-a67f-4c9a-d980::8930-e35f-e347-552b" number="1" type="upgrade" from="entry"><profiles><profile id="a5c3-f943-bdbf-5bb6" name="Fanged Tentacles and Spiked Tail" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="150" /></costs><categories><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /></categories></selection><selection id="9pbvwej" name="War Hydra" entryId="7890-bf9c-b4ea-a2e7::7031-9a79-bad7-203a" number="1" type="unit" from="entry"><profiles><profile id="ec85-fd12-5a8f-1541" name="War Hydra" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="88c1-736c-9c99-3ec5" name="Impossible To Destroy" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this unit would be destroyed, before removing it from play, roll 6 dice. Subtract 1 from the number of dice rolled for each **destroyed head token** this unit has. If any of the rolls are a 5+, this unit is not destroyed and any remaining damage points inflicted on it have no effect. Then, **Heal (1)** this unit for each 5+. Finally, give this unit 1 **destroyed head token**.</characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="f183-fbad-6a6e-27dd" name="Six-headed Strike" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll 6 dice. For each 3+, inflict 1 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="9pa1b4m" name="War Hydra" entryId="7890-bf9c-b4ea-a2e7::f839-c484-b00b-c9af" number="1" type="model" from="entry"><selections><selection id="9qa39o" name="Fiery Breath" entryId="7890-bf9c-b4ea-a2e7::cda-3c7d-57ce-fb43" number="1" type="upgrade" from="entry"><profiles><profile id="2805-3f95-4abb-fbe" name="Fiery Breath" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">-</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat, Companion</characteristic></characteristics></profile></profiles></selection><selection id="9qi9yrq" name="Razor-sharp Fangs" entryId="7890-bf9c-b4ea-a2e7::b1a9-83ec-5c05-95c1" number="1" type="upgrade" from="entry"><profiles><profile id="313c-9f05-986-6ff8" name="Razor-sharp Fangs" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Infantry^^** (+1 Rend), Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="170" /></costs><categories><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /></categories></selection><selection id="aae3z" name="Celestial Hurricanum" entryId="4908-676b-34f0-f2a4::d5a5-3182-b4f8-52a" number="1" type="unit" from="entry"><profiles><profile id="edc1-30f6-8399-97cb" name="Celestial Hurricanum" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">10</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="3d36-c99d-6221-d9fd" name="Storm of Shemtek" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make a number of D3 rolls equal to the current battle round number. For each 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="2ad4-9e95-8cb8-a74c" name="Portents of Battle" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **^^Cities of Sigmar Human^^** unit wholly within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, add 1 to hit rolls for the target's combat attacks until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="ab31wos" name="Celestial Hurricanum" entryId="4908-676b-34f0-f2a4::46a7-502-2cff-81d4" number="1" type="model" from="entry"><selections><selection id="acxg4n" name="Warhorse's Steel-shod Hooves" entryId="4908-676b-34f0-f2a4::cafb-916d-a413-d139" number="1" type="upgrade" from="entry"><profiles><profile id="f209-d96a-8bbf-2730" name="Warhorses' Steel-shod Hooves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="170" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /><category id="dac6-0751-367f-5cab" name="Sigmarite War Machine" entryId="dac6-0751-367f-5cab" primary="false" /></categories></selection><selection id="b4wgaxn" name="Drakespawn Chariot" entryId="a8c8-3133-fda2-244b::672e-438c-24a6-5fc4" number="1" type="unit" from="entry"><profiles><profile id="3a38-5c87-ad4-24dc" name="Drakespawn Chariot" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="e7e-9463-722-f0b9" name="Scythed Runners" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this phase, pick an enemy unit within 1&quot; of it to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="b4uard" name="Drakespawn Chariot" entryId="a8c8-3133-fda2-244b::17d-f273-19c9-15e2" number="1" type="model" from="entry"><selections><selection id="b5l210h" name="Barbed Spear" entryId="a8c8-3133-fda2-244b::cff-fb79-f239-e8fb" number="1" type="upgrade" from="entry"><profiles><profile id="5a36-a99d-9037-dde7" name="Barbed Spear" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="b50sysd" name="Drakespawn's Ferocious Jaws" entryId="a8c8-3133-fda2-244b::1cc5-8147-20e3-29b8" number="1" type="upgrade" from="entry"><profiles><profile id="bad-1f24-58ea-d696" name="Drakespawn's Ferocious Jaws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /></categories></selection><selection id="bx8nnjx" name="Gyrobomber" entryId="2e3d-c98e-1c9f-dd7f::f6b5-64f8-206a-1789" number="1" type="unit" from="entry"><profiles><profile id="2412-930e-3f5e-941" name="Gyrobomber" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="63ec-904c-b04d-116f" name="Grudgebuster Bombs" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit used a **^^Move^^** ability this phase, pick an enemy unit that does not have **^^Fly^^** and that this unit passed across this turn to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of the following effects:
***Tactical Bombing:*** Roll a D3. On a 2+, inflict an amount of mortal damage on the target equal to the roll.
***Drop It All!:*** Make 2 rolls of D3. For each 2+, inflict an amount of mortal damage on the target equal to the roll. Then, roll a D3 for each unit (friendly and enemy) within the target's combat range that does not have **^^Fly^^**. On a 2+, inflict an amount of mortal damage on that unit equal to the roll. Once the 'Drop It All!' effect of this ability has been resolved, this unit cannot use this ability again for the rest of the battle.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="bynr6rg" name="Gyrobomber" entryId="2e3d-c98e-1c9f-dd7f::3a7c-8811-f230-e06" number="1" type="model" from="entry"><selections><selection id="byh6oe8" name="Clattergun" entryId="2e3d-c98e-1c9f-dd7f::5a77-29ef-cf55-ee07" number="1" type="upgrade" from="entry"><profiles><profile id="94d5-6c5b-c843-205e" name="Clattergun" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="bymygh" name="Rotor Blades" entryId="2e3d-c98e-1c9f-dd7f::b844-ca93-f260-d2e" number="1" type="upgrade" from="entry"><profiles><profile id="a45a-3586-89fe-616e" name="Rotor Blades" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="72e3-7b1b-cb94-4cbd" name="DUARDIN" entryId="72e3-7b1b-cb94-4cbd" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /></categories></selection><selection id="cl811us" name="Gyrocopter" entryId="3f68-b234-e29d-bcb6::a641-c2fa-e6d1-40ff" number="1" type="unit" from="entry"><profiles><profile id="7b21-8936-1be2-96be" name="Gyrocopter" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="a4-12f1-9264-1ccb" name="Guild Bombs" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit used a **^^Move^^** ability this phase, pick an enemy unit that does not have **^^Fly^^** and that this unit passed across this turn to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="cm6bpxf" name="Gyrocopter" entryId="3f68-b234-e29d-bcb6::2039-c10a-5abe-6983" number="1" type="model" from="entry"><selections><selection id="cm945dk" name="Gyrocopter Guns" entryId="3f68-b234-e29d-bcb6::796e-6466-3202-181f" number="1" type="upgrade" from="entry"><profiles><profile id="b4-4d9b-5574-ad4c" name="Gyrocopter Guns" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">5</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="cm9nyrv" name="Rotor Blades" entryId="3f68-b234-e29d-bcb6::50e6-aab4-38f7-739e" number="1" type="upgrade" from="entry"><profiles><profile id="1885-de2b-e56b-8bb0" name="Rotor Blades" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="72e3-7b1b-cb94-4cbd" name="DUARDIN" entryId="72e3-7b1b-cb94-4cbd" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /></categories></selection><selection id="dkn0z1a" name="Ironweld Great Cannon" entryId="1792-e391-bd97-34aa::8186-4957-8449-590c" number="1" type="unit" from="entry"><profiles><profile id="f55a-7e5-de04-f6c1" name="Ironweld Great Cannon" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">3&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="81a9-6f2b-e63b-d6df" name="Relentless Bombardment" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit that was targeted by this unit's shooting attacks this phase to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if this unit is **under orders**. On a 3+, subtract 2 from charge rolls and run rolls for the target unit until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="dleydse" name="Ironweld Great Cannon" entryId="1792-e391-bd97-34aa::4354-5236-2cfe-4ff4" number="1" type="model" from="entry"><selections><selection id="dmzbwi4" name="Crew's Tools and Sidearms" entryId="1792-e391-bd97-34aa::b52d-8b66-2a52-303b" number="1" type="upgrade" from="entry"><profiles><profile id="b2f7-8e3-ad6c-93d5" name="Crew's Tools and Sidearms" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="dmwia5" name="Great Cannon" entryId="1792-e391-bd97-34aa::8ccb-f04b-d0dc-abaf" number="1" type="upgrade" from="entry"><profiles><profile id="4831-1516-9f1a-8054" name="Great Cannon" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">24&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3+2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="140" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /><category id="dac6-0751-367f-5cab" name="Sigmarite War Machine" entryId="dac6-0751-367f-5cab" primary="false" /></categories></selection><selection id="eprzr99" name="Luminark of Hysh" entryId="f57d-6269-7436-fd5::9d8a-508e-c6e4-b096" number="1" type="unit" from="entry"><profiles><profile id="32f2-b5c8-dc14-518e" name="Luminark of Hysh" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">10</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="a7df-d760-56f5-6443" name="Searing Beam of Light" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this unit attacks with its **Searing Beam of Light**, pick a point on the battlefield within range to be the target. If the attack scores a hit, draw a straight line between that point and the closest point on this unit's base. Inflict D3 mortal damage on each visible unit (friendly and enemy) that the line passes across.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="e1f4-90e5-462c-541" name="Aura of Protection" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **^^Cities of Sigmar^^** unit wholly within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, until the start of your next turn, the target has **^^Ward (6+)^^** while it is wholly within 12&quot; of and visible to this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attr