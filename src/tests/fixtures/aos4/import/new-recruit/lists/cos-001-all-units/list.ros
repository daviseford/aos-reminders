75-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="926c-df8c-6841-d49e" entryId="926c-df8c-6841-d49e" name="CAVALRY" primary="true" /><category id="73c-8e22-9dde-f97" name="STANDARD BEARER (1/5)" entryId="73c-8e22-9dde-f97" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="dd6f-27e9-b16e-24ee" name="MUSICIAN (1/5)" entryId="dd6f-27e9-b16e-24ee" primary="false" /></categories></selection><selection id="l1b9ros" name="Freeguild Cavaliers" entryId="337f-9f5b-ab79-bf66::80f5-4df3-c41b-f6f7" number="1" type="unit" from="entry"><profiles><profile id="ea9c-cd1c-5394-7032" name="Freeguild Cavaliers" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">3</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="c70-e671-f193-3c85" name="Storm of Steel" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit is in combat and has not charged this turn, pick an enemy unit that it is in combat with and up to 1 friendly **Freeguild Cavalier-Marshal** within this unit's combat range to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is **under orders**, apply the effect below. Otherwise, roll a dice. On a 3+, apply the effect below.
This unit and the friendly target can use the 'Charge' ability even if it is not your charge phase and even if those units are in combat. Both friendly units must end that move in combat with the enemy target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="l40c1j6" name="Freeguild Cavaliers" entryId="337f-9f5b-ab79-bf66::6418-6101-3da2-6d47" number="1" type="model" from="entry"><selections><selection id="l57s9qb" name="Cavalier Weapon" entryId="337f-9f5b-ab79-bf66::a2c7-c597-9d7b-a89c" number="1" type="upgrade" from="entry"><profiles><profile id="f013-c69d-602d-7842" name="Cavalier Weapon" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="l5a28a5" name="Warhorse's Steel‑shod Hooves" entryId="337f-9f5b-ab79-bf66::dbd8-315c-759a-64a4" number="1" type="upgrade" from="entry"><profiles><profile id="2a5f-7d13-74da-90e0" name="Warhorse's Steel‑shod Hooves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35a