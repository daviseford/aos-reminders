istic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="140" /></costs><categories><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="1f17-ad98-ada0-ccf" name="STANDARD BEARER (1/10)" entryId="1f17-ad98-ada0-ccf" primary="false" /><category id="eeed-ef77-b0d-fa9d" name="MUSICIAN (1/10)" entryId="eeed-ef77-b0d-fa9d" primary="false" /><category id="72e3-7b1b-cb94-4cbd" name="DUARDIN" entryId="72e3-7b1b-cb94-4cbd" primary="false" /></categories></selection><selection id="6llzzdq" name="Longbeards" entryId="4c42-c592-2066-5020::8ee5-3161-46c0-d0a2" number="1" type="unit" from="entry"><profiles><profile id="de3d-cfcd-b7a6-ea6c" name="Longbeards" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">1</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="d7bb-dcf-51b7-4ca3" name="`I Thought Duardin Were Made of Sterner Stuff!`" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick another friendly **^^Cities of Sigmar Duardin^^** unit wholly within 12&quot; of this unit to be the target. You cannot pick a Longbeards unit.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, add 1 to wound rolls for the target's combat attacks for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="6q9pq1n" name="Longbeard" entryId="4c42-c592-2066-5020::e25b-829e-2ac3-694b" number="1" type="model" from="entry"><selections><selection id="6r0b0gl" name="Venerable Weapons" entryId="4c42-c592-2066-5020::9dd4-d3dd-2cf1-e950" number="1" type="upgrade" from="entry"><profiles><profile id="6c84-6e0a-66de-19bc" name="Venerable Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="6rvvi4" name="Champion" entryId="4c42-c592-2066-5020::dbe8-db8d-183d-eb0b::9c21-1746-9873-a5b5" entryGroupId="4c42-c592-2066-5020::3538-a4a-3117-52e7" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="6s19xb7" name="Longbeard" entryId="4c42-c592-2066-5020::e25b-829e-2ac3-694b" number="1" type="model" from="entry"><selections><selection id="6sdxoo" name="Venerable Weapons" entryId="4c42-c592-2066-5020::9dd4-d3dd-2cf1-e950" number="1" type="upgrade" from="entry"><profiles><profile id="6c84-6e0a-66de-19bc" name="Venerable Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="6s86b6" name="Musician" entryId="4c42-c592-2066-5020::983d-19f