alse" /><category id="3a1c-4c88-277c-ea0a" name="CHAMPION (1/10)" entryId="3a1c-4c88-277c-ea0a" primary="false" /><category id="4acc-87fa-ee52-4e51" name="Sigmarite Infantry" entryId="4acc-87fa-ee52-4e51" primary="false" /></categories></selection><selection id="2uc4ib" name="Freeguild Steelhelms" entryId="b48b-d013-c142-33f6::db97-62b-745a-8db7" number="1" type="unit" from="entry"><profiles><profile id="b1dc-d456-f02f-6e7b" name="Freeguild Steelhelms" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">1</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="39c2-986b-b2ea-3032" name="Steel of Helm and Heart" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit has 5 or more models, pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is **under orders**, apply the effect below. Otherwise, roll a dice. Subtract 1 from the roll if the target is a **^^Monster^^**. On a 4+, apply the effect below.
For the rest of the turn, if this unit is in combat with the target when the target is picked to use a **^^Fight^^** ability:
• This unit must be picked to be the target of pile-in move made by the target.
• All attacks made by models in the target unit within this unit's combat range must target this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="2xvmelb" name="Freeguild Steelhelms" entryId="b48b-d013-c142-33f6::6abb-eb8a-11ff-663e" number="1" type="model" from="entry"><selections><selection id="2yy2nt5" name="Freeguild Weapons" entryId="b48b-d013-c142-33f6::1538-bbfa-9677-af53" number="1" type="upgrade" from="entry"><profiles><profile id="c244-db8c-10e7-bb3c" name="Freeguild Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="2ypm03" name="Champion" entryId="b48b-d013-c142-33f6::b157-72e-34d0-b53a::9c21-1746-9873-a5b5" entryGroupId="b48b-d013-c142-33f6::575e-2f9e-d3de-dd05" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Eff