<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<roster id="99znyv8" name="cos-001-all-units" battleScribeVersion="2.03" generatedBy="https://newrecruit.eu" gameSystemId="e51d-b1a3-75fc-dc3g" gameSystemName="Age of Sigmar 4.0" gameSystemRevision="98" xmlns="http://www.battlescribe.net/schema/rosterSchema"><costs><cost name="pts" typeId="points" value="10120" /></costs><costLimits><costLimit name="pts" typeId="points" value="0" /></costLimits><forces><force id="9nje58p" name="✦ General's Handbook 2026-27" entryId="0151-9c5b-2f1e-32d4" catalogueId="42ad-8ca7-4b48-7df1" catalogueRevision="48" catalogueName="Cities of Sigmar"><selections><selection id="yr6slxs" name="Battle Traits: Cities of Sigmar" entryId="203e-fc08-7ead-5212::7cf4-ebee-6d30-c1e1" number="1" type="upgrade" from="entry"><profiles><profile id="ba11-eaf6-71e9-213" name="Form Up" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Start of Battle Round</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Cities of Sigmar ^^** unit to use this ability, then pick 2 other visible friendly **^^Cities of Sigmar^^** units wholly within 12&quot; of it to be the targets.
The unit using this ability and the targets:
• cannot be **under orders**.
• must each be a different unit type.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle round, the unit using this ability and the targets are **under orders**.
**Designer's Note:** *'Unit type' refers to the name of the warscroll (Core Rules, 4.0), e.g. 'Freeguild Cavalier-Marshal' or 'Cannonade Cogfort'.*</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Officar's Order^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="11c5-c994-64df-350a" name="Take Aim" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit that is **under orders** to use this ability.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of that unit's ranged weapons. Add 1 to hit rolls for shooting attacks made with that weapon for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="7b07-d086-b6a7-c4a0" name="Sound the Attack" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: You declared a **^^Charge^^** ability for a unit that is **under orders**</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can change the lowest D6 in the charge roll to match the highest D6.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b">The unit using that **^^Charge^^** ability.</characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="c8e5-fb20-1bc4-bb45" name="Into Them, You Dogs!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Hero^^** that is **under orders** to use this ability. That unit is the **field officer** for the rest of the turn. Then, pick 2 other visible friendly non-**^^Hero^^** units that are **under orders** and wholly within 12&quot; of the **field officer** to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, the first time the **field officer** uses a **^^Fight^^** ability, you can pick a target that has not used a **^^Fight^^** ability this turn. That target is **inspirited** and the other target is **emboldened**.The **inspirited** target can be picked to use a **^^Fight^^** ability immediately after the **^^Fight^^** ability used by the **field officer** has been resolved. Then, if the **emboldened** target has not used a **^^Fight^^** ability this turn, it can be picked to use a **^^Fight^^** ability immediately after the **inspirited** target's **^^Fight^^** ability has been resolved.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="61f3-1539-8aa3-9e05" name="Hurl Them Back!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">One Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit that is **under orders** and in combat with an enemy unit that charged this turn to use this ability.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, add 1 to the Rend characteristic of that unit's melee weapons.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><categories><category id="3360-1158-e879-9606" entryId="3360-1158-e879-9606" name="Reference" primary="true" /></categories></selection><selection id="cemq5xn" name="Battle Formation" entryId="4dec-79d0-71b-6be4" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="cowegx4i" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="crir4o5" name="Manifestation Lore" entryId="55af-7701-7199-a187" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="cvi883h" name="Prayer Lore" entryId="d407-b43e-b801-41ac" number="1" type="upgrade" from="entry"><selections><selection id="cw3ciwa" name="Scriptures of Sigmar" entryId="6c16-3e5c-d28c-8400::f457-7b47-42-c259" entryGroupId="6c16-3e5c-d28c-8400::b0fd-9397-ac0c-dc5f" number="1" type="upgrade" from="group" group="Prayer Lores"><selections><selection id="cyo51s" name="Benediction of the High Heavens" entryId="6c16-3e5c-d28c-8400::1249-b470-60be-2746::0c9f-d4c4-f482-5ca0" entryGroupId="6c16-3e5c-d28c-8400::1249-b470-60be-2746::e579-0774-829a-7b2b" number="1" type="upgrade" from="group" group="Scriptures of Sigmar"><profiles><profile id="23be-1f50-f64d-968d" name="Benediction of the High Heavens" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Cities of Sigmar Priest^^** to chant this prayer, pick a visible friendly **^^Cities of Sigmar^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">**Heal (D3)** the target and the chanter. If the chanting roll was 7+, **Heal (D3)** each visible friendly **^^Cities of Sigmar^^** unit wholly within 12&quot; of the chanter instead.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="cxvr6e" name="Holy Aegis" entryId="6c16-3e5c-d28c-8400::1249-b470-60be-2746::74e0-3dcd-121a-6eac" entryGroupId="6c16-3e5c-d28c-8400::1249-b470-60be-2746::e579-0774-829a-7b2b" number="1" type="upgrade" from="group" group="Scriptures of Sigmar"><profiles><profile id="e699-1a18-62bd-dafe" name="Holy Aegis" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Cities of Sigmar Priest^^** to chant this prayer, pick a visible friendly **^^Cities of Sigmar^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 7+, you can pick another eligible unit to be a second target. Until the start of your next turn, ignore the first damage point that would be allocated to each target in each phase.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="cyqpad" name="Reckoning of Sinners" entryId="6c16-3e5c-d28c-8400::1249-b470-60be-2746::b3d7-65f5-c04d-02af" entryGroupId="6c16-3e5c-d28c-8400::1249-b470-60be-2746::e579-0774-829a-7b2b" number="1" type="upgrade" from="group" group="Scriptures of Sigmar"><profiles><profile id="c46c-f2e-df0d-f8ec" name="Reckoning of Sinners" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Cities of Sigmar Priest^^** to chant this prayer, pick a visible friendly **^^Cities of Sigmar^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 10+, you can pick another eligible unit to be a second target. Until the start of your next turn, enemy units have a maximum control score of 1 while they are in combat with any of the targets.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Control</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="d01nh2" name="Spell Lore" entryId="28d3-5432-5e36-52c3" number="1" type="upgrade" from="entry"><selections><selection id="d0kpfzl" name="Spells of the Collegiate Arcane" entryId="7333-fdeb-8ed6-7383::92ff-92a1-c078-6d7a" entryGroupId="7333-fdeb-8ed6-7383::3f1c-3077-dd34-8efb" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="d1uttn8" name="Curse of Scorched Metal" entryId="7333-fdeb-8ed6-7383::571b-f424-afa1-fb6e::6784-787f-9d8c-5953" entryGroupId="7333-fdeb-8ed6-7383::571b-f424-afa1-fb6e::997a-a43e-945e-bd6d" number="1" type="upgrade" from="group" group="Spells of the Collegiate Arcane"><profiles><profile id="2e13-d3dd-9a26-e85" name="Curse of Scorched Metal" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Cities of Sigmar Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, the first time the target uses an **^^Attack^^** ability, for each unmodified hit roll of 1 for an attack made by the target as part of that **^^Attack^^** ability, inflict 1 mortal damage on the target after that **^^Attack^^** ability has been resolved.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031" /><attribute name="Type" typeId="da27-8d61-f955-5031" /></attributes></profile></profiles></selection><selection id="d1mmvde" name="High Star's Light" entryId="7333-fdeb-8ed6-7383::571b-f424-afa1-fb6e::ded1-658e-a888-2de9" entryGroupId="7333-fdeb-8ed6-7383::571b-f424-afa1-fb6e::997a-a43e-945e-bd6d" number="1" type="upgrade" from="group" group="Spells of the Collegiate Arcane"><profiles><profile id="f997-75c4-5486-233" name="High Star's Light" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Cities of Sigmar Wizard^^** to cast this spell, pick a visible friendly **^^Cities of Sigmar^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Add 1 to the Attacks characteristic of the target's melee weapons for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection><selection id="d1o7ixr" name="Speed of the Twin-tailed Comet" entryId="7333-fdeb-8ed6-7383::571b-f424-afa1-fb6e::9bad-1588-71ef-611a" entryGroupId="7333-fdeb-8ed6-7383::571b-f424-afa1-fb6e::997a-a43e-945e-bd6d" number="1" type="upgrade" from="group" group="Spells of the Collegiate Arcane"><profiles><profile id="1304-72b7-5ee2-2f3d" name="Speed of the Twin-tailed Comet" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Cities of Sigmar Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">For the rest of the turn, add 3&quot; to the Move characteristic of friendly non-**^^War Machine Cities of Sigmar^^** units while they are wholly within 12&quot; of the caster and visible to them.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="yxolat4" name="Dawner's Triumph" entryId="e6a4-d40d-98d8-6088::2be6-daba-0245-2e2a" number="1" type="unit" from="entry"><rules><rule id="687d-9178-3720-1424" name="Dawner's Triumph" hidden="false"><description>**The following universal terrain abilities apply to this terrain feature (Terrain, 1.2):
Cover, Impassable**</description></rule></rules><profiles><profile id="9233-1d25-f3ba-22b7" name="Hauled to War" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: You declared the 'Normal Move' ability for a **^^Cities of Sigmar Infantry^^** unit within 3&quot; of this terrain feature</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">After the 'Normal Move' ability has been resolved, pick a point on the battlefield within 1&quot; of the unit that used that ability and within 6&quot; of this terrain feature. Remove this terrain feature from the battlefield and set it up again within 1&quot; of that point and more than 3&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="344e-2884-969e-2fc7" name="Dawner's Triumph" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic></characteristics></profile><profile id="2eca-8671-d0bf-9d12" name="Fury of the Faithful" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 6&quot; of this terrain feature to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this terrain feature is in combat, apply the effect below. Otherwise, roll a dice. On a 3+, apply the effect below.
For the rest of the turn, melee weapons used by friendly **^^Cities of Sigmar Infantry^^** and **^^Cavalry^^** units have **Crit (Auto-wound)** for attacks that target that enemy unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="cdd6-ffa1-9b32-4cb8" entryId="cdd6-ffa1-9b32-4cb8" name="FACTION TERRAIN" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /></categories></selection></selections><costs><cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="1" /></costs><categories><category name="Configuration" id="7f6szy" primary="false" entryId="676-2b78-7bbf-ba9c" /><category name="Reference" id="7uv493" primary="false" entryId="3360-1158-e879-9606" /><category name="Army Composition" id="9zmfus" primary="false" entryId="ac97-b27c-7e35-7ab9" /><category name="FACTION TERRAIN" id="7uz1cbv" primary="false" entryId="cdd6-ffa1-9b32-4cb8" /><category name="Illegal Units" id="7hm5rt" primary="false" entryId="(Illegal Units)" /></categories><forces><force id="bjtulyr" name="Auxillary Units" entryId="6084-3baa-f00b-ac0a::8732-47c4-9f1c-e71e" catalogueId="42ad-8ca7-4b48-7df1" catalogueRevision="48" catalogueName="Cities of Sigmar"><selections><selection id="z2p0bog" name="Alchemite Warforger" entryId="86a3-572-f5f3-aa2c::2678-d067-8e12-84dc" number="1" type="unit" from="entry"><profiles><profile id="b077-5875-8209-85d" name="Alchemite Warforger" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="9494-ad55-d1f4-e146" name="Runic Crucible" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **^^Sigmarite^^** unit wholly within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make an arcane manipulation roll of D6. On a 3+, the target's melee weapons have **Crit (Mortal)** until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="z3c37qka" name="Alchemite Warforger" entryId="86a3-572-f5f3-aa2c::945e-3f94-9b00-d2c9" number="1" type="model" from="entry"><selections><selection id="zcr7fj" name="Tongstaff" entryId="86a3-572-f5f3-aa2c::d532-be55-e6b-87bd" number="1" type="upgrade" from="entry"><profiles><profile id="defa-187d-6218-66c5" name="Tongstaff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="130" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="znnxmhe" name="Alchemite Warforger (Scourge of Aqshy)" entryId="3585-9ece-99d9-081f::f009-0410-83f2-3c88" number="1" type="unit" from="entry"><profiles><profile id="6ee9-935d-6496-2369" name="Alchemite Warforger" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="6456-4a7a-d0e4-b3c8" name="Crucible of Rage" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can spend 1 **rage dice**. If you do:
• Apply the effect below.
• If your opponent's **fury level** is lower than yours, they must increase their fury level by 1, to a maximum of 7.
Otherwise, roll a dice. On a 3+, apply the effect below.
Until the start of your next turn, add 1 to casting rolls for friendly **^^Cities of Sigmar^^** units while they are wholly within 6&quot; of this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="zo97z44" name="Alchemite Warforger" entryId="3585-9ece-99d9-081f::e189-894c-2943-942c" number="1" type="model" from="entry"><selections><selection id="zt6vcon" name="Tongstaff" entryId="3585-9ece-99d9-081f::c222-f2af-5d15-16d6" number="1" type="upgrade" from="entry"><profiles><profile id="2cee-5841-910c-564a" name="Tongstaff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="07n07u4" name="Amethyst Knellmage" entryId="8607-6a0e-b4e2-f469::4e2b-f8f0-8fad-1d28" number="1" type="unit" from="entry"><profiles><profile id="0647-20fe-77b0-7712" name="Amethyst Knellmage" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="352b-b850-4fd5-eca5" name="Deathly Candlelight" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy unit within 12&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">The target cannot use commands for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute><attribute name="Type" typeId="da27-8d61-f955-5031">Special</attribute></attributes></profile><profile id="0cda-e71a-a2a1-dd6e" name="Ominous Presence" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make an arcane manipulation roll of D6. On a 3+, for the rest of the turn, when picking a target for the 'Deathly Candlelight' ability, you can pick a visible enemy unit within 18&quot; of this unit instead of within 12&quot;.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="07ophdp" name="Amethyst Knellmage" entryId="8607-6a0e-b4e2-f469::b230-7d07-65d2-7ee7" number="1" type="model" from="entry"><selections><selection id="0cerujs" name="Amethyst Scythe" entryId="8607-6a0e-b4e2-f469::85cf-a2c4-3691-d30c" number="1" type="upgrade" from="entry"><profiles><profile id="83df-8189-473d-f558" name="Amethyst Scythe" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="0tcby8" name="Aqshian Pyrocaster" entryId="857b-00a4-9c52-7c40::1f38-9f87-6b41-d900" number="1" type="unit" from="entry"><profiles><profile id="db5e-4c92-cc56-561c" name="Aqshian Pyrocaster" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="f726-3695-c3c0-458c" name="Incandescent Incineration" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy unit within 12&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">If the target was not **incandescent** when they were picked to be the target of this spell:
• Inflict D3 mortal damage on the target.
• The target is **incandescent** for the rest of the battle.
If the target was **incandescent** when they were picked to be the target of this spell:
• Allocate 3 damage points to the target (ward rolls cannot be made for those damage points).
• The target is no longer **incandescent**.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="18a1-61b5-2577-80dd" name="The Flames of Aqshy" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make an arcane manipulation roll of D6. On a 3+, for the rest of the turn, when picking a target for the 'Incandescent Incineration' ability, you can pick a visible enemy unit within 18&quot; of this unit instead of within 12&quot;.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="0vp26c" name="Aqshian Pyrocaster" entryId="857b-00a4-9c52-7c40::581e-6a49-d5b2-eb56" number="1" type="model" from="entry"><selections><selection id="11bu10c" name="Burning Fists" entryId="857b-00a4-9c52-7c40::b44e-0ca1-8624-5291" number="1" type="upgrade" from="entry"><profiles><profile id="14db-90a7-40db-77be" name="Burning Fists" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="1fdmaf6" name="Assassin" entryId="2287-704-d76c-8ec3::41db-4a11-69e4-4f72" number="1" type="unit" from="entry"><profiles><profile id="de97-3ff8-8ddc-f08b" name="Assassin" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="6fb9-29a3-16c5-2851" name="Hidden Murderer" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit is within the combat range of a friendly **^^Infantry^^** unit that has 5 or more models and there are no enemy units within this unit's combat range, this unit is not visible to enemy units.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="35d1-d1c0-3364-d5da" name="In for the Kill" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit has **^^Strike-first^^** if it charged in the same turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="1g5adz" name="Assassin" entryId="2287-704-d76c-8ec3::325-d738-fcf9-4b12" number="1" type="model" from="entry"><selections><selection id="1or8mgf" name="Poison-coated Blades" entryId="2287-704-d76c-8ec3::8700-f611-fc4b-758e" number="1" type="upgrade" from="entry"><profiles><profile id="e23b-766a-ba9a-de9d" name="Poison-coated Blades" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Hero^^** (+1 Rend), Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="150" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /></categories></selection><selection id="23fxdsc" name="Battlemage" entryId="702f-db1b-f8b2-c27::d1f3-97e9-f50a-d1a4" number="1" type="unit" from="entry"><profiles><profile id="d57a-690c-13ac-9237" name="Battlemage" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="6df7-9a6c-1b90-ddad" name="Protective Focus" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a **^^Spell^^** ability that this unit can use. For the rest of the battle, no mortal damage is inflicted on this unit if it miscasts that spell.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="240xmed" name="Battlemage" entryId="702f-db1b-f8b2-c27::3b37-7de8-c9c3-3bdc" number="1" type="model" from="entry"><selections><selection id="2h5mgrh" name="Wizard's Staff" entryId="702f-db1b-f8b2-c27::7d01-b72f-92d4-b98d" number="1" type="upgrade" from="entry"><profiles><profile id="a730-272d-f5ff-9d27" name="Wizard's Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="2w5ij6l" name="Battlemage on Celestial Hurricanum" entryId="2c9f-2e5e-92d4-4707::52f-1bc0-e898-f1a2" number="1" type="unit" from="entry"><profiles><profile id="cea6-1dfd-e885-5872" name="Battlemage on Celestial Hurricanum" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="590e-ea03-6f45-eb7f" name="Storm of Shemtek" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make a number of D3 rolls equal to the current battle round number. For each 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3e84-9072-f8af-e91d" name="Portents of Battle" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **^^Cities of Sigmar Human^^** unit wholly within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, add 1 to hit rolls for the target's combat attacks until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="2xn6qhb" name="Battlemage on Celestial Hurricanum" entryId="2c9f-2e5e-92d4-4707::eae9-cbad-559-a805" number="1" type="model" from="entry"><selections><selection id="34wbbc" name="Warhorse's Steel-shod Hooves" entryId="2c9f-2e5e-92d4-4707::7190-3513-7345-6fd8" number="1" type="upgrade" from="entry"><profiles><profile id="13f6-23d5-d7ed-533d" name="Warhorses' Steel-shod Hooves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="34m85ku" name="Wizard's Staff" entryId="2c9f-2e5e-92d4-4707::9ce3-b5b6-7bb5-7c7c" number="1" type="upgrade" from="entry"><profiles><profile id="6d96-21de-5536-7956" name="Wizard's Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="230" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="f7bc-b618-4b5d-2bae" name="WAR MACHINE" entryId="f7bc-b618-4b5d-2bae" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="3ewfa6" name="Battlemage on Griffon" entryId="c41b-b7fb-996e-45e9::d11e-a9e7-b74b-2643" number="1" type="unit" from="entry"><profiles><profile id="7b7b-70a6-ef89-c019" name="Battlemage on Griffon" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">15</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="6eb1-8714-3982-1690" name="Ghurish Ferocity" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 2+, add 1 to the Damage characteristic of this unit's **Griffon's Razor Claws and Twin Beaks** for attacks that target enemy **^^Monsters^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="e944-5a45-a99-3bce" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Griffon's Razor Claws and Twin Beaks** is 4.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="3f6dm4g" name="Battlemage on Griffon" entryId="c41b-b7fb-996e-45e9::87b1-3f3b-a1fb-8f8a" number="1" type="model" from="entry"><selections><selection id="3ptxhap" name="Amber Spear" entryId="c41b-b7fb-996e-45e9::d487-f7a0-4ebd-5898" number="1" type="upgrade" from="entry"><profiles><profile id="be00-a2bf-52fc-a414" name="Amber Spear" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Anti‑**^^Monster^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="3pusghp" name="Beaststaff" entryId="c41b-b7fb-996e-45e9::bc69-e094-46d2-6e53" number="1" type="upgrade" from="entry"><profiles><profile id="ef3f-3d22-e077-2bab" name="Beaststaff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="3p0jwn" name="Griffon's Razor Claws and Twin Beaks" entryId="c41b-b7fb-996e-45e9::73c6-56e9-2865-f8ba" number="1" type="upgrade" from="entry"><profiles><profile id="551f-dc4b-a1f0-7621" name="Griffon's Razor Claws and Twin Beaks" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="260" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="41klfch" name="Battlemage on Luminark of Hysh" entryId="41be-98b4-f3a1-2bae::b1b8-a094-36c3-b25e" number="1" type="unit" from="entry"><profiles><profile id="e5e6-8b30-45a1-de9d" name="Battlemage on Luminark of Hysh" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="3acd-4979-35ef-2dd9" name="Searing Beam of Light" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this unit attacks with its **Searing Beam of Light**, pick a point on the battlefield within range to be the target. If the attack scores a hit, draw a straight line between that point and the closest point on this unit's base. Inflict D3 mortal damage on each visible unit (friendly and enemy) that the line passes across.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="492a-3d01-ab36-6409" name="Aura of Protection" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **^^Cities of Sigmar^^** unit wholly within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, until the start of your next turn, the target has **^^Ward (6+)^^** while it is wholly within 12&quot; of and visible to this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="424ev6q" name="Battlemage on Luminark of Hysh" entryId="41be-98b4-f3a1-2bae::aab-211d-649c-70dd" number="1" type="model" from="entry"><selections><selection id="47ywrfj" name="Searing Beam of Light" entryId="41be-98b4-f3a1-2bae::bbcd-765-7a1d-8cc5" number="1" type="upgrade" from="entry"><profiles><profile id="2f5a-1339-d372-b790" name="Searing Beam of Light" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">24&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">1</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">⟝See 'Searing Beam of Light' ability⟞</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">⟝See 'Searing Beam of Light' ability⟞</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">⟝See 'Searing Beam of Light' ability⟞</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="475g34q" name="Warhorse's Steel-shod Hooves" entryId="41be-98b4-f3a1-2bae::98e2-1f15-7d18-6a13" number="1" type="upgrade" from="entry"><profiles><profile id="4059-f802-340b-2167" name="Warhorses' Steel-shod Hooves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="47s7io" name="Wizard's Staff" entryId="41be-98b4-f3a1-2bae::89a4-f98c-e01c-ae82" number="1" type="upgrade" from="entry"><profiles><profile id="1903-3d74-3e5c-2777" name="Wizard's Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="280" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="f7bc-b618-4b5d-2bae" name="WAR MACHINE" entryId="f7bc-b618-4b5d-2bae" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="4hb997" name="Black Ark Fleetmaster" entryId="5dc3-5123-c02f-8726::f2f1-e20a-f709-15a" number="1" type="unit" from="entry"><profiles><profile id="b01d-d3a2-e76c-7b85" name="Black Ark Fleetmaster" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="2fd4-93a5-1c52-261d" name="'At Them, You Curs!'" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Fight^^** ability for this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a friendly **Black Ark Corsairs** unit that has not used a **^^Fight^^** ability this turn and is within this unit's combat range to be the target. The target can be picked to use a **^^Fight^^** ability immediately after the **^^Fight^^** ability used by this unit has been resolved. If it is picked to do so, add 1 to the Attacks characteristic of the target's melee weapons for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="4i1p9j" name="Black Ark Fleetmaster" entryId="5dc3-5123-c02f-8726::4947-d506-187f-904e" number="1" type="model" from="entry"><selections><selection id="4t17pz" name="Wicked Cutlass and Murder Hook" entryId="5dc3-5123-c02f-8726::1208-45ac-6802-887d" number="1" type="upgrade" from="entry"><profiles><profile id="5f03-9a1b-b59d-d84f" name="Wicked Cutlass and Murder Hook" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="90" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /></categories></selection><selection id="55l3a9" name="Cannonade Cogfort" entryId="0d8d-7bb3-c366-acd2::2f5f-4d22-ec07-566c" number="1" type="unit" from="entry"><profiles><profile id="e3e5-de1a-48ba-6fe5" name="Cannonade Cogfort" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">25</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">10</characteristic></characteristics></profile><profile id="98a3-ec31-ff23-06ad" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points:
• The Attacks characteristic of its **Crushing Iron Feet** is 3.
• It has a Control characteristic of 5.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="88ee-cf5d-d383-f720" name="Full Power!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 or more of the following effects. For each effect you pick, give this unit a number of **heat tokens** equal to the number beside it.
**1 *Launch Countermeasures!*:** Until the start of your next turn, subtract 1 from hit rolls for shooting attacks that target other friendly **^^Sigmarite^^** units while they are wholly within 12&quot; of this unit and are **under orders**.
**2 *Full Throttle*:** For the rest of the turn, this unit's Move characteristic is 10&quot;.
**3 *Calculate Firing Solution!*:** For the rest of the turn, each time this unit uses a **^^Shoot^^** ability, you can re-roll 1 hit roll and 1 wound roll for shooting attacks made with this unit's **Godbreaker Cannon**.
**6 *Get Us Out of Here!*:** For the rest of the turn, this unit can use **^^Shoot^^** abilities even if it used a **^^Retreat^^** ability in the same turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="aad1-f68c-09fc-a9ae" name="Overheating" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Immediately after resolving this unit's 'Full Power!' ability, you must roll a number of dice equal to the number of **heat tokens** this unit has. For each 5+, allocate 1 damage point to this unit (ward rolls cannot be made for those damage points), then remove 1 of this unit's **heat tokens**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="40ea-2bd3-30ac-511e" name="Special Ammunition" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: You declared a **^^Shoot^^** ability for this unit.</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is **under orders**, roll a dice. On a 3+, pick 1 of the following effects.
***Nullshot*:** Subtract 1 from ward rolls for damage points inflicted by attacks made with this unit's **Godbreaker Cannon** this phase.
***Heavy Shot*:** Add 1 to the Rend characteristic of this unit's **Godbreaker Cannon** this phase.
***Grapeshot*:** After that **^^Shoot^^** ability has been resolve, if all of the attacks made with this unit's **Godbreaker Cannon** targeted the same enemy unit, inflict D3 mortal damage on each other enemy unit within that enemy unit's combat range.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="56kj1g8" name="Cannonade Cogfort" entryId="0d8d-7bb3-c366-acd2::7acb-000f-d70c-a444" number="1" type="model" from="entry"><selections><selection id="5a6c4rj" name="Breacher Cannon" entryId="0d8d-7bb3-c366-acd2::9b87-681a-0e27-e557" number="1" type="upgrade" from="entry"><profiles><profile id="ae2f-ad51-9389-dcc3" name="Breacher Cannon" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Anti-**^^Infantry^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="5a30a0n" name="Crew's Leadshotters" entryId="0d8d-7bb3-c366-acd2::29b2-45ac-8145-29b6" number="1" type="upgrade" from="entry"><profiles><profile id="bfd5-4843-632f-4204" name="Crew's Leadshotters" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot In Combat</characteristic></characteristics></profile></profiles></selection><selection id="5ayc14q" name="Crushing Iron Feet" entryId="0d8d-7bb3-c366-acd2::1a00-e1d9-e28e-dd5e" number="1" type="upgrade" from="entry"><profiles><profile id="f4de-b999-ee8c-d4b8" name="Crushing Iron Feet" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">4</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="59r6bm9" name="Godbreaker Cannon" entryId="0d8d-7bb3-c366-acd2::13b3-655e-c066-38fd" number="1" type="upgrade" from="entry"><profiles><profile id="5b43-92c5-e0b1-1649" name="Godbreaker Cannon" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">24&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">4</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">4</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="530" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /><category id="f7bc-b618-4b5d-2bae" name="WAR MACHINE" entryId="f7bc-b618-4b5d-2bae" primary="false" /></categories></selection><selection id="5kdie1a" name="Cogsmith" entryId="4ef2-9b6f-2205-6e1a::89d6-1612-ce3c-50e9" number="1" type="unit" from="entry"><profiles><profile id="341b-5727-9283-7a11" name="Cogsmith" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="eed6-7-7562-e58a" name="Direct the Gyrocorps" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 visible friendly **Gyrocopter** or **Gyrobomber** units wholly within 18&quot; of this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice for each target. On a 3+, until the start of your
next turn:
• Add 1 to hit rolls for the target's attacks.
• Add 2&quot; to the target's Move characteristic.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="5k03qqk" name="Cogsmith" entryId="4ef2-9b6f-2205-6e1a::3c15-3fa7-99c5-7aac" number="1" type="model" from="entry"><selections><selection id="5p43bt4" name="Cogsmith's Firearms" entryId="4ef2-9b6f-2205-6e1a::b509-e2b0-7411-10e0" number="1" type="upgrade" from="entry"><profiles><profile id="a252-ec51-acad-8196" name="Cogsmith's Firearms" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">15&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">4</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="5p2soqj" name="Gun Butt and Cog Axe" entryId="4ef2-9b6f-2205-6e1a::93c7-8827-10d2-d070" number="1" type="upgrade" from="entry"><profiles><profile id="d3ce-76ae-60a3-a19c" name="Gun Butt and Cog Axe" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="72e3-7b1b-cb94-4cbd" name="DUARDIN" entryId="72e3-7b1b-cb94-4cbd" primary="false" /></categories></selection><selection id="61xyakb" name="Conqueror Cogfort" entryId="452b-b02c-4096-b008::2325-8939-e7a3-5c84" number="1" type="unit" from="entry"><profiles><profile id="62af-9173-ae0a-346d" name="Conqueror Cogfort" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">25</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">10</characteristic></characteristics></profile><profile id="5678-54a5-4957-02ea" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points:
• The Attacks characteristic of its **Crushing Iron Feet** is 3.
• It has a Control characteristic of 5.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="4e71-1c15-438d-85b4" name="Full Charge!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 or more of the following effects. For each effect you pick, give this unit a number of **heat tokens** equal to the number beside it.
**1 *Breaching Assist!*:** If this unit uses the 'Sally Forth' ability this turn, melee weapons used by the targets of that ability have **Charge (+1 Damage)** for the rest of the turn.
**2 *Full Throttle*:** For the rest of the turn, this unit's Move characteristic is 10&quot;.
**3 *Repel Boarders!*:** For the rest of the turn, add 2 to the Attacks characteristic of this unit's **Leadshotters** and **Crushing Iron Feet**.
**4 *Disengage Safeties!*:** For the rest of the turn, the Attacks characteristic of this unit's **Realmscorcher Flame Cannon** is 22.
**6 *Get Us Out of Here!*:** For the rest of the turn, this unit can use **^^Shoot^^** abilities even if it used a **^^Retreat^^** ability in the same turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="9d85-fad5-328f-0e82" name="Overheating" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Immediately after resolving this unit's 'Full Power!' ability, you must roll a number of dice equal to the number of **heat tokens** this unit has. For each 5+, allocate 1 damage point to this unit (ward rolls cannot be made for those damage points), then remove 1 of this unit's **heat tokens**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="a24a-0a0a-4abf-6c6b" name="All Aboard!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 1 friendly **^^Sigmarite Infantry Hero^^** and up to 1 friendly non-**^^Hero Sigmarite Infantry^^** unit that have not been deployed.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up those units in reserve as this unit's **passengers**. They have now been deployed.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="7e00-4344-45b2-25cf" name="Sally Forth" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit has not used a **^^Run^^** ability this turn, pick this unit's **passengers** to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up each target wholly within 6&quot; of this unit and either not in combat or within 1/2&quot; of an enemy unit. If a target is set up in combat, it has charged. Then, if this unit is not **under orders**, this unit and the targets are **under orders** for the rest of the battle round.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="62dy53g" name="Conqueror Cogfort" entryId="452b-b02c-4096-b008::a4c6-e3aa-4c07-3b68" number="1" type="model" from="entry"><selections><selection id="66j8bql" name="Crew's Leadshotters" entryId="452b-b02c-4096-b008::3c5f-3dcd-573d-355a" number="1" type="upgrade" from="entry"><profiles><profile id="0fcb-cf6a-177e-b0c2" name="Crew's Leadshotters" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot In Combat</characteristic></characteristics></profile></profiles></selection><selection id="66fxrui" name="Crushing Iron Feet" entryId="452b-b02c-4096-b008::d95c-2b45-b73d-34bb" number="1" type="upgrade" from="entry"><profiles><profile id="8deb-64aa-347e-6f6d" name="Crushing Iron Feet" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">4</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="667gvth" name="Realmscorcher Flame Cannon" entryId="452b-b02c-4096-b008::92de-51b9-d18e-7eee" number="1" type="upgrade" from="entry"><profiles><profile id="e0d6-9be4-bf97-4ecc" name="Realmscorcher Flame Cannon" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6D6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Anti-**^^Infantry^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="440" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /><category id="f7bc-b618-4b5d-2bae" name="WAR MACHINE" entryId="f7bc-b618-4b5d-2bae" primary="false" /></categories></selection><selection id="bwgt8i" name="Dreadlord on Black Dragon" entryId="5640-d86-bbf-c887::3f66-4297-15aa-e6e" number="1" type="unit" from="entry"><profiles><profile id="9085-c324-7b7a-4afa" name="Dreadlord on Black Dragon" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="650b-d27b-8a3a-6a9" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Black Dragon's Claws** is 4.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="5ef-778e-b78-43b5" name="Indiscriminate Slaughter" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each other unit (friendly and enemy) within this unit's combat range to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3 for each target. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="b90a-83db-3f89-431d" name="Under the Shadow of Black Wings" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to charge rolls for friendly **^^Cities of Sigmar Aelf Cavalry^^** units while they are wholly within 12&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="bwcx2cb" name="Dreadlord on Black Dragon" entryId="5640-d86-bbf-c887::cc16-4158-c99f-f322" number="1" type="model" from="entry"><selections><selection id="c3fx239" name="Black Dragon's Claws" entryId="5640-d86-bbf-c887::cb3e-3874-ba2a-9c63" number="1" type="upgrade" from="entry"><profiles><profile id="ba66-ea31-adfd-5ffa" name="Black Dragon's Claws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">7</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="c3til5o" name="Black Dragon's Jaws" entryId="5640-d86-bbf-c887::3b6f-da93-6c8f-9a27" number="1" type="upgrade" from="entry"><profiles><profile id="df2d-4877-20e1-85ec" name="Black Dragon's Jaws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="c3od28d" name="Black Dragon's Noxious Breath" entryId="5640-d86-bbf-c887::4f29-443d-7fb0-aded" number="1" type="upgrade" from="entry"><profiles><profile id="6fa9-f2a7-cde1-8b63" name="Black Dragon's Noxious Breath" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2D6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat, Companion</characteristic></characteristics></profile></profiles></selection><selection id="c3vob7e" name="Dreadlord's Weapons" entryId="5640-d86-bbf-c887::f37d-7e47-e022-4244" number="1" type="upgrade" from="entry"><profiles><profile id="4c63-fff9-de0e-b38c" name="Dreadlord's Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="260" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /></categories></selection><selection id="cljhye2" name="Erasmus Zonn, the Enlightened One" entryId="64a4-e1a7-8b47-956b::6c28-ad39-4f2d-7a41" number="1" type="unit" from="entry"><profiles><profile id="ffd4-1ef1-493c-46e4" name="Erasmus Zonn, the Enlightened One" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">9</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="9d71-50e8-f139-29c7" name="Lantern of All-Knowledge" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is wholly within 9&quot; of a corner of the battlefield, pick 1 of the following effects to apply until the start of your next turn:
***Searing Brilliance*:** Friendly **^^Sigmarite^^** units are not visible to enemy units more than 6&quot; from them while those friendly units are wholly within 6&quot; of and visible to this unit.
***Lambent Aura*:** Add 1 to this unit's power level.
***Luminous Authority*:** Add 2 to arcane manipulation rolls for this unit.
***Prismatic Diffusion*:** Add 3 to the Attacks characteristic of this unit's **Rod of Radiance** and set its Damage characteristic to 3.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="c1b4-a293-388c-ac8e" name="Realmsphere Mastery" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy **^^Manifestation^^** within 12&quot; of this unit and that was not set up this turn to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make an arcane manipulation roll of 2D6. If the roll equals or exceeds the target's banishment value, set up an **^^Endless Spell^^** that can be summoned using a **^^Summon^^** spell that this unit can cast within 1&quot; of the target and more than 3&quot; from all enemy units and other enemy **^^Manifestations^^**. If that **^^Endless Spell^^** has multiple parts, both parts must be set up within 1&quot; of the target. This unit has summoned that **^^Endless Spell^^**. If there is already a friendly **^^Endless Spell^^** of the same type on the battlefield, it is immediately banished and removed from play before being set up as described above. Then, the target is banished and removed from play.'</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="a5c0-28d2-cb52-6395" name="The Four Corners of the Realms" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Remove this unit from the battlefield and set it up again wholly within 9&quot; of a corner of the battlefield and more than 3&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute><attribute name="Type" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="cm7wb3" name="Erasmus Zonn, the Enlightened One" entryId="64a4-e1a7-8b47-956b::ae20-f074-6840-6ab2" number="1" type="model" from="entry"><selections><selection id="cvktidq" name="Glyphwing's Heads" entryId="64a4-e1a7-8b47-956b::d5ff-85d4-cebf-61b1" number="1" type="upgrade" from="entry"><profiles><profile id="6d58-2172-612b-e672" name="Glyphwing's Heads" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3+1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="cvrrggh" name="Rod of Radiance" entryId="64a4-e1a7-8b47-956b::c41f-92ec-81ba-666e" number="1" type="upgrade" from="entry"><profiles><profile id="71b4-128d-e833-5861" name="Rod of Radiance" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (2 Hits)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="170" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="926c-df8c-6841-d49e" name="CAVALRY" entryId="926c-df8c-6841-d49e" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /></categories></selection><selection id="d7zi6y9" name="Freeguild Cavalier-Marshal" entryId="5189-df8c-c265-88e0::f921-535b-9f7d-615f" number="1" type="unit" from="entry"><profiles><profile id="8ad5-2121-1ad0-5e10" name="Freeguild Cavalier-Marshal" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="9d2f-f3d6-2668-108c" name="'For Sigmar, For Glory!'" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared the 'Counter-charge' command for this unit.</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a visible friendly non-**^^Hero Sigmarite Cavalry^^** unit that is wholly within 12&quot; of this unit, is not in combat and has not used a **^^Run^^** ability this turn to be the target. After the 'Counter-charge' command for this unit has been resolved, if this unit is in combat, the target can immediately use the 'Charge' ability as if it were your charge phase. In addition, you can re-roll charge rolls for the target for the rest of the phase.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="b1f7-272d-c217-cb7c" name="Run Down the Foe" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this turn, pick this unit and up to 2 non-**^^Hero Sigmarite Cavalry^^** units that charged this turn and are wholly within 12&quot; of this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For each target:
• Make a pile-in move.
• Then, pick an enemy unit in combat with the target and roll a D3. On a 2+, inflict an amount of mortal damage on that enemy unit equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="d8c3iz" name="Freeguild Cavalier-Marshal" entryId="5189-df8c-c265-88e0::77f0-ab4d-56ac-8c2b" number="1" type="model" from="entry"><selections><selection id="dhure4" name="Dragoon Pistol" entryId="5189-df8c-c265-88e0::bd97-f910-35f0-c5a5" number="1" type="upgrade" from="entry"><profiles><profile id="b4f1-a475-5b12-cc95" name="Dragoon Pistol" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">4</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="dhi0wzm" name="Master-forged Cavalier Sword" entryId="5189-df8c-c265-88e0::6555-c22-45f8-e4bf" number="1" type="upgrade" from="entry"><profiles><profile id="461b-85f8-4c7f-d3e2" name="Master-forged Cavalier Sword" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="dh88wnm" name="Warhorse's Steel-shod Hooves" entryId="5189-df8c-c265-88e0::af9-b774-ab74-dc95" number="1" type="upgrade" from="entry"><profiles><profile id="7f4f-b6f-b2bf-4cb7" name="Warhorse's Steel-shod Hooves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="926c-df8c-6841-d49e" name="CAVALRY" entryId="926c-df8c-6841-d49e" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="dvwlm0g" name="Freeguild Marshal and Relic Envoy" entryId="68be-a563-c70e-652d::326c-d13-626c-cfd" number="1" type="unit" from="entry"><profiles><profile id="49b9-ad15-e5ba-ad18" name="Freeguild Marshal and Relic Envoy" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="3bce-aa90-96d2-acc9" name="Front-line Commander" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" from="entry"><characteristics><characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Once Per Battle (Army), Reaction: You declared a **^^Fight^^** ability for this unit</characteristic><characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic><characteristic name="Declare" typeId="b77f-7548-840e-c086"></characteristic><characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">If this unit is **under orders**, pick a friendly **^^Sigmarite Infantry^^** or **^^Monster^^** unit that is wholly within 12&quot; of this unit or has this unit's **Relic Envoy** next to it and that has not used a **^^Fight^^** ability this turn to be the target. The target can be picked to use a **^^Fight^^** ability immediately after the **^^Fight^^** ability used by this unit has been resolved. If it is picked to do so, the target can use 2 **^^Fight^^** abilities this phase. After the first is used, however, the target has **^^Strike-last^^** for the rest of the turn</characteristic><characteristic name="Keywords" typeId="445d-f443-5448-e7ce"></characteristic></characteristics><attributes><attribute name="Color" typeId="5c69-e4b9-19bc-e801">Red</attribute><attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Offensive</attribute><attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8" /></attributes></profile><profile id="2112-548a-2352-e516" name="Attendant Relic Envoy" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit's **Relic Envoy** is a token. Pick a visible friendly **^^Sigmarite^^** unit wholly within 18&quot; of this unit and not **under orders** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Place this unit's **Relic Envoy** next to the target. While this unit is **under orders** and on the battlefield and this unit's **Relic Envoy** is next to the target, the target is **under orders**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="dwne8x" name="Freeguild Marshal and Relic Envoy" entryId="68be-a563-c70e-652d::d46a-b2a4-2fe4-5b54" number="1" type="model" from="entry"><selections><selection id="e01r4qr" name="Duelling Pistols" entryId="68be-a563-c70e-652d::d8cf-466c-28ea-a3ac" number="1" type="upgrade" from="entry"><profiles><profile id="6ea8-577e-2811-6333" name="Duelling Pistols" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">4</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="e0expxl" name="Master-forged Weapon" entryId="68be-a563-c70e-652d::6e3b-c3de-a800-c980" number="1" type="upgrade" from="entry"><profiles><profile id="45f-8b9e-6e6e-cd82" name="Master-forged Weapon" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="eex1kvj" name="Freeguild Marshal on Griffon" entryId="831a-f506-71e0-607f::c0d6-b8a8-c799-e09e" number="1" type="unit" from="entry"><profiles><profile id="7b1d-6d4c-f102-f89c" name="Freeguild Marshal on Griffon" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">15</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="644e-a351-447b-1552" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Griffon's Razor Claws and Deadly Beak ** is 4.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="2402-bae6-698b-bd1" name="Tactical Acumen" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared the 'Redeploy' command for a friendly **^^Cities of Sigmar Human^^** unit wholly within 12&quot; of this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If you roll a 1-3 when determining the distance that unit can move, you can use a value of 4 instead.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="fa49-a1dc-a44e-95c4" name="Piercing Bloodroar" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 enemy units in combat with this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice for each target. On a 4+, the target cannot use commands for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="efovdrf" name="Freeguild Marshal on Griffon" entryId="831a-f506-71e0-607f::4deb-7f42-e841-bbe7" number="1" type="model" from="entry"><selections><selection id="ejpy5ip" name="Griffon's Razor Claws and Deadly Beak" entryId="831a-f506-71e0-607f::2a22-e3a9-c027-cd75" number="1" type="upgrade" from="entry"><profiles><profile id="82b9-6fe1-6a08-c0da" name="Griffon's Razor Claws and Deadly Beak" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="ejtw6ij" name="Marshal's Armaments" entryId="831a-f506-71e0-607f::624a-4964-b0b-9fb5" number="1" type="upgrade" from="entry"><profiles><profile id="e807-138c-30e5-68bb" name="Marshal's Armaments" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="230" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="ev7lvvn" name="Fusil-Major on Ogor Warhulk" entryId="db4f-981-b206-2fc5::7934-6325-c7ed-3d7b" number="1" type="unit" from="entry"><profiles><profile id="daef-4f61-4b15-4817" name="Fusil-Major on Ogor Warhulk" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="cd9f-99d3-f8e8-d966" name="Coordinate Attacks" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 24&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, add 1 to hit rolls for attacks made by friendly **^^Sigmarite^^** units that are **under orders** that target that enemy unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="ewvt1t" name="Fusil-Major on Ogor Warhulk" entryId="db4f-981-b206-2fc5::252d-709b-80f1-b38" number="1" type="model" from="entry"><selections><selection id="f21uhxa" name="Long Fusil" entryId="db4f-981-b206-2fc5::323a-f310-8d08-7f30" number="1" type="upgrade" from="entry"><profiles><profile id="b4ce-38c9-1d68-5442" name="Long Fusil" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">24&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (Auto-wound), Anti-**^^Hero^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="f2bpv58" name="Warhulk's Mace" entryId="db4f-981-b206-2fc5::faaa-2147-1ef2-a0ee" number="1" type="upgrade" from="entry"><profiles><profile id="ff48-fe2a-41ab-6373" name="Warhulk's Mace" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="160" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="fhx32xc" name="Jorvan Kreel, Heir of the Kraken" entryId="f75f-88b2-8c43-4dff::0e01-555a-3ad5-d96b" number="1" type="unit" from="entry"><profiles><profile id="24f0-6ac4-377f-f0c0" name="Jorvan Kreel, Heir of the Kraken" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="0758-9662-bc46-755e" name="Harrying Attacks" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit's **Thexa** is next to an enemy unit, that enemy unit's attacks cannot score critical hits (treat them as regular hits instead).</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ebde-a75b-562f-c7fb" name="Prowling Ash Panther" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit's **Thexa** is a token. If this unit's **Thexa** is not on the battlefield, pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Place this unit's **Thexa** next to the target, then roll a D3. On a 2+, inflict an amount of mortal damage on the target equal to the roll. If the target is destroyed while this unit's **Thexa** is next to it, remove this unit's **Thexa** from the battlefield.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="109d-d64b-fe8b-49e0" name="Fluid Combat Style" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Fight^^** ability for this unit or a non-**^^Hero Sigmarite Infantry^^** unit wholly within 12&quot; of this unit.</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Immediately after the **^^Fight^^** ability used by that unit has been resolved, pick a point on the battlefield within 6&quot; of this unit and more than 3&quot; from all units (friendly and enemy) and terrain features. Remove the unit that used the **^^Fight^^** ability from the battlefield and set it up again wholly within 6&quot; of that point and not in combat.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="fivzlb" name="Jorvan Kreel, Heir of the Kraken" entryId="f75f-88b2-8c43-4dff::92b2-80cc-c0eb-905e" number="1" type="model" from="entry"><selections><selection id="fmuydac" name="Ranger Blades" entryId="f75f-88b2-8c43-4dff::cde2-8f51-5df3-dcd0" number="1" type="upgrade" from="entry"><profiles><profile id="2ce5-0394-1b91-f6d3" name="Ranger Blades" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="fzasjq" name="Mallus Forgepriest" entryId="bf37-d115-6919-a0c7::c11a-fad2-bb2a-d00c" number="1" type="unit" from="entry"><profiles><profile id="4449-6f86-aa10-15b3" name="Mallus Forgepriest" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="8557-65b2-78d9-cb1b" name="Consecrate the Land" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an objective you control that this unit is contesting to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If there are no enemy units contesting the target objective, it is considered by you to be **consecrated**. Otherwise, roll a dice. On a 3+, the target objective is considered by you to be **consecrated**.
While they are wholly within 6&quot; of a **consecrated** objective and **under orders**:
• Friendly non-**^^War Machine Sigmarite^^** units have **^^Ward (5+)^^**.
• Friendly **^^Sigmarite War Machines^^** have **^^Ward (6+)^^**.
If your opponent gains control of a **consecrated** objective, it is no longer consecrated.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="fzxo7w" name="Mallus Forgepriest" entryId="bf37-d115-6919-a0c7::f80a-2c8c-566b-8666" number="1" type="model" from="entry"><selections><selection id="g7q2r8o" name="Meteoric Warhammer" entryId="bf37-d115-6919-a0c7::f9ed-5079-652d-0e32" number="1" type="upgrade" from="entry"><profiles><profile id="066c-7894-81d2-eaf4" name="Meteoric Warhammer" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="130" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /><category id="3fe-84f4-cec6-a1c1" name="PRIEST (1)" entryId="3fe-84f4-cec6-a1c1" primary="false" /></categories></selection><selection id="gklsfb9" name="Pontifex Zenestra, Matriarch of the Great Wheel" entryId="11e8-f723-5c4e-80b7::708d-414f-a3f-3734" number="1" type="unit" from="entry"><profiles><profile id="8dda-ce60-22c-efc6" name="Pontifex Zenestra, Matriarch of the Great Wheel" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">9</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="c3e7-338c-f601-da40" name="The Great Wheel Turns" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a model in a visible friendly **^^Sigmarite^^** unit wholly within 12&quot; of this unit is slain by a combat attack and that model was in combat with the attacking unit, make a number of zealotry rolls of D6 equal to that model's Health characteristic. For each 6+, inflict 1 mortal damage on the attacking units after the **^^Fight^^** ability has been resolved.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ff25-d46d-a55f-3561" name="Vessel of Sigmar" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Make a chanting roll of D6. If the roll is an unmodified 1, you can re-roll the dice.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Pick 1 of the following effects. Pick up to 2 different effects instead if the chanting roll was 10+.
***Sanctified Ground:*** Until the start of your next turn, visible enemy units that use a **^^Charge^^** ability while they are within 9&quot; of this unit have **^^Strike-last^^** for the rest of the turn.
***Ardent Prayers:*** Add 1 to zealotry rolls for friendly **^^Sigmarite^^** units until the start of your next turn.
***Cast Out Evil:*** Roll a D3 for each visible enemy **^^Wizard^^** and **^^Priest^^** on the battlefield. On a 2+, inflict an amount of mortal damage on that unit equal to the roll.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="gl6b6mn" name="Pontifex Zenestra, Matriarch of the Great Wheel" entryId="11e8-f723-5c4e-80b7::79fe-87b6-7e55-bf26" number="1" type="model" from="entry"><selections><selection id="gm8j9bc" name="Acolytes' Club and Axe" entryId="11e8-f723-5c4e-80b7::5729-cc72-aa7d-4a41" number="1" type="upgrade" from="entry"><profiles><profile id="446c-66be-476b-fd1a" name="Acolytes' Club and Axe" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="gmz7ehk" name="Sceptre of the Wheel" entryId="11e8-f723-5c4e-80b7::e3e9-3c93-de52-a783" number="1" type="upgrade" from="entry"><profiles><profile id="3eba-2cef-2541-f6ff" name="Sceptre of the Wheel" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="190" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="e692-853d-6db8-fdbe" name="PRIEST (2)" entryId="e692-853d-6db8-fdbe" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="f99f-98ee-909f-57cd" name="WARD (4+)" entryId="f99f-98ee-909f-57cd" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="h06kpmm" name="Pontifex Zenestra, Matriarch of the Great Wheel (Scourge of Aqshy)" entryId="d158-7487-5ccf-fba5::9d7f-206f-a764-e503" number="1" type="unit" from="entry"><profiles><profile id="aa66-e673-d70e-d62d" name="Pontifex Zenestra, Matriarch of the Great Wheel" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">9</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="716c-d583-050d-5534" name="Sigmar's Blessing" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a visible friendly **^^Sigmarite^^** unit wholly within 12&quot; of this unit to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn:
• The target's melee weapons have **Charge (+1 Damage)**.
• If the chanting roll was 10+, the target has **^^Ward (5+)^^** if it charged in the same turn.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="b319-9e7a-b5c1-48a6" name="Unquenchable Faith" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this unit would be destroyed, before removing it from play, this unit can immediately use the 'Sigmar's Blessing' ability as if it were your hero phase. If it does so:
• That prayer does not count towards the number of **^^Prayer^^** abilities this unit can use this phase.
• Instead of making a chanting roll for that prayer, you must use a value of 10 for the roll that cannot be modified.
• The effect of that prayer applies for the rest of the battle instead of until the start of your next turn.</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="h17go6" name="Pontifex Zenestra, Matriarch of the Great Wheel" entryId="d158-7487-5ccf-fba5::7e0a-d5bd-082f-f135" number="1" type="model" from="entry"><selections><selection id="h21bci" name="Acolytes' Club and Axe" entryId="d158-7487-5ccf-fba5::3bd4-9ec2-6d0f-7b87" number="1" type="upgrade" from="entry"><profiles><profile id="404d-7832-04a3-06cf" name="Acolytes' Club and Axe" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="h21d8lm" name="Sceptre of the Wheel" entryId="d158-7487-5ccf-fba5::7241-2b10-6798-7daf" number="1" type="upgrade" from="entry"><profiles><profile id="626e-815a-381e-5310" name="Sceptre of the Wheel" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="160" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="e692-853d-6db8-fdbe" name="PRIEST (2)" entryId="e692-853d-6db8-fdbe" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="f99f-98ee-909f-57cd" name="WARD (4+)" entryId="f99f-98ee-909f-57cd" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="hd8obg4" name="Runelord" entryId="d448-6492-8fc1-ed92::e21a-cca6-9f40-1891" number="1" type="unit" from="entry"><profiles><profile id="8516-eeba-5f65-42f8" name="Runelord" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="2b08-4cd-6cbe-7479" name="Runes of Spellbreaking" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit can use the 'Unbind' ability as if it had **^^Wizard (1)^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="f804-1d1d-1d46-ace3" name="Forgefire" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Cities of Sigmar Duardin^^** unit wholly within 12&quot; of this unit to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 10+, you can pick another eligible unit to be a second target. Until the start of your next turn, add 1 to the Rend characteristic of each target's melee weapons.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="hec3dt" name="Runelord" entryId="d448-6492-8fc1-ed92::a335-2d5a-9a5b-a512" number="1" type="model" from="entry"><selections><selection id="hi59cv" name="Rune Staff and Forgehammer" entryId="d448-6492-8fc1-ed92::9fa-4f55-f5d8-4579" number="1" type="upgrade" from="entry"><profiles><profile id="284d-6ae0-b525-230f" name="Rune Staff and Forgehammer" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="130" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="72e3-7b1b-cb94-4cbd" name="DUARDIN" entryId="72e3-7b1b-cb94-4cbd" primary="false" /><category id="3fe-84f4-cec6-a1c1" name="PRIEST (1)" entryId="3fe-84f4-cec6-a1c1" primary="false" /></categories></selection><selection id="hzjpg9" name="Sorceress" entryId="da9-fda-c22f-c1d1::6537-603a-884b-312b" number="1" type="unit" from="entry"><profiles><profile id="308d-de22-ded3-f99" name="Sorceress" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="ee9f-911b-b02f-dcbb" name="Cruel Sacrifice" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible  friendly **^^Cities of Sigmar Aelf^^** unit wholly within 6&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to casting rolls for this unit for the rest of the turn. Then, roll a dice. On a 4+, 1 model in the target unit is slain.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="d5c4-3344-ed34-3a3f" name="Word of Pain" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, subtract 1 from hit rolls and wound rolls for the target's attacks until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="i0695nb" name="Sorceress" entryId="da9-fda-c22f-c1d1::31d6-ec6f-359e-73f8" number="1" type="model" from="entry"><selections><selection id="i4lesro" name="Witchstaff" entryId="da9-fda-c22f-c1d1::3216-bd89-9398-b002" number="1" type="upgrade" from="entry"><profiles><profile id="4d98-f299-6903-1577" name="Witchstaff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">1</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="130" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /></categories></selection><selection id="ii8zt3o" name="Sorceress on Black Dragon" entryId="77b6-bdc2-b509-77::97d9-f0bf-ad89-37eb" number="1" type="unit" from="entry"><profiles><profile id="8182-4b79-35a2-9b5f" name="Sorceress on Black Dragon" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="a54a-5d5e-a32e-7921" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Black Dragon's Claws** is 4.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="34e3-2b10-ba1f-34d2" name="Command Underlings" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 friendly **^^Cities of Sigmar Aelf Infantry^^** units wholly within 12&quot; of this unit to be targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 3&quot; to the Move characteristic of each target for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="dfe-3402-3fce-d63f" name="Feed on Life Force" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. On a 2+, inflict an amount of mortal damage on the target equal to the roll. If any enemy models are slain by this ability, place a **dark sorcery token** next to this unit for the rest of the battle, to a maximum of 3 tokens.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="7883-3890-cdaa-e2df" name="Dark Sorcery" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to casting rolls for this unit for each **dark sorcery token** it has.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="iic8lhg" name="Sorceress on Black Dragon" entryId="77b6-bdc2-b509-77::afd7-ae10-786e-b18d" number="1" type="model" from="entry"><selections><selection id="inyd85r" name="Black Dragon's Claws" entryId="77b6-bdc2-b509-77::8bc6-1fec-50a4-d1b0" number="1" type="upgrade" from="entry"><profiles><profile id="fa16-f115-248-dc4" name="Black Dragon's Claws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">7</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="inbtxd" name="Black Dragon's Jaws" entryId="77b6-bdc2-b509-77::ba5c-3c40-df2b-ee39" number="1" type="upgrade" from="entry"><profiles><profile id="3827-f802-3f24-588b" name="Black Dragon's Jaws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="inqisdb" name="Black Dragon's Noxious Breath" entryId="77b6-bdc2-b509-77::4d1e-a0f2-f8bb-6ee7" number="1" type="upgrade" from="entry"><profiles><profile id="9ec1-5efc-b308-a07d" name="Black Dragon's Noxious Breath" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2D6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat, Companion</characteristic></characteristics></profile></profiles></selection><selection id="inm2aq" name="Cruel Weapons" entryId="77b6-bdc2-b509-77::b24f-bbd1-b458-8ec2" number="1" type="upgrade" from="entry"><profiles><profile id="b6a0-c7ef-e950-2a13" name="Cruel Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="280" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /></categories></selection><selection id="j2eksnf" name="Steam Tank Commander" entryId="b92e-ce68-720b-d9ec::6bc7-2301-7561-6983" number="1" type="unit" from="entry"><profiles><profile id="eccc-9673-5e87-8ecf" name="Steam Tank Commander" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">2+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="149d-21e8-ee37-ede" name="Division Commander" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 2 friendly **Steam Tank** units to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, add 1 to hit rolls for shooting attacks made by this unit and by each target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="321e-760e-c267-6548" name="More Pressure!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll 2D6. If the roll is less than the number of damage points this unit has, inflict D3 mortal damage on this unit. Otherwise, pick 1 of the following effects to apply to this unit until the start of your next turn:
***Power the Wheels:*** This unit can use a **^^Run^^** ability and still use **^^Shoot^^** and/or **^^Charge^^** abilities later in the turn.
***Power the Guns:*** Add 3 to the Attacks characteristic of this unit's **Steam Gun**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="j2sko0f" name="Steam Tank Commander" entryId="b92e-ce68-720b-d9ec::3403-7678-f8e8-a00f" number="1" type="model" from="entry"><selections><selection id="j7ro0tm" name="Commander's Rifle" entryId="b92e-ce68-720b-d9ec::b1b8-be86-3ed9-fbb9" number="1" type="upgrade" from="entry"><profiles><profile id="151e-f789-ac81-cded" name="Commander's Rifle" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="j7nbqir" name="Commander's Sword" entryId="b92e-ce68-720b-d9ec::e6e6-455f-79b4-bfb9" number="1" type="upgrade" from="entry"><profiles><profile id="87d5-58f6-2370-c6ab" name="Commander's Sword" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="j7e70ob" name="Crushing Wheels" entryId="b92e-ce68-720b-d9ec::878f-cd3c-8fe6-aa27" number="1" type="upgrade" from="entry"><profiles><profile id="bd49-16fb-8555-430" name="Crushing Wheels" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="j7bkryc" name="Steam Cannon" entryId="b92e-ce68-720b-d9ec::3f5-6797-6c8f-90b1" number="1" type="upgrade" from="entry"><profiles><profile id="b37b-382f-bde7-dbff" name="Steam Cannon" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">1</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3+2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="j8ggszf" name="Steam Gun" entryId="b92e-ce68-720b-d9ec::58b9-f00-6dd0-6555" number="1" type="upgrade" from="entry"><profiles><profile id="5cfe-a7c4-12af-c7b3" name="Steam Gun" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2D6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">-</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="250" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="f7bc-b618-4b5d-2bae" name="WAR MACHINE" entryId="f7bc-b618-4b5d-2bae" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /></categories></selection><selection id="ju9pns" name="Tahlia Vedra, Lioness of the Parch" entryId="a676-2bc6-ff1a-959c::16c9-ff28-9e7d-8702" number="1" type="unit" from="entry"><profiles><profile id="3aa9-7278-2abc-84f6" name="Tahlia Vedra, Lioness of the Parch" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">15</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="19b1-3b68-557a-23f0" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of **Infernadine's Leonine Jaws** is 2.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="b2eb-5ea1-28d9-2b4e" name="Combat Tactician" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Enemy Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit is not in combat, pick a visible friendly **^^Sigmarite Infantry^^** unit wholly within 18&quot; of it and that is not in combat to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The target can immediately use the 'Normal Move' ability as if it were your movement phase. In addition, the target is **under orders** for the rest of the battle round.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="537e-11a5-8592-b785" name="Lead from the Front" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit is in combat, pick each visible friendly **^^Sigmarite^^** unit wholly within 12&quot; of this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to hit rolls and wound rolls for the targets' combat attacks for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="d0cd-c950-586e-dd44" name="Paralysing Venom" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. If the roll is equal to or less than the target's Health characteristic, subtract 1 from wound rolls for the target's attacks for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="jvxqkia" name="Tahlia Vedra, Lioness of the Parch" entryId="a676-2bc6-ff1a-959c::8044-b4b7-5aa1-7b16" number="1" type="model" from="entry"><selections><selection id="jyuvfg8" name="Infernadine's Leonine Jaws" entryId="a676-2bc6-ff1a-959c::d928-e2b2-a41b-a74e" number="1" type="upgrade" from="entry"><profiles><profile id="9880-a6ec-3dc3-365f" name="Infernadine's Leonine Jaws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Monster^^** (+1 Rend), Companion</characteristic></characteristics></profile></profiles></selection><selection id="jx9g4q" name="Infernadine's Scorpid Stinger" entryId="a676-2bc6-ff1a-959c::e9ad-f5bb-41b8-4b01" number="1" type="upgrade" from="entry"><profiles><profile id="5efa-f6a9-5f6d-4ae4" name="Infernadine's Scorpid Stinger" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3+3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal), Companion</characteristic></characteristics></profile></profiles></selection><selection id="jxrzozu" name="Weapon of Office" entryId="a676-2bc6-ff1a-959c::989b-abf3-4267-6b1" number="1" type="upgrade" from="entry"><profiles><profile id="58aa-aa7e-b04a-b57b" name="Weapon of Office" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="340" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="ae9e-dd18-4bdb-ffe9" name="SIGMARITE" entryId="ae9e-dd18-4bdb-ffe9" primary="false" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="c203-51a0-3d44-6b07" name="WARMASTER" entryId="c203-51a0-3d44-6b07" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /></categories></selection><selection id="skacfp" name="Warden King" entryId="e4b8-863b-6d0b-c9d7::962e-f3fb-717c-d408" number="1" type="unit" from="entry"><profiles><profile id="37e4-4f75-bfd3-e28" name="Warden King" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="d11f-d74d-dcf7-d97e" name="Fearless Leader" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Fight^^** ability for this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a friendly non-**^^Hero Cities of Sigmar Duardin^^** unit that has not used a **^^Fight^^** ability this turn and is within this unit's combat range to be the target. The target can be picked to use a **^^Fight^^** ability immediately after the **^^Fight^^** ability used by this unit has been resolved.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="e357-61bc-2b75-d574" name="Ancestral Grudgebearer" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in your opponent's army to bear a grudge against. You can pick an enemy unit that is in reserve.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle, add 1 to wound rolls for combat attacks made by friendly **^^Cities of Sigmar Duardin^^** units that target that unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="slpgqa" name="Warden King" entryId="e4b8-863b-6d0b-c9d7::5b89-b257-b7f9-ab" number="1" type="model" from="entry"><selections><selection id="sq17" name="Runic Hammer" entryId="e4b8-863b-6d0b-c9d7::1e81-7d2d-d85e-4cad" number="1" type="upgrade" from="entry"><profiles><profile id="3232-f16d-c4c7-c33f" name="Runic Hammer" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="4999-8ae2-e1bb-ba5" name="CITIES OF SIGMAR" entryId="4999-8ae2-e1bb-ba5" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="72e3-7b1b-cb94-4cbd" name="DUARDIN" entryId="72e3-7b1b-cb94-4cbd" primary="false" /></categories></selection>