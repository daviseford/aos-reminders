sive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any musicians, if it uses the 'Rally' command, you can make one additional rally roll of D6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection><selection id="d7nnfed" name="Fellrider Blades" entryId="3a4-6557-ea1d-e314::1836-e07c-a3af-bba7" entryGroupId="3a4-6557-ea1d-e314::6577-1f6f-a120-27d" number="1" type="upgrade" from="group" group="Wargear Options"><profiles><profile id="866a-80e-be50-c426" name="Fellrider Blades" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection></selections></selection><selection id="d99sgz8" name="Darkoath Fellrider" entryId="3a4-6557-ea1d-e314::83d2-a74f-3a67-c750" number="1" type="model" from="entry"><selections><selection id="d974o7s" name="Warsteed's Hooves" entryId="3a4-6557-ea1d-e314::a12a-9554-1e97-590d" number="1" type="upgrade" from="entry"><profiles><profile id="70d1-355c-f89a-3d83" name="Warsteed's Hooves" hidden