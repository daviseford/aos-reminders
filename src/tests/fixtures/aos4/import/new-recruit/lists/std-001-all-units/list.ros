tic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if the enemy unit is in combat with a friendly **Chaos Legionnaires** or **Chaos Furies** unit. On a 5+, that command has no effect. The command still counts as having been used and the command points spent to use the command are still lost.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="924e-d020-f5-b7fb" name="Veins of Black Lightning" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit can use this ability if it has been destroyed.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll 2D6. Add 1 to the roll if a friendly **Be'lakor** is on the battlefield. On an 8+, set up a replacement unit on the battlefield more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Core^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="2omwonp" name="Eternus, Blade of the First Prince" entryId="2216-442a-cba-5a67::cda4-acab-4fb6-eeb8" number="1" type="model" from="entry"><selections><selection id="2qvpvh" name="Death Glaive and Skull Flail" entryId="2216-442a-cba-5a67::4c91-2a10-7710-5064" number="1" type="upgrade" from="entry"><profiles><profile id="f7c6-e49e-689a-3869" name="Death Glaive and Skull Flail" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="2q9imuq" name="Drakocephalus's Fangs" entryId="2216-442a-cba-5a67::c081-a71d-bf23-13d9" number="1" type="upgrade" from="entry"><profiles><profile id="e3c4-2c80-ba73-e2d" name="Drakocephalus's Fangs" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="160" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="926c-df8c-6841-d49e" name="CAVALRY" entryId="926c-df8c-6841-d49e" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /></categories></selection><selection id="2z8sjzro" name="Exalted Hero of Chaos" entryId="2332-5544-532f-b77b::ce02-e726-b9c0-28f8" number="1" type="unit" from="entry"><profiles><profile id="b9e1-4a62-b6ce-342" name="Exalted Hero of Chaos" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="7a6e-25fa-246-294b" name="Glory-seeker" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Damage characteristic of this unit's melee weapons for attacks that target **^^Heroes^^** or **^^Monsters^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="36x7p9k" name="Exalted Hero of Chaos" entryId="2332-5544-532f-b77b::6314-b089-2b57-7e9" number="1" type="model" from="entry"><selections><selection id="3bflw8j" name="Blades of the Dark Champion" entryId="2332-5544-532f-b77b::866a-2e2c-f0a4-624e" number="1" type="upgrade" from="entry"><profiles><profile id="7f08-5f89-1e1-c0e8" name="Blades of the Dark Champion" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Hero^^** (+1 Rend), Anti-**^^Monster^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="90" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="e06-cc4d-8589-c273" name="WARRIORS OF CHAOS" entryId="e06-cc4d-8589-c273" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /></categories></selection><selection id="3lf42vw" name="Gaunt Summoner" entryId="e664-cf6d-9d6a-74df::6d8c-8fd5-7276-ea" number="1" type="unit" from="entry"><profiles><profile id="9167-98a1-2ddf-d955" name="Gaunt Summoner" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="53ac-5fbc-bfb1-6505" name="Minions of the Silver Tower" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit that has not been deployed to be the target</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The target is set up in reserve **in a Silver Tower**. It has now been deployed.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="f7ce-7d49-1c14-158" name="Book of Profane Secrets" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit **in a Silver Tower** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up the target on the battlefield wholly within 12&quot; of this unit and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="e179-7d9-ae12-ca86" name="Divert Realmgate" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Make a casting roll of 2D6</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Units set up this turn using this unit's 'Book of Profane Secrets' ability can be set up wholly within 18&quot; of this unit and more than 7&quot; from all enemy units instead of the distances in the ability.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="3mpi4vk" name="Gaunt Summoner" entryId="e664-cf6d-9d6a-74df::e6f1-4aa-b0e-547d" number="1" type="model" from="entry"><selections><selection id="3ql6enq" name="Changestaff" entryId="e664-cf6d-9d6a-74df::7a3c-e43b-253a-250d" number="1" type="upgrade" from="entry"><profiles><profile id="547c-9dd8-fca0-38c1" name="Changestaff" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="3qoaapb" name="Warptongue Blade" entryId="e664-cf6d-9d6a-74df::7a8a-7ae2-7f50-22b7" number="1" type="upgrade" from="entry"><profiles><profile id="c34e-81b8-ec0a-340c" name="Warptongue Blade" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="160" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="cd13-c472-ceff-5bd8" name="PLEDGED TO TZEENTCH" entryId="cd13-c472-ceff-5bd8" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /></categories></selection><selection id="41q3ewr" name="Gaunt Summoner on Disc of Tzeentch" entryId="29a2-9f72-5dc2-cd4::de-30dc-2385-d1d1" number="1" type="unit" from="entry"><profiles><profile id="52b0-4717-df14-9dfe" name="Gaunt Summoner on Disc of Tzeentch" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">14&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="bdd9-da8f-ec1c-5574" name="Minions of the Silver Tower" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit that has not been deployed to be the target</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The target is set up in reserve **in a Silver Tower**. It has now been deployed.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="14ab-ce70-c4ae-f897" name="Book of Profane Secrets" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit **in a Silver Tower** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up the target on the battlefield wholly within 12&quot; of this unit and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ebbe-d0e3-b2bd-6d5a" name="Arcane Imprisonment" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick an enemy Hero in combat with this unit to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">If the unmodified casting roll exceeds the target's Health characteristic, it is automatically destroyed. For the rest of the battle, that unit cannot be picked to be the target of an ability that allows a replacement unit to be set up.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="416yf0r" name="Gaunt Summoner on Disc of Tzeentch" entryId="29a2-9f72-5dc2-cd4::212b-129d-1fdf-2137" number="1" type="model" from="entry"><selections><selection id="46sbh8y" name="Changestaff" entryId="29a2-9f72-5dc2-cd4::57ed-8ad7-4f39-ec85" number="1" type="upgrade" from="entry"><profiles><profile id="3196-3716-8abf-de6f" name="Changestaff" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="46owxil" name="Disc's Teeth and Horns" entryId="29a2-9f72-5dc2-cd4::fc9d-c8e-d6f0-ef02" number="1" type="upgrade" from="entry"><profiles><profile id="e9a9-de6f-8892-a1c6" name="Disc's Teeth and Horns" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="462i8hg" name="Warptongue Blade" entryId="29a2-9f72-5dc2-cd4::ef26-47c6-4a87-1678" number="1" type="upgrade" from="entry"><profiles><profile id="fb63-3ce2-3649-921" name="Warptongue Blade" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="190" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="926c-df8c-6841-d49e" name="CAVALRY" entryId="926c-df8c-6841-d49e" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="cd13-c472-ceff-5bd8" name="PLEDGED TO TZEENTCH" entryId="cd13-c472-ceff-5bd8" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /></categories></selection><selection id="4hf17zb" name="Gunnar Brand" entryId="6ae-10fb-92fd-affb::dd16-c1dc-4ff-85f2" number="1" type="unit" from="entry"><profiles><profile id="6ccc-526f-3d77-4232" name="Gunnar Brand" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="16f8-f0de-5042-55a7" name="Carve a Path to Glory" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit can only use this ability if it is in combat with an enemy **^^Hero^^**.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can use 2 **^^Fight^^** abilities this phase. After the first is used, however, this unit has **^^Strike-last^^** for the rest of the turn. When using the second **^^Fight^^** ability, this unit must pick an enemy **^^Hero^^** to be the target of all of its attacks.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="6e41-93ac-4b61-4f0e" name="Oath of Bloodshed" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit can only use this ability if any enemy **^^Heroes^^** were slain by this unit's combat attacks this turn.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Friendly **^^Gunnar's Oathsworn^^** units have **^^Ward (4+)^^** for the rest of the battle.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="4hkcvl" name="Gunnar Brand" entryId="6ae-10fb-92fd-affb::2376-e45a-342a-591d" number="1" type="model" from="entry"><selections><selection id="4j6nzu" name="Dual Axes" entryId="6ae-10fb-92fd-affb::669a-6cb3-55c1-bb53" number="1" type="upgrade" from="entry"><profiles><profile id="b27-9142-8ad9-b5f1" name="Dual Axes" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">10</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="180" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="56-43e3-895c-2c26" name="DARKOATH" entryId="56-43e3-895c-2c26" primary="false" /><category id="500-4d38-67a4-feed" name="GUNNAR'S OATHSWORN" entryId="500-4d38-67a4-feed" primary="false" /></categories></selection><selection id="1e0lmwg" name="Ogroid Myrmidon" entryId="2ea9-d799-4ed9-7920::2955-114b-f931-cafa" number="1" type="unit" from="entry"><profiles><profile id="a879-5770-fb13-1470" name="Ogroid Myrmidon" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="dd5d-14a5-2558-6c27" name="Myrmidon Rage" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit is damaged, add 2 to the Attacks characteristic of its melee weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="a038-30e7-13c2-afa9" name="Pit Master" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Fight^^** ability for this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a friendly **Ogroid Theridons** unit that has not used a **^^Fight^^** ability this turn and is within this unit's combat range to be the target. The target can be picked to use a **^^Fight^^** ability immediately after the **^^Fight^^** ability used by this unit has been resolved. If it is picked to do so, add 1 to hit rolls for the target's attacks for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="1fc564r" name="Ogroid Myrmidon" entryId="2ea9-d799-4ed9-7920::eb5d-35cb-ebc8-2f99" number="1" type="model" from="entry"><selections><selection id="1jgajg9" name="Gladiator Spear" entryId="2ea9-d799-4ed9-7920::a712-eaab-a9a1-24cf" number="1" type="upgrade" from="entry"><profiles><profile id="def9-74c7-ff57-5087" name="Gladiator Spear" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Monster^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="1jzhb7" name="Gladiator Spear" entryId="2ea9-d799-4ed9-7920::45e-9048-affd-c8b1" number="1" type="upgrade" from="entry"><profiles><profile id="d9e2-fac4-f4cc-600d" name="Gladiator Spear" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">1</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /></categories></selection><selection id="1xevste" name="Chaos Chosen" entryId="6ed1-cf02-cd29-1db5::3aa3-1abd-dbb-4a18" number="1" type="unit" from="entry"><profiles><profile id="4160-8ca2-8095-58d7" name="Chaos Chosen" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">3</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="3483-eacd-835e-8f08" name="Heralds of Ruination" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can use 2 **^^Fight^^** abilities  this phase. After the first is used, however, this unit has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="24qs9zl" name="Chaos Chosen" entryId="6ed1-cf02-cd29-1db5::f1c3-f381-86f3-d6f7" number="1" type="model" from="entry"><selections><selection id="24mh825" name="Soul Splitter" entryId="6ed1-cf02-cd29-1db5::5024-a69f-15d5-1777" number="1" type="upgrade" from="entry"><profiles><profile id="a595-692a-efc9-dabe" name="Soul Splitter" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="24rdsll" name="Champion" entryId="6ed1-cf02-cd29-1db5::2049-2f43-bdf-e81c::9c21-1746-9873-a5b5" entryGroupId="6ed1-cf02-cd29-1db5::9314-c1a8-2f03-c4da" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="25eti3" name="Chaos Chosen" entryId="6ed1-cf02-cd29-1db5::f1c3-f381-86f3-d6f7" number="1" type="model" from="entry"><selections><selection id="26goyt" name="Soul Splitter" entryId="6ed1-cf02-cd29-1db5::5024-a69f-15d5-1777" number="1" type="upgrade" from="entry"><profiles><profile id="a595-692a-efc9-dabe" name="Soul Splitter" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="26gzj9h" name="Musician" entryId="6ed1-cf02-cd29-1db5::4986-5db7-790f-a59d::2475-183b-3802-4431" entryGroupId="6ed1-cf02-cd29-1db5::9314-c1a8-2f03-c4da" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="ef81-53a1-5559-5aa1" name="Musician" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any musicians, if it uses the 'Rally' command, you can make one additional rally roll of D6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="27yeaxj" name="Chaos Chosen" entryId="6ed1-cf02-cd29-1db5::f1c3-f381-86f3-d6f7" number="1" type="model" from="entry"><selections><selection id="27lwnfd" name="Soul Splitter" entryId="6ed1-cf02-cd29-1db5::5024-a69f-15d5-1777" number="1" type="upgrade" from="entry"><profiles><profile id="a595-692a-efc9-dabe" name="Soul Splitter" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="27so8nl" name="Standard Bearer" entryId="6ed1-cf02-cd29-1db5::6d64-327e-8197-a234::7f34-77c9-597-62c3" entryGroupId="6ed1-cf02-cd29-1db5::9314-c1a8-2f03-c4da" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="1ec9-5b34-74df-6e40" name="Standard Bearer" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any standard bearers, add 1 to this unit's control score.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="28jkyip" name="Chaos Chosen" entryId="6ed1-cf02-cd29-1db5::f1c3-f381-86f3-d6f7" number="2" type="model" from="entry"><selections><selection id="28dgu6g" name="Soul Splitter" entryId="6ed1-cf02-cd29-1db5::5024-a69f-15d5-1777" number="2" type="upgrade" from="entry"><profiles><profile id="a595-692a-efc9-dabe" name="Soul Splitter" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="250" /></costs><categories><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="e06-cc4d-8589-c273" name="WARRIORS OF CHAOS" entryId="e06-cc4d-8589-c273" primary="false" /><category id="73c-8e22-9dde-f97" name="STANDARD BEARER (1/5)" entryId="73c-8e22-9dde-f97" primary="false" /><category id="dd6f-27e9-b16e-24ee" name="MUSICIAN (1/5)" entryId="dd6f-27e9-b16e-24ee" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /></categories></selection><selection id="2n0ayng" name="Chaos Furies" entryId="8056-31ae-f57d-1b5c::cdb1-4aba-7c64-aa4d" number="1" type="unit" from="entry"><profiles><profile id="2f61-bd68-7e45-b150" name="Chaos Furies" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">1</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="3d49-b0a8-1ed9-e8de" name="Sneaky Little Devils" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is in combat, roll a dice. On a 3+, this unit can immediately use the 'Retreat' ability as if it were your movement phase without any mortal damage being inflicted on it.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="2p34lj" name="Chaos Furies" entryId="8056-31ae-f57d-1b5c::dcb3-852d-93cd-31c3" number="6" type="model" from="entry"><selections><selection id="2pp3xk6" name="Razor-sharp Dagger and Claws" entryId="8056-31ae-f57d-1b5c::d218-eae4-5e75-2765" number="6" type="upgrade" from="entry"><profiles><profile id="1e5e-e81-a40a-4692" name="Razor-sharp Dagger and Claws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /></categories></selection><selection id="38amn5p" name="Chaos Legionnaires" entryId="4cc1-e1ce-25e8-65f::82e2-c548-4d0f-3f1e" number="1" type="unit" from="entry"><profiles><profile id="57bd-8506-5d99-14e1" name="Chaos Legionnaires" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">1</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="d133-b237-f178-b70f" name="Sow Confusion" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit within 6&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 4+, the target cannot use commands for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="3a6c01d" name="Chaos Legionnaires" entryId="4cc1-e1ce-25e8-65f::c40-76fd-39fc-d3ac" number="1" type="model" from="entry"><selections><selection id="3acnw8f" name="Darkiron Weapons" entryId="4cc1-e1ce-25e8-65f::3bde-a60f-c629-a876" number="1" type="upgrade" from="entry"><profiles><profile id="8515-f3bb-8456-b6af" name="Darkiron Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="3bs4umk" name="Champion" entryId="4cc1-e1ce-25e8-65f::c4c8-ca65-a291-9860::9c21-1746-9873-a5b5" entryGroupId="4cc1-e1ce-25e8-65f::7798-240f-4a6b-fdd8" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="3bqjh53" name="Chaos Legionnaires" entryId="4cc1-e1ce-25e8-65f::c40-76fd-39fc-d3ac" number="7" type="model" from="entry"><selections><selection id="3br7hrc" name="Darkiron Weapons" entryId="4cc1-e1ce-25e8-65f::3bde-a60f-c629-a876" number="7" type="upgrade" from="entry"><profiles><profile id="8515-f3bb-8456-b6af" name="Darkiron Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="80" /></costs><categories><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="d131-3bfe-3ff4-a703" name="CHAMPION (1/8)" entryId="d131-3bfe-3ff4-a703" primary="false" /><category id="9ff6-420e-8f6d-f6dd" name="UNDIVIDED" entryId="9ff6-420e-8f6d-f6dd" primary="false" /></categories></selection><selection id="3oyajkj" name="Chaos Warriors" entryId="a4d-69f-3560-269f::d19d-83a0-f443-4e83" number="1" type="unit" from="entry"><profiles><profile id="22e1-23ff-6d6e-4ac7" name="Chaos Warriors" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="7690-b792-a413-f0d3" name="Bringers of Desolation" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of this unit's Rune-etched Weapons while it is contesting an objective you control.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-1