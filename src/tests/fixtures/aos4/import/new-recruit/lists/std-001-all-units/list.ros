categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="3t648ju" name="Chaos Warrior" entryId="a4d-69f-3560-269f::da25-23b6-6a5b-477b" number="1" type="model" from="entry"><selections><selection id="3tl957s" name="Rune-etched Weapons" entryId="a4d-69f-3560-269f::57fc-9b6-63df-3302" number="1" type="upgrade" from="entry"><profiles><profile id="cee0-221-1748-ffa8" name="Rune-etched Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="3txwudg" name="Musician" entryId="a4d-69f-3560-269f::ec13-ba29-10c9-260a::2475-183b-3802-4431" entryGroupId="a4d-69f-3560-269f::47b4-cb57-b2de-c01" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="ef81-53a1-5559-5aa1" name="Musician" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any musicians, if it uses the 'Rally' command, you can make one additional rally roll of D6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="3u0r7x" name="Chaos Warrior" entryId="a4d-69f-3560-269f::da25-23b6-6a5b-477b" number="1" type="model" from="entry"><selections><selection id="3vtqi3n" name="Rune-etched Weapons" entryId="a4d-69f-3560-269f::57fc-9b6-63df-3302" number="1" type="upgrade" from="entry"><profiles><profile id="cee0-221-1748-ffa8" name="Rune-etched Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="3vp87y" name="Standard Bearer" entryId="a4d-69f-3560-269f::29ca-f904-d59b-3450::7f34-77c9-597-62c3" entryGroupId="a4d-69f-3560-269f::47b4-cb57-b2de-c01" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="1ec9-5b34-74df-6e40" name="Standard Bearer" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any standard bearers, add 1 to this unit's control score.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="3zadhb" name="Chaos Warrior" entryId="a4d-69f-3560-269f::da25-23b6-6a5b-477b" number="7" type="model" from="entry"><selections><selection id="3zpp3gq" name="Rune-etched Weapons" entryId="a4d-69f-3560-269f::57fc-9b6-63df-3302" number="7" type="upgrade" from="entry"><profiles><profile id="cee0-221-1748-ffa8" name="Rune-etched Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="180" /></costs><categories><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="94d9-cc36-9083-1bea" name="SLAVES TO DARKNESS" entryId="94d9-cc36-9083-1bea" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="e06-cc4d-8589-c273" name="WARRIORS OF CHAOS" entryId="e06-cc4d-8589-c273" primary="false" /><category id="1f17-ad98-ada0-ccf" name="STANDARD BEARER (1/10)" entryId="1f17-ad98-ada0-ccf" primary="false" /><category id="eeed-ef77-b0d-fa9d" name="MUSICIAN (1/10)" entryId="eeed-ef77-b0d-fa9d" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /></categories></selection><selection id="4ex0psh" name="Chaos Warriors (Scourge of Aqshy)" entryId="6865-b967-c844-62fe::7f31-5d2b-4916-28fc" number="1" type="unit" from="entry"><profiles><profile id="9d5c-56c9-902d-12c7" name="Chaos Warriors" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="1b41-1f4d-2eee-42f6" name="For the Glory of the Dark Gods" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Until the start of your next turn, the following cumulative effects apply depending on your **fury level**.
**1+ Riled:** This unit has **Ward (6+)**.
**4+ Seething:** This unit's melee weapons have **Anti-charge (+1 Rend)**.
**7 Enraged:** This unit has **Strike-first** while it has not charged in the same turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="4hvcrh" name="Chaos Warrior" entryId="6865-b967-c844-62fe::ecf5-878c-3da0-59a1" number="1" type="model" from="entry"><selections><selection id="4ht47so" name="Rune-etched Weapons" entryId="6865-b967-c844-62fe::49bc-ceb9-f472-53ca" number="1" type="upgrade" from="entry"><profiles><profile id="2be6-782c-ccb3-1d28" name="Rune-etched Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="4isvha9" name="Champion" entryId="6865-b967-c844-62fe::d3b3-e1f2-69cd-a19c::9c21-1746-9873-a5b5" entryGroupId="6865-b967-c844-62fe::ffb4-67f1-f405-e45c" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="