<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<roster id="qftjvpt" name="sce-001-minimal" battleScribeVersion="2.03" generatedBy="https://newrecruit.eu" gameSystemId="e51d-b1a3-75fc-dc3g" gameSystemName="Age of Sigmar 4.0" gameSystemRevision="98" xmlns="http://www.battlescribe.net/schema/rosterSchema"><costs><cost name="pts" typeId="points" value="290" /></costs><costLimits><costLimit name="pts" typeId="points" value="0" /></costLimits><forces><force id="rfzxje" name="✦ General's Handbook 2026-27" entryId="0151-9c5b-2f1e-32d4" catalogueId="1bd9-ad7d-68ee-3b53" catalogueRevision="43" catalogueName="Stormcast Eternals"><selections><selection id="y9hht9q" name="Battle Formation" entryId="f9f2-b319-9438-8018" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="yky4pb" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="yucnvar" name="Manifestation Lore" entryId="73df-61c3-fe61-fd9e" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="yzxq7z" name="Prayer Lore" entryId="de6e-8056-614e-3ce" number="1" type="upgrade" from="entry"><selections><selection id="z04hif" name="Prayers of the Stormhosts" entryId="c8e0-bb73-b79c-a6e::9c59-6b34-440b-e995" entryGroupId="c8e0-bb73-b79c-a6e::ee46-f3e1-49eb-3473" number="1" type="upgrade" from="group" group="Prayer Lores"><selections><selection id="z1ztmv5" name="Bless Weapons" entryId="c8e0-bb73-b79c-a6e::efc0-9490-1916-b1a9::5e2c-6f44-b2bb-2056" entryGroupId="c8e0-bb73-b79c-a6e::efc0-9490-1916-b1a9::fd49-a817-9a05-0fed" number="1" type="upgrade" from="group" group="Prayers of the Stormhosts"><profiles><profile id="a212-6778-13b7-6956" name="Bless Weapons" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">6</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Stormcast Eternals Priest^^** to chant this prayer, pick a visible friendly **^^Stormcast Eternals Infantry^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Add 1 to the Attacks characteristic of the target's melee weapons until the start of your next turn. If the chanting roll was 12+, this ability affects all visible friendly **^^Stormcast Eternals^^** units wholly within 12&quot; of the chanter.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="z3qqmbc" name="Healing Storm" entryId="c8e0-bb73-b79c-a6e::efc0-9490-1916-b1a9::890a-eb2e-4b2b-3b9b" entryGroupId="c8e0-bb73-b79c-a6e::efc0-9490-1916-b1a9::fd49-a817-9a05-0fed" number="1" type="upgrade" from="group" group="Prayers of the Stormhosts"><profiles><profile id="fd50-2bf5-d357-963b" name="Healing Storm" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Stormcast Eternals Priest^^** to chant this prayer, pick a visible friendly **^^Stormcast Eternals^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Heal (D3) the target. If the chanting roll was 8+, **Heal (D3)** each visible friendly **^^Stormcast Eternals^^** unit wholly within 12&quot; of the chanter instead.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="z24gozt" name="Translocation" entryId="c8e0-bb73-b79c-a6e::efc0-9490-1916-b1a9::3957-710b-63c7-a195" entryGroupId="c8e0-bb73-b79c-a6e::efc0-9490-1916-b1a9::fd49-a817-9a05-0fed" number="1" type="upgrade" from="group" group="Prayers of the Stormhosts"><profiles><profile id="7a2f-7e4f-f4dd-ad5a" name="Translocation" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Stormcast Eternals Priest^^** to chant this prayer, pick a visible friendly **^^Stormcast Eternals^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Remove the target from the battlefield and set it up again on the battlefield more than 9&quot; from all enemy units. In addition, if the chanting roll was 8+, subtract 1 from hit rolls for attacks that target that unit for the rest of the battle round.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="z6zrwcg" name="Spell Lore" entryId="5e33-eceb-77ff-40f7" number="1" type="upgrade" from="entry"><selections><selection id="z7fahrf" name="Lore of the Storm" entryId="2112-370d-2063-fce9::2285-4dfc-1208-bf19" entryGroupId="2112-370d-2063-fce9::7858-5cb4-6a88-e66e" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="z9jv7rh" name="Lightning Blast" entryId="2112-370d-2063-fce9::5a87-7f3a-46fc-dc0d::dbe3-971c-d2ac-e4c8" entryGroupId="2112-370d-2063-fce9::5a87-7f3a-46fc-dc0d::b054-bd72-a5bf-1319" number="1" type="upgrade" from="group" group="Lore of the Storm"><profiles><profile id="b918-ea95-5c6e-1dd5" name="Lightning Blast" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Stormcast Eternals Wizard^^** to cast this spell, then pick the closest visible enemy unit to them that has not been picked to be the target of this ability this turn to be the target. If 2 or more visible enemy units are tied to be the closest, you can pick which is the target. Then, make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict D3 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection><selection id="z906jl7" name="Starfall" entryId="2112-370d-2063-fce9::5a87-7f3a-46fc-dc0d::87d1-0549-f5ed-810f" entryGroupId="2112-370d-2063-fce9::5a87-7f3a-46fc-dc0d::b054-bd72-a5bf-1319" number="1" type="upgrade" from="group" group="Lore of the Storm"><profiles><profile id="c012-a1f9-fc99-fc24" name="Starfall" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Stormcast Eternals Wizard^^** to cast this spell, pick a visible enemy **^^Infantry^^** or **^^Cavalry^^** unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, subtract 1 from the number of dice rolled when making charge rolls for the target, to a minimum of 1.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection><selection id="z94ckia" name="Thundershock" entryId="2112-370d-2063-fce9::5a87-7f3a-46fc-dc0d::0493-27db-365f-1927" entryGroupId="2112-370d-2063-fce9::5a87-7f3a-46fc-dc0d::b054-bd72-a5bf-1319" number="1" type="upgrade" from="group" group="Lore of the Storm"><profiles><profile id="614c-a95c-49a9-a0bc" name="Thundershock" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Stormcast Eternals Wizard^^** to cast this spell, picka visible enemy unit within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Subtract 1 from wound rolls for the target's attacks until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection></selections><costs><cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="1" /></costs><categories><category name="Configuration" id="11euezw" primary="false" entryId="676-2b78-7bbf-ba9c" /><category name="Reference" id="122onfp" primary="false" entryId="3360-1158-e879-9606" /><category name="Army Composition" id="s3w7tsuj" primary="false" entryId="ac97-b27c-7e35-7ab9" /><category name="FACTION TERRAIN" id="13ov6xb" primary="false" entryId="cdd6-ffa1-9b32-4cb8" /><category name="Illegal Units" id="137atz" primary="false" entryId="(Illegal Units)" /></categories><forces><force id="x4oooiga" name="Regiment" entryId="b016-6952-57f2-c82b::376a-6b97-8699-dd59" catalogueId="1bd9-ad7d-68ee-3b53" catalogueRevision="43" catalogueName="Stormcast Eternals"><selections><selection id="kanfwh" name="Gardus Steel Soul" entryId="7bdd-c75c-52bc-69c7::227e-824c-67f-e51f" number="1" type="unit" from="entry"><profiles><profile id="fbcc-d95f-abc-f5d1" name="Gardus Steel Soul" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="1a29-b3d7-a5aa-f47d" name="Aura of Purity" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this unit charged this turn, for the rest of the turn, friendly **^^Stormcast Eternals^^** units have **^^Ward (5+)^^** while they are wholly within 12&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="4a21-909a-fd24-5ba" name="Saintly Assault" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 visible friendly **^^Stormcast Eternals Infantry^^** units wholly within 6&quot; of this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn:
• Add 1 to charge rolls for the targets.
• Add 1 to the Attacks characteristic of the targets' melee weapons.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="kdxwv8lh" name="Gardus Steel Soul" entryId="7bdd-c75c-52bc-69c7::ef10-6eb2-acfa-d19c" number="1" type="model" from="entry"><selections><selection id="kjd2qe9" name="Sigmarite Runeblade and Warhammer" entryId="7bdd-c75c-52bc-69c7::f235-101d-5034-f553" number="1" type="upgrade" from="entry"><profiles><profile id="c162-6d87-5e15-d8f3" name="Sigmarite Runeblade and Warhammer" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="160" /></costs><categories><category id="6e72-1656-d554-528a" name="HERO" entryId="6e72-1656-d554-528a" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="a437-a8f0-67ba-c674" name="STORMCAST ETERNALS" entryId="a437-a8f0-67ba-c674" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="94a8-e786-4b45-1c16" name="WARRIOR CHAMBER" entryId="94a8-e786-4b45-1c16" primary="false" /><category id="db3a-7199-c92e-f3cf" name="Regimental Option" entryId="db3a-7199-c92e-f3cf" primary="false" /><category id="d1f3-921c-b403-1106" entryId="d1f3-921c-b403-1106" name="Regimental Leader" primary="true" /></categories></selection><selection id="yh1o0e7" name="Annihilators" entryId="8ce6-2f0f-5f04-053b::abd7-bf0a-b2f9-8cc2" number="1" type="unit" from="entry"><profiles><profile id="6f11-6f17-518-7c99" name="Annihilators" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">3</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">2+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="8628-1913-f270-67a0" name="Brace for Impact" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit that charged this turn and is in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice for each model in this unit. If any of the rolls are a 6, the target has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="88f6-6194-52cb-e61" name="Blazing Impact" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit was set up this turn using the 'Scions of the Storm' ability, pick up to 3 enemy units within 10&quot; of it to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3 for each target. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="ylijgra" name="Annihilator" entryId="8ce6-2f0f-5f04-053b::ac23-d97e-1ed9-5fea" number="1" type="model" from="entry"><selections><selection id="ym8jxgg" name="Meteoric Hammer" entryId="8ce6-2f0f-5f04-053b::673-58a7-5f9e-29fc" number="1" type="upgrade" from="entry"><profiles><profile id="179d-b1e2-9992-d029" name="Meteoric Hammer" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="ymawlf" name="Champion" entryId="8ce6-2f0f-5f04-053b::edb-48a6-d390-6528::9c21-1746-9873-a5b5" entryGroupId="8ce6-2f0f-5f04-053b::4ada-70c-99a5-53c5" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-