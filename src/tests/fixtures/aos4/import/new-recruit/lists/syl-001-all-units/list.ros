ypeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="140" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="acaf-8bb6-d6f-3e2a" name="Legends" entryId="acaf-8bb6-d6f-3e2a" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="dd6f-27e9-b16e-24ee" name="MUSICIAN (1/5)" entryId="dd6f-27e9-b16e-24ee" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /></categories></selection><selection id="5vk1rz" name="Treelord" entryId="a53e-d251-9986-28ac::a896-d266-a881-f920" number="1" type="unit" from="entry"><profiles><profile id="5a07-a18f-c9c1-a577" name="Treelord" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="8fb-4487-5931-ee4" name="Strangling Grasp" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 10&quot; of this unit to be the target</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. If the roll exceeds the target's Health characteristic, 1 model in the target unit is slain.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="72ad-d57-fafa-aacb" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Sweeping Blows** is 3.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="34c7-4f3e-b37f-8155" name="Lash And Tangle" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit that had any damage points allocated to it this turn by attacks made with this unit's **Strangleroots** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if the target is within the **creeping overgrowth**. On a 3+, subtract 1 from hit rolls for the target's attacks until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="5w42zpj" name="Treelord" entryId="a53e-d251-9986-28ac::4849-40d6-2c75-310e" number="1" type="model" from="entry"><selections><selection id="5x62tb" name="Massive Impaling Talons" entryId="a53e-d251-9986-28ac::659c-b2db-bbd3-1b5b" number="1" type="upgrade" from="entry"><profiles><profile id="3b15-bd4d-14e6-511c" name="Massive Impaling Talons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="5xv1vkt" name="Strangleroots" entryId="a53e-d251-9986-28ac::638f-76e3-b2a9-c722" number="1" type="upgrade" from="entry"><profiles><profile id="c18e-2532-b8d7-5184" name="Strangleroots" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="5xdk37r" name="Sweeping Blows" entryId="a53e-d251-9986-28ac::5332-3e59-4b4f-e01c" number="1" type="upgrade" from="entry"><profiles><profile id="3c4b-d3d5-9c85-6726" name="Sweeping Blows" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-charge (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="240" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /><category id="e467-244c-3711-033d" name="FOREST ELDER" entryId="e467-244c-3711-033d" primary="false" /></categories></selection><selection id="6drijqo" name="Revenant Seekers" entryId="965-51e3-4beb-db4e::766a-54f1-440b-b878" number="1" type="unit" from="entry"><profiles><profile id="b41d-14d5-58c0-9478" name="Revenant Seekers" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="5619-8dcb-deb0-fc9" name="Deafening Drone" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit did not charge this turn, pick an enemy unit in combat with it to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Subtract 1 from the Attacks characteristic of the target's melee weapons for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="c2a3-ddfb-c07e-afc8" name="Forest Fighters" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit has a coherency range of 2&quot;.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="6fext7o" name="Revenant Seeker" entryId="965-51e3-4beb-db4e::c5cb-67cc-4f93-822f" number="1" type="model" from="entry"><selections><selection id="6gn59b7" name="Dragonspite's Mandibles" entryId="965-51e3-4beb-db4e::de63-f686-f142-38e8" number="1" type="upgrade" from="entry"><profiles><profile id="43e2-e587-a221-7ab" name="Dragonspite's Mandibles" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="6gkz52a" name="Seeker's Sickle" entryId="965-51e3-4beb-db4e::89f2-c2d9-bbd9-8938" number="1" type="upgrade" from="entry"><profiles><profile id="e1a3-96df-1a4-4ecc" name="Seeker's Sickle" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="6g8ubfa" name="Champion" entryId="965-51e3-4beb-db4e::a98a-daf2-b9c4-321f::9c21-1746-9873-a5b5" entryGroupId="965-51e3-4beb-db4e::fa0-b579-2008-e2f2" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="6hlzl80i" name="Revenant Seeker" entryId="965-51e3-4beb-db4e::c5cb-67cc-4f93-822f" number="1" type="model" from="entry"><selections><selection id="6hjn2ap" name="Dragonspite's Mandibles" entryId="965-51e3-4beb-db4e::de63-f686-f142-38e8" number="1" type="upgrade" from="entry"><profiles><profile id="43e2-e587-a221-7ab" name="Dragonspite's Mandibles" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="6h6ntw" name="Seeker's Sickle" entryId="965-51e3-4beb-db4e::89f2-c2d9-bbd9-8938" number="1" type="upgrade" from="entry"><profiles><profile id="e1a3-96df-1a4-4ecc" name="Seeker's Sickle" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="6ihqsut9" name="Musician" entryId="965-51e3-4beb-db4e::8cb3-828a-f93f-9c34::2475-183b-3802-4431" entryGroupId="965-51e3-4beb-db4e::fa0-b579-2008-e2f2" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="ef81-53a1-5559-5aa1" name="Musician" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any musicians, if it uses the 'Rally' command, you can make one additional rally roll of D6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="6j0dpn" name="Revenant Seeker" entryId="965-51e3-4beb-db4e::c5cb-67cc-4f93-822f" number="1" type="model" from="entry"><selections><selection id="6jnwz4l" name="Dragonspite's Mandibles" entryId="965-51e3-4beb-db4e::de63-f686-f142-38e8" number="1" type="upgrade" from="entry"><profiles><profile id="43e2-e587-a221-7ab" name="Dragonspite's Mandibles" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="6j7j03g" name="Seeker's Sickle" entryId="965-51e3-4beb-db4e::89f2-c2d9-bbd9-8938" number="1" type="upgrade" from="entry"><profiles><profile id="e1a3-96df-1a4-4ecc" name="Seeker's Sickle" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-16