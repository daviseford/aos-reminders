cteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The target has the **^^Infested^^** keyword for the rest of the battle. **^^Infested^^** enemy units cannot move more than 6&quot; when using non-**^^Charge Move^^** abilities.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3fa7-6b88-bc43-4613" name="Pain-Induced Frenzy" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit's melee weapons have **Crit (2 Hits)** if it charged in the same turn.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="4lxn48h" name="Swarmsage" entryId="686d-2413-5026-1343::2c2a-b85c-f6b4-64a4" number="1" type="model" from="entry"><selections><selection id="4mvhnwb" name="Twistroot Weapons" entryId="686d-2413-5026-1343::e17a-254f-d21e-85a" number="1" type="upgrade" from="entry"><profiles><profile id="60f0-2f25-e2cc-c168" name="Twistroot Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteri