eywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="90" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="acaf-8bb6-d6f-3e2a" name="Legends" entryId="acaf-8bb6-d6f-3e2a" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="dd6f-27e9-b16e-24ee" name="MUSICIAN (1/5)" entryId="dd6f-27e9-b16e-24ee" primary="false" /><category id="4926-51d9-e023-1088" name="KURNOTHI" entryId="4926-51d9-e023-1088" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /></categories></selection><selection id="3v00yrs" name="Spite-Revenants" entryId="13a0-2bd-f750-feb8::bede-574b-208d-f486" number="1" type="unit" from="entry"><profiles><profile id="a5bd-97b-c618-5b69" name="Spite-Revenants" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="76b2-ce61-8aec-f6c1" name="Shadowcreep" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is wholly within the **creeping overgrowth**, remove this unit from the battlefield and set it up again wholly within 3&quot; of a terrain feature and more than 9&quot; from all enemy units. Then add 1 to charge rolls for this unit for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="3yh6gq6" name="Spite-Revenant" entryId="13a0-2bd-f750-feb8::f32-3733-4a71-1d1c" number="1" type="model" from="entry"><selections><selection id="3y5ayfr" name="Cruel Talons and Fangs" entryId="13a0-2bd-f750-feb8::f6e4-6e09-59fa-abb" number="1" type="upgrade" from="entry"><profiles><profile id="be22-92f6-42db-a152" name="Cruel Talons and Fangs" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><character