ame="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="426b-9a95-d724-377b" name="REVENANT" entryId="426b-9a95-d724-377b" primary="false" /></categories></selection><selection id="6wvqak" name="Spiterider Lancers" entryId="95bf-7814-c6f0-e91a::8d4f-cdc2-f74f-daac" number="1" type="unit" from="entry"><profiles><profile id="ba57-a22-8100-1641" name="Spiterider Lancers" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="c97f-e7c2-ff91-af51" name="Strike And Fade" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit charged this turn, remove it from the battlefield and set it up again more than 9&quot; from all enemy units and wholly within the **creeping overgrowth**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attri