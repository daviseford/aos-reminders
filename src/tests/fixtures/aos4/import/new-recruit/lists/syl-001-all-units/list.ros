<roster id="u0kcuda" name="syl-001-all-units" battleScribeVersion="2.03" generatedBy="https://newrecruit.eu" gameSystemId="e51d-b1a3-75fc-dc3g" gameSystemName="Age of Sigmar 4.0" gameSystemRevision="98" xmlns="http://www.battlescribe.net/schema/rosterSchema"><costs><cost name="pts" typeId="points" value="5440" /></costs><costLimits><costLimit name="pts" typeId="points" value="0" /></costLimits><forces><force id="ua9upv8" name="✦ General's Handbook 2026-27" entryId="0151-9c5b-2f1e-32d4" catalogueId="bb7e-b0da-5c2-a980" catalogueRevision="37" catalogueName="Sylvaneth"><selections><selection id="2ga226k" name="Kurnoth's Heralds" entryId="cc10-1dc0-7c18-963a::5c29-c1ee-6dd4-a32b" number="1" type="unit" from="entry"><profiles><profile id="3167-7fb4-a6fc-3bce" name="Kurnoth's Heralds" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">3</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="66e3-fc63-291a-5e1b" name="Graceful Leaps" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this unit makes a pile-in move:
• Add 3&quot; to the distance this unit can move.
• This unit can pass through models in enemy units.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="2h4cuul" name="Cullon, Axe of Kurnoth" entryId="cc10-1dc0-7c18-963a::fe57-7847-2f9a-fa1c" number="1" type="model" from="entry"><selections><selection id="2isbgr" name="Hunter Weapons" entryId="cc10-1dc0-7c18-963a::461c-9b6a-0df0-61b8" number="1" type="upgrade" from="entry"><profiles><profile id="77ec-71f1-38db-409a" name="Hunter Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection></selections></selection><selection id="2hkl5c" name="Lenwythe, Eye of the Forest" entryId="cc10-1dc0-7c18-963a::4019-862c-88aa-4d52" number="1" type="model" from="entry"><selections><selection id="2i9ye9m" name="Hunter Weapons" entryId="cc10-1dc0-7c18-963a::3134-3d2c-83ca-d29f" number="1" type="upgrade" from="entry"><profiles><profile id="f98e-69fa-b1d4-cfc0" name="Hunter Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="2i5dipv" name="Kurnothi Bow" entryId="cc10-1dc0-7c18-963a::15d6-6a3e-287b-a3bc" number="1" type="upgrade" from="entry"><profiles><profile id="1d40-b796-98e9-9860" name="Kurnothi Bow" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection><selection id="2hcnjm7" name="Ylarin, Master of the Paths" entryId="cc10-1dc0-7c18-963a::b02d-7395-6ff0-bca0" number="1" type="model" from="entry"><selections><selection id="2jujvxi" name="Hunter Weapons" entryId="cc10-1dc0-7c18-963a::1bb6-80bb-4d9b-aa4e" number="1" type="upgrade" from="entry"><profiles><profile id="c78c-23c7-d0bc-4d96" name="Hunter Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="2j77dvn" name="Champion" entryId="cc10-1dc0-7c18-963a::3b18-3f42-64d2-8f82::9c21-1746-9873-a5b5" entryGroupId="cc10-1dc0-7c18-963a::d51f-d60e-68e5-90f4" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="acaf-8bb6-d6f-3e2a" name="Legends" entryId="acaf-8bb6-d6f-3e2a" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="4926-51d9-e023-1088" name="KURNOTHI" entryId="4926-51d9-e023-1088" primary="false" /><category id="926c-df8c-6841-d49e" name="CAVALRY" entryId="926c-df8c-6841-d49e" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="(No Category)" entryId="(No Category)" name="Uncategorized" primary="true" /></categories></selection><selection id="3hgq9pr" name="Allow Legends" entryId="7e59-2237-4890-a80a" number="1" type="upgrade" from="entry"><categories><category id="676-2b78-7bbf-ba9c" entryId="676-2b78-7bbf-ba9c" name="Configuration" primary="true" /></categories></selection><selection id="3mfpxdn" name="Battle Traits: Sylvaneth" entryId="3e25-8f0a-9dea-1954::583a-37b4-52b2-9058" number="1" type="upgrade" from="entry"><profiles><profile id="3ff5-8812-c55e-7f5a" name="Endless Growth" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each friendly **^^Sylvaneth^^** unit that is wholly within the **creeping overgrowth** to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For each target, roll a D3 and pick 1 of the following effects:


• **Heal (X)** the target, where **X** is equal to the roll.
• Return a number of slain models to it with a combined Health characteristic of up to the value of the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="bf2f-f70a-be1e-4d63" name="The Creeping Overgrowth" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The **creeping overgrowth** is measured from each terrain feature that has a friendly **overgrown token**. The range of the **creeping overgrowth** is based on the number of friendly, **overgrown tokens** on the battlefield as shown:

• 0-2 **overgrown tokens**: 6&quot;
• 3-5 **overgrown tokens**: 9&quot;
• 6-8 **overgrown tokens**: 12&quot;
• 9+ **overgrown tokens**: Whole battlefield


***Designer's Note**: Awakened Wyldwoods are your main way of generating overgrown tokens. Some unit abilities allow you to too.*</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="081a-ebf2-6a79-c4db" name="Fury of The Forest" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" from="entry"><characteristics><characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Enemy Combat Phase</characteristic><characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic><characteristic name="Declare" typeId="b77f-7548-840e-c086">Pick a friendly **^^Sylvaneth^^** unit wholly within the **creeping overgrowth** and that is in combat with only 1 enemy unit to use this ability.</characteristic><characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">The unit using this ability has **^^Strike-first^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="445d-f443-5448-e7ce"></characteristic></characteristics><attributes><attribute name="Color" typeId="5c69-e4b9-19bc-e801">Red</attribute><attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Offensive</attribute><attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8" /></attributes></profile><profile id="dcad-fc9a-65a3-b46f" name="The Land Awakens" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" from="entry"><characteristics><characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">End of Your Turn</characteristic><characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic><characteristic name="Declare" typeId="b77f-7548-840e-c086">Pick a friendly non-**^^Hero Revenant Infantry^^** unit or friendly **Dryads** unit that has been destroyed to be the target.</characteristic><characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Setup a replacement unit with half the number of models from the target unit (rounding up) wholly within **creeping overgrowth** and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="445d-f443-5448-e7ce"></characteristic></characteristics><attributes><attribute name="Color" typeId="5c69-e4b9-19bc-e801">Purple</attribute><attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute><attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8" /></attributes></profile><profile id="cea9-4cb0-e5fb-bd3e" name="Reclaimed By Nature" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If there are fewer than 3 friendly **Awakened Wyldwoods** on the battlefield, you can set up an **Awakened Wyldwood** on the battlefield more than 3&quot; from all objectives and enemy units, more than 12&quot; from all other friendly **Awakened Wyldwoods** and more than 1&quot; from all other terrain features.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="c9cf-21d7-880d-e59f" name="Creeping Dread" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Start of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit within the **creeping overgrowth** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, the first time your opponent declares a command for the target while it is not wholly within 12&quot; of a **^^Hero^^** in their army, unless your opponent spends 1 additional command point to use that command, the command has no effect, it still counts as being used and the command points spent to use the command are still lost.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><categories><category id="3360-1158-e879-9606" entryId="3360-1158-e879-9606" name="Reference" primary="true" /></categories></selection><selection id="uyeyzi" name="Battle Formation" entryId="f082-adcf-384b-f85d" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="3tjmze" name="Battle Formation" entryId="f082-adcf-384b-f85d" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="v0flz9w" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="3zenk7" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="v2mkeqm" name="Manifestation Lore" entryId="979b-6809-199-9813" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="45rydw" name="Manifestation Lore" entryId="979b-6809-199-9813" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="v93mnc" name="Prayer Lore" entryId="5a47-15aa-a82f-ced0" number="1" type="upgrade" from="entry"><selections><selection id="v9fp4w7" name="Lore of the Spirit-Song" entryId="414a-bae2-89a5-5813::156b-273a-4482-7738" entryGroupId="414a-bae2-89a5-5813::79a3-7764-f3b5-4e00" number="1" type="upgrade" from="group" group="Prayer Lores"><selections><selection id="vad3ez" name="Song Of Dread" entryId="414a-bae2-89a5-5813::4857-db24-daa7-677a::0734-e226-1b46-3b75" entryGroupId="414a-bae2-89a5-5813::4857-db24-daa7-677a::6bc6-365e-5b6d-2b9a" number="1" type="upgrade" from="group" group="Lore of the Spirit-Song"><profiles><profile id="4c37-4bd5-f9d5-170a" name="Song Of Dread" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth Priest^^** to chant this prayer, pick an enemy unit that is wholly within the **creeping overgrowth** or that is visible to them and within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 8+, you can pick another eligible unit to be a second target. Until the start of your next turn, each time a target uses a **^^Move^^** ability and ends that move within the **creeping overgrowth**, inflict D3 mortal damage on the target after that **^^Move^^** ability has been resolved.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="vaii5ft" name="Song Of The Lost" entryId="414a-bae2-89a5-5813::4857-db24-daa7-677a::e842-cdb7-4e22-fe80" entryGroupId="414a-bae2-89a5-5813::4857-db24-daa7-677a::6bc6-365e-5b6d-2b9a" number="1" type="upgrade" from="group" group="Lore of the Spirit-Song"><profiles><profile id="a865-102f-ce95-480c" name="Song Of The Lost" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth Priest^^** to chant this prayer, pick a friendly **^^Sylvaneth^^** unit that is wholly within the **creeping overgrowth** or that is visible to them and wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, subtract 1 from wound rolls for attacks that target that friendly unit. In addition, if the chanting roll was 8+, pick 1 of the following effects:
• You can **Heal (3)** the target.
• If the target is not a **^^Monster^^**, ignore modifiers to save rolls for the target (positive and negative) until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="vakqyo" name="Song Of War" entryId="414a-bae2-89a5-5813::4857-db24-daa7-677a::a51d-684b-100f-2fe5" entryGroupId="414a-bae2-89a5-5813::4857-db24-daa7-677a::6bc6-365e-5b6d-2b9a" number="1" type="upgrade" from="group" group="Lore of the Spirit-Song"><profiles><profile id="1b5b-a2e8-6dd3-17fb" name="Song Of War" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth Priest^^** to chant this prayer, pick a friendly **^^Sylvaneth^^** unit that is wholly within the **creeping overgrowth** or that is visible to them and wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 10+, you can pick another eligible unit to be a second target. Until the start of your next turn, add 1 to the Rend characteristic of the target(s) melee weapons.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="4cz0wej" name="Prayer Lore" entryId="5a47-15aa-a82f-ced0" number="1" type="upgrade" from="entry"><selections><selection id="4c1glbh" name="Lore of the Spirit-Song" entryId="414a-bae2-89a5-5813::156b-273a-4482-7738" entryGroupId="414a-bae2-89a5-5813::79a3-7764-f3b5-4e00" number="1" type="upgrade" from="group" group="Prayer Lores"><selections><selection id="4dpfife" name="Song Of Dread" entryId="414a-bae2-89a5-5813::4857-db24-daa7-677a::0734-e226-1b46-3b75" entryGroupId="414a-bae2-89a5-5813::4857-db24-daa7-677a::6bc6-365e-5b6d-2b9a" number="1" type="upgrade" from="group" group="Lore of the Spirit-Song"><profiles><profile id="4c37-4bd5-f9d5-170a" name="Song Of Dread" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth Priest^^** to chant this prayer, pick an enemy unit that is wholly within the **creeping overgrowth** or that is visible to them and within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 8+, you can pick another eligible unit to be a second target. Until the start of your next turn, each time a target uses a **^^Move^^** ability and ends that move within the **creeping overgrowth**, inflict D3 mortal damage on the target after that **^^Move^^** ability has been resolved.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="4drnl1" name="Song Of The Lost" entryId="414a-bae2-89a5-5813::4857-db24-daa7-677a::e842-cdb7-4e22-fe80" entryGroupId="414a-bae2-89a5-5813::4857-db24-daa7-677a::6bc6-365e-5b6d-2b9a" number="1" type="upgrade" from="group" group="Lore of the Spirit-Song"><profiles><profile id="a865-102f-ce95-480c" name="Song Of The Lost" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth Priest^^** to chant this prayer, pick a friendly **^^Sylvaneth^^** unit that is wholly within the **creeping overgrowth** or that is visible to them and wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, subtract 1 from wound rolls for attacks that target that friendly unit. In addition, if the chanting roll was 8+, pick 1 of the following effects:
• You can **Heal (3)** the target.
• If the target is not a **^^Monster^^**, ignore modifiers to save rolls for the target (positive and negative) until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="4dda7f4" name="Song Of War" entryId="414a-bae2-89a5-5813::4857-db24-daa7-677a::a51d-684b-100f-2fe5" entryGroupId="414a-bae2-89a5-5813::4857-db24-daa7-677a::6bc6-365e-5b6d-2b9a" number="1" type="upgrade" from="group" group="Lore of the Spirit-Song"><profiles><profile id="1b5b-a2e8-6dd3-17fb" name="Song Of War" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth Priest^^** to chant this prayer, pick a friendly **^^Sylvaneth^^** unit that is wholly within the **creeping overgrowth** or that is visible to them and wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 10+, you can pick another eligible unit to be a second target. Until the start of your next turn, add 1 to the Rend characteristic of the target(s) melee weapons.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="vbpq2sd" name="Spell Lore" entryId="7d77-a567-c3a5-7df" number="1" type="upgrade" from="entry"><selections><selection id="vcszmdg" name="Lore of the Deepwood" entryId="637a-a01-8576-e7fd::f82a-967f-acc5-486" entryGroupId="637a-a01-8576-e7fd::6cbb-5e30-1121-a587" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="vdo3bhb" name="Grasping Roots" entryId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::476d-bfce-3902-1020" entryGroupId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::b6bf-0f4d-3181-54be" number="1" type="upgrade" from="group" group="Lore of the Deepwood"><profiles><profile id="77cf-59bd-fc8e-f6c7" name="Grasping Roots" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Sylvaneth Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn:
• The target cannot use **^^Run^^** abilities.
• Subtract 1 from charge rolls for the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031" /></attributes></profile></profiles></selection><selection id="vdjniql" name="Jade Thorns" entryId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::8dd8-ff1e-5a57-3120" entryGroupId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::b6bf-0f4d-3181-54be" number="1" type="upgrade" from="group" group="Lore of the Deepwood"><profiles><profile id="97df-e136-9fb4-5aca" name="Jade Thorns" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Sylvaneth Wizard^^** to cast this spell, pick a visible friendly **^^Sylvaneth^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Add 1 to the wound rolls for the target's combat attacks for the rest of the turn, including attacks made with **Companion** weapons.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection><selection id="vd0r9tf" name="Zephyrspite Rush" entryId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::1e2e-4b17-98ae-45c9" entryGroupId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::b6bf-0f4d-3181-54be" number="1" type="upgrade" from="group" group="Lore of the Deepwood"><profiles><profile id="4ea1-b08a-3684-8d35" name="Zephyrspite Rush" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Sylvaneth Wizard^^** to cast this spell, pick a visible friendly **^^Sylvaneth^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">For the rest of the turn, the target can use **^^Charge^^** abilities even if it used a **^^Run^^** ability in the same turn.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="4i6ifli" name="Spell Lore" entryId="7d77-a567-c3a5-7df" number="1" type="upgrade" from="entry"><selections><selection id="4jh5vgr" name="Lore of the Deepwood" entryId="637a-a01-8576-e7fd::f82a-967f-acc5-486" entryGroupId="637a-a01-8576-e7fd::6cbb-5e30-1121-a587" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="4j5i0eb" name="Grasping Roots" entryId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::476d-bfce-3902-1020" entryGroupId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::b6bf-0f4d-3181-54be" number="1" type="upgrade" from="group" group="Lore of the Deepwood"><profiles><profile id="77cf-59bd-fc8e-f6c7" name="Grasping Roots" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Sylvaneth Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn:
• The target cannot use **^^Run^^** abilities.
• Subtract 1 from charge rolls for the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031" /></attributes></profile></profiles></selection><selection id="4j87vt" name="Jade Thorns" entryId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::8dd8-ff1e-5a57-3120" entryGroupId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::b6bf-0f4d-3181-54be" number="1" type="upgrade" from="group" group="Lore of the Deepwood"><profiles><profile id="97df-e136-9fb4-5aca" name="Jade Thorns" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Sylvaneth Wizard^^** to cast this spell, pick a visible friendly **^^Sylvaneth^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Add 1 to the wound rolls for the target's combat attacks for the rest of the turn, including attacks made with **Companion** weapons.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection><selection id="4jjnika" name="Zephyrspite Rush" entryId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::1e2e-4b17-98ae-45c9" entryGroupId="637a-a01-8576-e7fd::987e-cdaa-216d-612d::b6bf-0f4d-3181-54be" number="1" type="upgrade" from="group" group="Lore of the Deepwood"><profiles><profile id="4ea1-b08a-3684-8d35" name="Zephyrspite Rush" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Sylvaneth Wizard^^** to cast this spell, pick a visible friendly **^^Sylvaneth^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">For the rest of the turn, the target can use **^^Charge^^** abilities even if it used a **^^Run^^** ability in the same turn.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="vei5ckp" name="Awakened Wyldwood" entryId="c9f6-0d99-3839-3a5b::cda9-53e5-99de-f836" number="1" type="unit" from="entry"><rules><rule id="f5f8-e344-6c2c-bd33" name="Awakened Wyldwood" hidden="false"><description>**The following universal terrain abilities apply to this terrain feature (Terrain, 1.2):
Cover, Unstable, Obscuring**</description></rule></rules><profiles><profile id="3885-ae8f-a0ed-7b62" name="Budding Forest" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When this terrain feature is set up, give it a friendly **overgrown token**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="e080-894a-728e-304a" name="Awakened Wyldwood" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic></characteristics></profile><profile id="5dd6-a023-8cdb-5cb1" name="Vengeful Forest Spirits" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each enemy unit within 3&quot; of this terrain feature to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3 for each target. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8c86-1655-c6c7-be0b" name="Ever Growing" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round, Start of Battle Round</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick the closest terrain feature to this terrain feature that does not have a friendly **overgrown token** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If the target is not controlled by your opponent, give that target a friendly **overgrown token**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><categories><category id="cdd6-ffa1-9b32-4cb8" entryId="cdd6-ffa1-9b32-4cb8" name="FACTION TERRAIN" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /></categories></selection><selection id="4t0oqnr" name="Awakened Wyldwood" entryId="c9f6-0d99-3839-3a5b::cda9-53e5-99de-f836" number="1" type="unit" from="entry"><rules><rule id="f5f8-e344-6c2c-bd33" name="Awakened Wyldwood" hidden="false"><description>**The following universal terrain abilities apply to this terrain feature (Terrain, 1.2):
Cover, Unstable, Obscuring**</description></rule></rules><profiles><profile id="3885-ae8f-a0ed-7b62" name="Budding Forest" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When this terrain feature is set up, give it a friendly **overgrown token**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="e080-894a-728e-304a" name="Awakened Wyldwood" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic></characteristics></profile><profile id="5dd6-a023-8cdb-5cb1" name="Vengeful Forest Spirits" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each enemy unit within 3&quot; of this terrain feature to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3 for each target. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8c86-1655-c6c7-be0b" name="Ever Growing" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round, Start of Battle Round</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick the closest terrain feature to this terrain feature that does not have a friendly **overgrown token** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If the target is not controlled by your opponent, give that target a friendly **overgrown token**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><categories><category id="cdd6-ffa1-9b32-4cb8" entryId="cdd6-ffa1-9b32-4cb8" name="FACTION TERRAIN" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /></categories></selection></selections><costs><cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="1" /></costs><categories><category name="Uncategorized" id="yjc4q2hx" primary="false" entryId="(No Category)" /><category name="Configuration" id="yj2aax" primary="false" entryId="676-2b78-7bbf-ba9c" /><category name="Reference" id="ykny6f" primary="false" entryId="3360-1158-e879-9606" /><category name="Army Composition" id="ud1z8di" primary="false" entryId="ac97-b27c-7e35-7ab9" /><category name="FACTION TERRAIN" id="udxd5c" primary="false" entryId="cdd6-ffa1-9b32-4cb8" /><category name="Illegal Units" id="fm4huw" primary="false" entryId="(Illegal Units)" /></categories><forces><force id="j95do3e" name="Auxillary Units" entryId="6084-3baa-f00b-ac0a::8732-47c4-9f1c-e71e" catalogueId="bb7e-b0da-5c2-a980" catalogueRevision="37" catalogueName="Sylvaneth"><selections><selection id="2ssqqrw" name="Kurnoth's Heralds" entryId="cc10-1dc0-7c18-963a::5c29-c1ee-6dd4-a32b" number="1" type="unit" from="entry"><profiles><profile id="3167-7fb4-a6fc-3bce" name="Kurnoth's Heralds" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">3</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="66e3-fc63-291a-5e1b" name="Graceful Leaps" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this unit makes a pile-in move:
• Add 3&quot; to the distance this unit can move.
• This unit can pass through models in enemy units.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="2uakmhn" name="Cullon, Axe of Kurnoth" entryId="cc10-1dc0-7c18-963a::fe57-7847-2f9a-fa1c" number="1" type="model" from="entry"><selections><selection id="2vp27l" name="Hunter Weapons" entryId="cc10-1dc0-7c18-963a::461c-9b6a-0df0-61b8" number="1" type="upgrade" from="entry"><profiles><profile id="77ec-71f1-38db-409a" name="Hunter Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection></selections></selection><selection id="2tj61q9" name="Lenwythe, Eye of the Forest" entryId="cc10-1dc0-7c18-963a::4019-862c-88aa-4d52" number="1" type="model" from="entry"><selections><selection id="2wupae9" name="Hunter Weapons" entryId="cc10-1dc0-7c18-963a::3134-3d2c-83ca-d29f" number="1" type="upgrade" from="entry"><profiles><profile id="f98e-69fa-b1d4-cfc0" name="Hunter Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="2wsiy6q" name="Kurnothi Bow" entryId="cc10-1dc0-7c18-963a::15d6-6a3e-287b-a3bc" number="1" type="upgrade" from="entry"><profiles><profile id="1d40-b796-98e9-9860" name="Kurnothi Bow" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection><selection id="2t5ya6" name="Ylarin, Master of the Paths" entryId="cc10-1dc0-7c18-963a::b02d-7395-6ff0-bca0" number="1" type="model" from="entry"><selections><selection id="2x8s7kd" name="Hunter Weapons" entryId="cc10-1dc0-7c18-963a::1bb6-80bb-4d9b-aa4e" number="1" type="upgrade" from="entry"><profiles><profile id="c78c-23c7-d0bc-4d96" name="Hunter Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="2xtzxsi" name="Champion" entryId="cc10-1dc0-7c18-963a::3b18-3f42-64d2-8f82::9c21-1746-9873-a5b5" entryGroupId="cc10-1dc0-7c18-963a::d51f-d60e-68e5-90f4" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="acaf-8bb6-d6f-3e2a" name="Legends" entryId="acaf-8bb6-d6f-3e2a" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="4926-51d9-e023-1088" name="KURNOTHI" entryId="4926-51d9-e023-1088" primary="false" /><category id="926c-df8c-6841-d49e" name="CAVALRY" entryId="926c-df8c-6841-d49e" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="(No Category)" entryId="(No Category)" name="Uncategorized" primary="true" /></categories></selection><selection id="4zn24fe" name="Alarielle the Everqueen" entryId="959d-ffda-a3a5-db6a::efc2-ef9b-4eee-a341" number="1" type="unit" from="entry"><profiles><profile id="d715-b233-4833-22e7" name="Alarielle the Everqueen" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">14&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">16</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">10</characteristic></characteristics></profile><profile id="135b-afc5-4fd9-3460" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Wardroth Beetle's Antlers** is 4.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="b4bf-ef71-9dfe-e837" name="Metamorphosis" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy unit within 12&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict 2D3 mortal damage on the target. If the target would be destroyed by this spell, before removing any models, pick the closest terrain feature to the target that does not have a friendly **overgrown token** and give it a friendly **overgrown token**. If all terrain features on the battlefield already have a friendly **overgrown token**, inflict D3 mortal damage on each enemy unit within 6&quot; of the target instead.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute></attributes></profile><profile id="e4b4-8e4d-5f0-eb6a" name="Lifebloom" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (2D6)** this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="5abd-6507-dbee-ed76" name="Living Battering Ram" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this turn, pick a visible enemy unit within 1&quot; of it to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="4f7c-2ca1-ae3f-d2d3" name="The Goddess Of Life" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" from="entry"><characteristics><characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Once Per Battle, Your Movement Phase</characteristic><characteristic name="Cost" typeId="a49e-3082-e2a6-e802">2</characteristic><characteristic name="Declare" typeId="b77f-7548-840e-c086">This unit can use this ability even if it has been destroyed.</characteristic><characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Set up a replacement unit with 8 damage points allocated to it (ward rolls cannot be made for those damage points) wholly within the **creeping overgrowth** and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="445d-f443-5448-e7ce"></characteristic></characteristics><attributes><attribute name="Color" typeId="5c69-e4b9-19bc-e801">Gray</attribute><attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute><attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8" /></attributes></profile><profile id="d584-62b7-8083-8f63" name="Seasons Of War" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Start of Battle Round</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You must use this ability.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of the following effects to apply for the rest of the battle round. You cannot pick the effect that you picked in the previous battle round.


***The Burgeoning***: Each time a friendly **Awakened Wyldwood** uses the 'Ever Growing' ability, you can pick any terrain feature your opponent does not control to be the target rather than the closest.

***The Reaping***: Add 1 to casting rolls and chanting rolls for friendly **^^Sylvaneth^^** units while they are wholly within 12&quot; of this unit.


***The Dwindling***: Friendly **^^Sylvaneth^^** units can use **^^Charge^^** abilities even if they used a **^^Retreat^^** ability in the same turn. In addition, no mortal damage is inflicted on those units when they use **^^Retreat^^** abilities.

***Everdusk***: Each time you use the 'Creeping Dread' ability this battle round, you can pick up to 3 targets instead of 1.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="4zoy4y" name="Alarielle the Everqueen" entryId="959d-ffda-a3a5-db6a::deb0-e808-ad4f-e8da" number="1" type="model" from="entry"><selections><selection id="50bkki9" name="Spear of Kurnoth" entryId="959d-ffda-a3a5-db6a::69f1-2edc-803c-9cd1" number="1" type="upgrade" from="entry"><profiles><profile id="91f4-7eb7-ae81-ea0e" name="Spear of Kurnoth" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile><profile id="b9be-23b6-1775-836a" name="Spear of Kurnoth" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">1</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">4</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="51b3pk9" name="Wardroth Beetle's Antlers" entryId="959d-ffda-a3a5-db6a::614c-27e6-7aab-906" number="1" type="upgrade" from="entry"><profiles><profile id="ec1-b3-dc9a-ae3d" name="Wardroth Beetle's Antlers" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">4</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="620" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="c203-51a0-3d44-6b07" name="WARMASTER" entryId="c203-51a0-3d44-6b07" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="8bc-6d63-e37f-9239" name="WIZARD (3)" entryId="8bc-6d63-e37f-9239" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /></categories></selection><selection id="57xwexl" name="Arch-Revenant" entryId="1baa-e7d7-61a1-95f3::c21d-479c-e8ef-b406" number="1" type="unit" from="entry"><profiles><profile id="7e2a-4212-4da4-69d6" name="Arch-Revenant" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="465e-7bf0-f33a-e29" name="Fight And Fly" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Fight^^** ability for this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit charged this turn, this unit can move up to 2D6&quot; after that **^^Fight^^** ability has been resolved. It cannot end that move in combat.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="6dfc-e0b8-16a-f3bb" name="Gossamid Commander" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this turn, pick a visible friendly **Gossamid Archers** unit that is not in combat and is wholly within 18&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The target can immediately use a **^^Shoot^^** ability as if it were your shooting phase but all of the attacks made as part of that **^^Shoot^^** ability must target an enemy unit that is in combat with this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="57slze" name="Arch-Revenant" entryId="1baa-e7d7-61a1-95f3::97cc-f81a-ee31-70cc" number="1" type="model" from="entry"><selections><selection id="5bju5i" name="Arch-Revenant's Glaive" entryId="1baa-e7d7-61a1-95f3::109f-e8f1-4b43-55dd" number="1" type="upgrade" from="entry"><profiles><profile id="e016-1983-6017-3a64" name="Revenant's Glaive and Tail Pincers" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="426b-9a95-d724-377b" name="REVENANT" entryId="426b-9a95-d724-377b" primary="false" /></categories></selection><selection id="5jg5k7k" name="Belthanos, First Thorn of Kurnoth" entryId="b7d-ad95-6f95-638c::f6f4-66ce-c346-42ed" number="1" type="unit" from="entry"><profiles><profile id="4478-aa9b-b7c8-5127" name="Belthanos, First Thorn of Kurnoth" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="61d2-55e1-7873-e100" name="Huntmaster's Strike" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit charged this turn, remove it from the battlefield and set it up again more than 6&quot; from all enemy units and wholly within the **creeping overgrowth**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="59e8-f376-a5df-144c" name="Kurnothi War-horn" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 2&quot; to the Move characteristic of friendly **^^Kurnothi^^** units while they are wholly within 12&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="b29c-dd1a-502d-27c4" name="Rhythm of the Chase" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. On a 2+, inflict an amount of mortal damage on the target equal to the roll, then you can remove this unit from the battlefield and set it up again on the battlefield within 1&quot; of the target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="c6b8-a8fd-b2-59fa" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Carnelian Greatspite's Mandibles** is 3.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="5k5chvc" name="Belthanos, First Thorn of Kurnoth" entryId="b7d-ad95-6f95-638c::38ee-61d7-7a6e-1c4" number="1" type="model" from="entry"><selections><selection id="5ldni9s" name="Carnelian Greatspite's Mandibles" entryId="b7d-ad95-6f95-638c::9e28-fe8e-71d1-7430" number="1" type="upgrade" from="entry"><profiles><profile id="6d05-7590-2cb2-e164" name="Carnelian Greatspite's Mandibles" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="5l0tm84" name="Kurnoth Glaive" entryId="b7d-ad95-6f95-638c::17a3-adc8-e80-bef9" number="1" type="upgrade" from="entry"><profiles><profile id="9cc9-dc9e-e614-83cb" name="Kurnoth Glaive" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="290" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="4926-51d9-e023-1088" name="KURNOTHI" entryId="4926-51d9-e023-1088" primary="false" /></categories></selection><selection id="5s2c6xi" name="Branchwych" entryId="c5f2-a53c-5c0c-736e::e410-e36e-9cea-2482" number="1" type="unit" from="entry"><profiles><profile id="eeef-fc33-9f12-388a" name="Branchwych" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="b66d-c010-9494-b5b4" name="Slay The Trespassers!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit that is within the **creeping overgrowth** or that is visible to this unit and within friendly territory to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Rolla dice. On a 3+, add 1 to wound rolls for combat attacks that target that enemy unit for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="5shqrrhh" name="Branchwych" entryId="c5f2-a53c-5c0c-736e::e509-df5d-719-7156" number="1" type="model" from="entry"><selections><selection id="5xx7el8" name="Greenwood Scythe and Bittergrub" entryId="c5f2-a53c-5c0c-736e::310d-4b4-533f-e5ce" number="1" type="upgrade" from="entry"><profiles><profile id="5012-d9ce-73f5-851b" name="Greenwood Scythe and Bittergrub" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /></categories></selection><selection id="653cb2a" name="Drycha Hamadreth" entryId="2ed4-4df2-66bd-ac07::b3b6-f91d-754d-af73" number="1" type="unit" from="entry"><profiles><profile id="8045-7110-5683-4141" name="Drycha Hamadreth" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="a1f-39fd-6570-f3d5" name="Terror Of The Deep Woods" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Enemy units cannot use **^^Run^^** or **^^Retreat^^** abilities while they are within 9&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="a924-fd6e-9278-4d4c" name="Enrage The Spites" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick up to 3 enemy units that are visible to and within 12&quot; of this unit or that are within the **creeping overgrowth** to be the targets, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict D3 mortal damage on each target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile><profile id="77b2-7e2-ba0c-83a1" name="Merciless Ambush" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" from="entry"><characteristics><characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Your Charge Phase</characteristic><characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic><characteristic name="Declare" typeId="b77f-7548-840e-c086">If this unit is not in combat and has not used a **^^Run^^** or **^^Retreat^^** ability this turn, make a charge roll of 2D6.</characteristic><characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">You can remove this unit from the battlefield and set it up again within 1/2&quot; of an enemy unit and wholly within **X**&quot; of a terrain feature that has a friendly **overgrown token**, where **X** is equal to the charge roll. If you do so, this unit has charged.</characteristic><characteristic name="Keywords" typeId="445d-f443-5448-e7ce">**^^Core^^**, **^^Move^^**, **^^Charge^^**, **^^Rampage^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="65vqe8d" name="Drycha Hamadreth" entryId="2ed4-4df2-66bd-ac07::da0d-185d-45c2-29e0" number="1" type="model" from="entry"><selections><selection id="66zue9r" name="Slashing Talons" entryId="2ed4-4df2-66bd-ac07::cf4d-7df7-ee1-dd98" number="1" type="upgrade" from="entry"><profiles><profile id="b70d-834e-d030-307b" name="Slashing Talons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (2 Hits)</characteristic></characteristics></profile></profiles></selection><selection id="66oafwm" name="Swarm of Spites" entryId="2ed4-4df2-66bd-ac07::f27c-2442-f71d-a3c3" number="1" type="upgrade" from="entry"><profiles><profile id="a01c-650-e28-739d" name="Swarm of Spites" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">20</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73"></characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal), Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="250" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="e467-244c-3711-033d" name="FOREST ELDER" entryId="e467-244c-3711-033d" primary="false" /></categories></selection><selection id="6dveglj" name="Grove Guardian" entryId="9b36-ece3-224a-b78a::1902-0dee-b6d1-0f58" number="1" type="unit" from="entry"><profiles><profile id="310b-a65c-0553-e2be" name="Grove Guardian" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="59a8-f26c-1cfe-79dc" name="Soulshriek" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each friendly non-Hero Revenant unit wholly within 12&quot; of and visible to this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the phase, each time a model in a target unit is slain by a combat attack, roll a dice. On a 5+, inflict 1 mortal damage on the attacking unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="4b21-6a1c-2faf-d1a3" name="Regenesis" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth^^** unit that is wholly within the **creeping overgrowth** or that is visible to and wholly within 12&quot; of this unit to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 6+, you can pick another eligible unit to be a second target. If a target is a non-**^^Hero Revenant Infantry^^** or **Dryads** unit, return up to D3 models to the target unit. Otherwise, **Heal (3)** that target</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="6eab67p" name="Grove Guardian" entryId="9b36-ece3-224a-b78a::5083-3349-59b9-0482" number="1" type="model" from="entry"><selections><selection id="6i2eqvt" name="Grove Sickle or Shears" entryId="9b36-ece3-224a-b78a::ab7a-4471-97b6-5dfc" number="1" type="upgrade" from="entry"><profiles><profile id="4b48-0c89-9d33-74df" name="Grove Sickle or Shears" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="6jeu31h" name="Guardian Spites" entryId="9b36-ece3-224a-b78a::8a45-1279-1905-eabc" number="1" type="upgrade" from="entry"><profiles><profile id="598f-02c5-0af4-c833" name="Guardian Spites" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal), Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="220" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="e467-244c-3711-033d" name="FOREST ELDER" entryId="e467-244c-3711-033d" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="e692-853d-6db8-fdbe" name="PRIEST (2)" entryId="e692-853d-6db8-fdbe" primary="false" /></categories></selection><selection id="6wdkld" name="Spirit of Durthu" entryId="1ba3-5bf-df0-e4ae::f163-eaf6-2b5b-1cd3" number="1" type="unit" from="entry"><profiles><profile id="9fee-eb48-e933-fd5a" name="Spirit of Durthu" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="7124-769a-aafd-7b38" name="Groundshaker" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy non-**^^Fly Infantry^^** or **^^Cavalry^^** unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice, On a 3+, the target has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="2eb1-9bd5-1544-36d9" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Guardian Sword** is 3.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ea9f-5c5b-8b97-78aa" name="Guardian Of The Glades" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: You declared a **^^Charge^^** ability for this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 2 to the charge roll but this unit must end that charge move within 1/2&quot; of an enemy unit that is in combat with another friendly **^^Sylvaneth Hero^^**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="6xl1tus" name="Spirit of Durthu" entryId="1ba3-5bf-df0-e4ae::b00c-c2a4-7b61-6849" number="1" type="model" from="entry"><selections><selection id="71g26cg" name="Guardian Sword" entryId="1ba3-5bf-df0-e4ae::eea5-bbfe-22f5-b571" number="1" type="upgrade" from="entry"><profiles><profile id="7b2-d7da-241d-b0a1" name="Guardian Sword" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">4</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Monster^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="7106h2w" name="Massive Impaling Talons" entryId="1ba3-5bf-df0-e4ae::e5a3-bd6-b467-b1fc" number="1" type="upgrade" from="entry"><profiles><profile id="5297-aa69-ccfa-3e38" name="Massive Impaling Talons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="71c1ccm" name="Verdant Blast" entryId="1ba3-5bf-df0-e4ae::c0be-9c33-4dde-a4" number="1" type="upgrade" from="entry"><profiles><profile id="652d-ae9f-589f-6077" name="Verdant Blast" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">5</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="320" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="e467-244c-3711-033d" name="FOREST ELDER" entryId="e467-244c-3711-033d" primary="false" /></categories></selection><selection id="7aw97yx" name="The Lady of Vines" entryId="8eb8-a788-e726-2be0::72e5-d623-ac8c-14a1" number="1" type="unit" from="entry"><profiles><profile id="a8fa-fe37-1a09-589" name="The Lady of Vines" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">10</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="43d-79ea-b852-4898" name="Verdian Crown" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a terrain feature within 18&quot; of this unit that does not have a friendly **overgrown token** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Give the target a friendly **overgrown token**</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="b3f2-fbf6-5483-7d40" name="Protection Of The Everqueen" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Make a casting roll of 2D6. Add 1 to the roll if this unit is wholly within the **creeping overgrowth**.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, friendly **^^Sylvaneth^^** units have **^^Ward (5+)^^** while they are wholly within 12&quot; of this unit.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute></attributes></profile><profile id="95a7-7f72-7aee-d38c" name="Hands Of The Everqueen" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a terrain feature within 18&quot; of this unit that has a friendly **overgrown token** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The next time this unit uses a non-Summon Spell ability this phase, when picking targets for that spell, you can measure range and visibility from the target terrain feature instead of from this unit, and your opponent can measure range and visibility to the target terrain feature instead of to this unit for the purposes of the 'Unbind' ability.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="7a3vxab" name="The Lady of Vines" entryId="8eb8-a788-e726-2be0::601c-ee53-9828-e8f2" number="1" type="model" from="entry"><selections><selection id="7b8nu8" name="Kurnotheal's Wrath" entryId="8eb8-a788-e726-2be0::4d29-a0f4-aff1-3847" number="1" type="upgrade" from="entry"><profiles><profile id="c5ae-8c5c-ec9f-16f4" name="Kurnotheal's Wrath" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">1</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D6</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="7c9dia" name="Kurnotheal's Wrath and Lashing Vines" entryId="8eb8-a788-e726-2be0::3516-c34-3df4-cd4d" number="1" type="upgrade" from="entry"><profiles><profile id="6cda-937a-25fe-ce88" name="Kurnotheal's Wrath and Lashing Vines" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="280" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="e467-244c-3711-033d" name="FOREST ELDER" entryId="e467-244c-3711-033d" primary="false" /></categories></selection><selection id="7i374ed" name="Treelord Ancient" entryId="21f4-fbfa-6e85-1c5b::678-a231-5f4c-4d7c" number="1" type="unit" from="entry"><profiles><profile id="3428-39ab-2c34-d035" name="Treelord Ancient" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="e098-e999-62c9-9fdb" name="Eldest Of Elders" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each friendly **^^Forest Elder^^** within this unit's combat range to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice for each target, On a 3+, add 1 to hit rolls for that target's combat attack until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="5146-6142-ca4d-8e" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Sweeping Blows** is 3.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3cca-f963-57d-c0a8" name="Awaken Slumbering Spirits" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible terrain feature that has a friendly **overgrown token** and is within 12&quot; of this unit. Then, pick a friendly non-**^^Unique Kurnothi^^** or **^^Treelord^^** unit that has been destroyed to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up a replacement unit with 1 model from the target unit wholly within 6&quot; of that terrain feature and more than 9&quot; from all enemy units. Then, remove the friendly **overgrown token** from that terrain feature. If the target was a **Treelord**, allocate 10 damage points to the replacement unit (ward rolls cannot be made for those damage points).</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="7jywg36" name="Treelord Ancient" entryId="21f4-fbfa-6e85-1c5b::b38a-de96-86d1-59ae" number="1" type="model" from="entry"><selections><selection id="7njm8qa" name="Doom Tendril Staff" entryId="21f4-fbfa-6e85-1c5b::b261-5d49-b10a-ddb5" number="1" type="upgrade" from="entry"><profiles><profile id="acfd-f371-fef0-d7b2" name="Doom Tendril Staff" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">4</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="7o3bpa" name="Massive Impaling Talons" entryId="21f4-fbfa-6e85-1c5b::8309-9d64-7280-49c0" number="1" type="upgrade" from="entry"><profiles><profile id="3d36-2c1e-bd07-d9d0" name="Massive Impaling Talons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="7ngse1" name="Sweeping Blows" entryId="21f4-fbfa-6e85-1c5b::b88a-a2a9-7e36-96bf" number="1" type="upgrade" from="entry"><profiles><profile id="92e6-5d09-3860-7d4" name="Sweeping Blows" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-charge (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="280" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="e467-244c-3711-033d" name="FOREST ELDER" entryId="e467-244c-3711-033d" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /></categories></selection><selection id="7xy0nbe" name="Treelord Ancient (Scourge of Aqshy)" entryId="a3ab-de00-26ff-9dbe::9ea2-174b-8d35-0f18" number="1" type="unit" from="entry"><profiles><profile id="efd7-e3fe-d883-d2bf" name="Treelord Ancient" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="785b-fba3-5f14-325b" name="Jade Abjuration" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick this unit or a visible friendly **Awakened Wyldwood** wholly within 12&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn:
• Ignore the effects of enemy **^^Spell^^** abilities on units (friendly and enemy) while they are within 6&quot; of the target.
• Weapons used by enemy **^^Manifestations^^** have a maximum Attacks characteristic of 1 while they are within 6&quot; of the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile><profile id="7976-8eb8-5085-9928" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Sweeping Blows** is 3.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="36d9-3025-a8eb-ff1f" name="Arcane Osmosis" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn:
• Each time you make a casting roll for this unit, add D3 to the roll.
• This unit cannot move or be removed from the battlefield by an ability that would allow it to be set up elsewhere on the battlefield or in reserve.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="7x8qi9h" name="Treelord Ancient" entryId="a3ab-de00-26ff-9dbe::2647-6ed0-115c-4cf9" number="1" type="model" from="entry"><selections><selection id="826w5x" name="Doom Tendril Staff" entryId="a3ab-de00-26ff-9dbe::161a-85a7-3fcb-4aaa" number="1" type="upgrade" from="entry"><profiles><profile id="a530-0bd5-209e-9f37" name="Doom Tendril Staff" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">4</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="827t6nf" name="Massive Impaling Talons" entryId="a3ab-de00-26ff-9dbe::0ad5-84d7-66d9-479c" number="1" type="upgrade" from="entry"><profiles><profile id="50e6-7fd9-e650-f70b" name="Massive Impaling Talons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="822nlko" name="Sweeping Blows" entryId="a3ab-de00-26ff-9dbe::72d2-e2f4-dfa4-842c" number="1" type="upgrade" from="entry"><profiles><profile id="575f-3fb4-e461-35ba" name="Sweeping Blows" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-charge (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="290" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="e467-244c-3711-033d" name="FOREST ELDER" entryId="e467-244c-3711-033d" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /></categories></selection><selection id="8i0xndi" name="Warsong Revenant" entryId="3028-82cb-fce4-4cf9::438e-768a-7545-d329" number="1" type="unit" from="entry"><profiles><profile id="928c-c29-344f-e72" name="Warsong Revenant" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="dc61-1f39-51f9-52da" name="Wyldwood Revenants" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: You made an unmodified chanting roll of 1 for a **^^Sylvaneth Priest**^^ wholy within 12&quot; of this unit.</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Re-roll that chanting roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3f73-3ee4-8f6b-b16b" name="Alarielle's Song" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Friendly **^^Sylvaneth^^** units have **^^Ward (6+)^^** while they are wholly within 12&quot; of this unit. Subtract 1 from ward rolls for enemy units while they are within 12&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="8i3f4y" name="Warsong Revenant" entryId="3028-82cb-fce4-4cf9::57c4-8153-f518-db5d" number="1" type="model" from="entry"><selections><selection id="8n0vvi" name="Spirit Falchion and Spearing Vines" entryId="3028-82cb-fce4-4cf9::8a1d-e1bd-ccd3-c015" number="1" type="upgrade" from="entry"><profiles><profile id="1d0e-7094-cd9b-2aa2" name=" Spirit Falchion and Spearing Vines" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="170" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="3fe-84f4-cec6-a1c1" name="PRIEST (1)" entryId="3fe-84f4-cec6-a1c1" primary="false" /><category id="426b-9a95-d724-377b" name="REVENANT" entryId="426b-9a95-d724-377b" primary="false" /></categories></selection><selection id="8wl9j7" name="Dryads" entryId="4573-37fd-3918-7419::ccce-ab0c-7c1-bbc2" number="1" type="unit" from="entry"><profiles><profile id="7084-e05d-efa4-bb90" name="Dryads" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">1</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="f62f-75b0-48cd-101e" name="One With The Forest" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract 1 from hit rolls and wound rolls for attacks that target this unit while it is wholly within the **creeping overgrowth**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="8zgt2p" name="Dryad" entryId="4573-37fd-3918-7419::d629-3b59-8262-69e" number="1" type="model" from="entry"><selections><selection id="90dp4c" name="Wracking Talons" entryId="4573-37fd-3918-7419::23a2-f17d-df6e-d41b" number="1" type="upgrade" from="entry"><profiles><profile id="6df7-fb28-5daf-d861" name="Wracking Talons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="901baw3" name="Champion" entryId="4573-37fd-3918-7419::83e8-d03-f79-ba0b::9c21-1746-9873-a5b5" entryGroupId="4573-37fd-3918-7419::51ed-232a-a3f8-4099" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="92ehhwm" name="Dryad" entryId="4573-37fd-3918-7419::d629-3b59-8262-69e" number="9" type="model" from="entry"><selections><selection id="923bosi" name="Wracking Talons" entryId="4573-37fd-3918-7419::23a2-f17d-df6e-d41b" number="9" type="upgrade" from="entry"><profiles><profile id="6df7-fb28-5daf-d861" name="Wracking Talons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="9190-23b-eab9-9904" name="SYLVANETH" entryId="9190-23b-eab9-9904" primary="false" /></categories></selection><selection id="9bdujcl" name="Gossamid Archers" entryId="5d21-41ae-45c5-7c8f::7395-623b-7652-b8c6" number="1" type="unit" from="entry"><profiles><profile id="1100-d7c3-3168-ac1a" name="Gossamid Archers" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="cef9-71fd-e86b-d0cc" name="Forest Fighters" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit has a coherency range of 2&quot;.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="6a6c-3a09-92e2-5df3" name="Zephyrspites" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Shoot^^** ability for this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">After that **^^Shoot^^** ability has been resolved, this unit can move up to D6&quot;. It cannot move into combat during any part of that move.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="9dnxiuq" name="Gossamid Archer" entryId="5d21-41ae-45c5-7c8f::4a88-ec2c-f12-2a04" number="1" type="model" from