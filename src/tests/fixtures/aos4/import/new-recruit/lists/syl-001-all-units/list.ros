hari" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit's **Ylthari** is on the battlefield, it has **^^Wizard (1)^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="a840-8d30-6631-0323" name="Bitterness of the Soul" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Damage characteristic of this unit's **Enchanted Glade Weapons** for each model in this unit that is slain.
*Designer's Note: Models that have been slain and returned to this unit do not count as being slain for the purposes of this ability.*</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="5ix9b5" name="Ahnslaine" entryId="b390-d2d7-f68e-dc3b::5667-d54d-a81c-19e7" number="1" type="model" from="entry"><selections><selection id="5j14o8e" name="Revenant Bow" entryId="b390-d2d7-f68e-dc3b::75d3-055f-1ba6-65e2" number="1" type="upgrade" from="entry"><profiles><profile id="d800-3638-b6ef-d12e" name="Revenant Bow" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">1</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile><profile id="69c5-1077-3f31-f465" name="Revenant Bow" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-74