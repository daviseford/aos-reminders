6f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="6fbe-55ef-18b2-5475" name="Slicing Fervour" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit has **^^Strike-first^^** while it is in combat with a **blissmarked** unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="9d14-5d8d-2f31-327a" name="Blissbarb Shafts" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit's **Hadzu** is on the battlefield, pick a visible enemy unit within 18&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 4+:
• Inflict 1 mortal damage on the target.
• The target is **blissmarked** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Shoot^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="tka2j9" name="Glissete" entryId="5533-be52-138f-a583::554c-defa-d756-26c2" number="1" type="model" from="entry"><selections><selection id="tlx5gzh" name="Weapons of Excess" entryId="5533-be52-138f-a583::3084-2ebc-35ba-e31d" number="1" type="upgrade" from="entry"><profiles><profile id="f5b5-e597-d3ac-42c4" name="Weapons of Excess" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection><selection id="tk6jfag" name="Hadzu" entryId="5533-be52-138f-a583::dd74-dd5f-810e-78fa" number="1" type="model" from="entry"><selections><selection id="tmngxg8" name="Weapons of Excess" entryId="5533-be52-138f-a583::dd55-dbca-5b8d-abdc" number="1" type="upgrade" from="entry"><profiles><profile id="b0f5-6847-4888-bc28" name="Weapons of Excess" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteri