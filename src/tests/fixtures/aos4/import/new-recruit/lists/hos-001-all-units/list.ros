>4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="vd4nl7j" name="Champion" entryId="86ef-7afc-8a53-73d5::a0-3786-8119-de2b::9c21-1746-9873-a5b5" entryGroupId="86ef-7afc-8a53-73d5::b07e-6d7a-a130-c4a5" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="vegh1ei" name="Blissbarb Seeker" entryId="86ef-7afc-8a53-73d5::8d09-3adf-8204-fd86" number="4" type="model" from="entry"><selections><selection id="ve878mr" name="Exalted Steed's Poisoned Tongue" entryId="86ef-7afc-8a53-73d5::280-d0db-f110-a3ae" number="4" type="upgrade" from="entry"><profiles><profile id="e63f-a376-b06e-95f5" name="Exalted Steed's Poisoned Tongue" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><chara