ibutes></profile></profiles><selections><selection id="buvx2na" name="Glaivewraith Stalker" entryId="4489-e8a7-ddcb-2e42::3bc0-2404-7cfd-a900" number="1" type="model" from="entry"><selections><selection id="bvqb76p" name="Hunter's Glaive" entryId="4489-e8a7-ddcb-2e42::35a9-4907-ed70-2ff9" number="1" type="upgrade" from="entry"><profiles><profile id="51cb-30d3-da50-153c" name="Hunter's Glaive" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage), Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="bvq9t3a" name="Musician" entryId="4489-e8a7-ddcb-2e42::3f8d-1689-d3a3-d66a::2475-183b-3802-4431" entryGroupId="4489-e8a7-ddcb-2e42::2a15-bdf8-505d-2462" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="ef81-53a1-5559-5aa1" name="Musician" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any musicians, if it uses the 'Rally' command, you can make one additional rally roll of D6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f