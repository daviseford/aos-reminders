e (+1 Damage), Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="k5fx72" name="Champion" entryId="134b-dda7-eda7-4b9a::7a0d-3330-bbbb-feae::9c21-1746-9873-a5b5" entryGroupId="134b-dda7-eda7-4b9a::367e-4f18-f448-9a38" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="k6vrx97" name="Hexwraith" entryId="134b-dda7-eda7-4b9a::b278-49e5-9d6f-8724" number="4" type="model" from="entry"><selections><selection id="k6rgq5j" name="Ethereal Steed's Ghostly Hooves and Teeth" entryId="134b-dda7-eda7-4b9a::c8da-cd3a-aa3a-2205" number="4" type="upgrade" from="entry"><profiles><profile id="8b0d-be41-df8b-d7e6" name="Ethereal Steed's Ghostly Hooves and Teeth" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc