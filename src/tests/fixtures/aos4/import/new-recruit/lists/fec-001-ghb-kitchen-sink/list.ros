/characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any musicians, if it uses the 'Rally' command, you can make one additional rally roll of D6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="ldzv04u" name="Cryptguard" entryId="2a5f-2c47-e025-8840::b563-29c4-3aa0-f369" number="1" type="model" from="entry"><selections><selection id="ldndhri" name="Cursed Weapon" entryId="2a5f-2c47-e025-8840::7c56-f8fe-b3c-c783" number="1" type="upgrade" from="entry"><profiles><profile id="aa43-7153-228d-b5ec" name="Cursed Weapon" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-charge (+1 Rend), Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="lek4d75" name="Standard Bearer" entryId="2a5f-2c47-e025-8840::1300-9f7a-1702-db4d::7f34-77c9-597-62c3" entryGroupId="2a5f-2c47-e025-8840::55a8-774-75fd-e0bd" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="1ec9-5b34-74df-6e40" name="Standard Bearer" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="