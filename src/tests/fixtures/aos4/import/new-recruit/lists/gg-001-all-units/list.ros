-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="70" /></costs><categories><category id="926c-df8c-6841-d49e" entryId="926c-df8c-6841-d49e" name="CAVALRY" primary="true" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ce45-cc36-d92e-ef70" name="GLOOMSPITE GITZ" entryId="ce45-cc36-d92e-ef70" primary="false" /><category id="de6e-e2-38c2-833d" name="GITMOB" entryId="de6e-e2-38c2-833d" primary="false" /></categories></selection><selection id="xe3ndq8" name="Squig Herd" entryId="ed61-519d-ae1e-d190::5e58-eff2-c9a6-7227" number="1" type="unit" from="entry"><profiles><profile id="4df2-2539-f1e8-1b2e" name="Squig Herd" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">D6+3&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">1</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="26a7-e7eb-b479-661c" name="Squigs Gone Wild" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a model in this unit is slain by a combat attack and that model was in combat with the attacking unit, roll a dice. On a 5+, inflict 1 mortal damage on the attacking unit after the **^^Fight^^** ability has been resolved.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="1091-822d-626b-4eaf" name="Herding Squigs" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice for each **Squig Herder** in this unit. For each 2+, you can return D3 slain **Cave Squigs** to this unit. For each 1, 1 **Squig Herder** in this unit is slain.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c681-8a44-8f44" name="Beast" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit has a maximum control score of 1.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="xhy08he" name="Cave Squig" entryId="ed61-519d-ae1e-d190::993c-6b16-e975-5321" number="10" type="model" from