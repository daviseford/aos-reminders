mber="1" type="unit" from="entry"><profiles><profile id="8d11-dcf7-96c8-a241" name="Borgit's Beastgrabbaz" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="b54a-9145-9baf-d3e7" name="Borgit's Masterplan" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit can only use this ability if any models in this unit have been slain.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn:
• This unit has **^^Strike-first^^**
• Double the Attacks characteristic of this unit's melee weapons.
• This unit's attacks must target an enemy **^^Monster^^** or **^^Beast^^**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="2525-d7ae-7172-4405" name="Uglug the Troggoth" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit includes **Uglug**, ignore the first damage point allocated to it each phase.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="kz7l2gn" name="Borgit Wolf-Killa" entryId="48e2-d42e-6252-bd51::c77e-f752-5193-2236" number="1" type="model" from="entry"><selections><selection id="l0m9e2c" name="Borgit's Stabba" entryId="48e2-d42e-6252-bd51::dc81-45bb-a587-6dae" number="1" type="upgrade" from="entry"><profiles><profile id="6821-1f8e-0062-2ab0" name="Borgit's Stabba" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Beast^^** (+1 Rend), Anti-**^^Monster^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="l0fthbm" name="Champion" entryId="48e2-d42e-6252-bd51::15b4-4600-fb76-486a::9c21-1746-9873-a5b5" entryGroupId="48e2-d42e-6252-bd51::de70-af8a-1283-9009" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="l1kpg3o" name="Hobblin' Dregg" entryId="48e2-d42e-6252-bd51::766d-f087-6ae7-db19" number="1" type="model" from="entry"><selections><selection id="l1bkv3e" name="Beastgrabba Weapons" entryId="48e2-d42e-6252-bd51::fc0d-8e20-2403-f5fa" number="1" type="upgrade" from="entry"><profiles><profile id="9ec4-18a5-6715-ef99" name="Beastgrabba Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-