MSPITE GITZ" entryId="ce45-cc36-d92e-ef70" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="76e8-7818-115c-6899" name="MOONCLAN" entryId="76e8-7818-115c-6899" primary="false" /><category id="836d-96c5-f628-0692" name="Moonclan Infantry" entryId="836d-96c5-f628-0692" primary="false" /></categories></selection><selection id="leuuh17" name="Fellwater Troggoths" entryId="1c52-ddce-55f9-c7a2::3f7c-ecc-b9dc-ccda" number="1" type="unit" from="entry"><profiles><profile id="e719-fdbb-cdce-239f" name="Fellwater Troggoths" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="b74b-327c-9566-3a77" name="Noxious Vomit" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If any damage points are allocated to an enemy unit by attacks made with this unit's **Noxious Vomit**, that unit is **drenched in vomit** until the start of your next turn.
While a unit is **drenched in vomit**:
• Subtract 1 from save rolls for that unit.
• Ignore positive modifiers to save rolls for that unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="22b8-e72c-597b-bc4d" name="Regeneration" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Start of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="li9siwp" name="Fellwater Troggoth" entryId="1c52-ddce-55f9-c7a2::e724-67bc-2aa7-cb05" number="3" type="model" from="entry"><selections><selection id="livnszn" name="Noxious Vomit" entryId="1c52-ddce-55f9-c7a2::b9f5-dbca-b12f-87ca" number="3" type="upgrade" from="entry"><profiles><profile id="a67a-6ef2-75f6-3585" name="Noxious Vomit" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">6&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">D3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="liag62j" name="Spiked Club" entryId="1c52-ddce-55f9-c7a2::55c0-da42-b7ee-2879" number="3" type="upgrade" from="entry"><profiles><profile id="b9c-4194-38a9-3580" name="Spiked Club" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="160" /></costs><categories><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ce45-cc36-d92e-ef70" name="GLOOMSPITE GITZ" entryId="ce45-cc36-d92e-ef70" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="c824-f471-3b8c-e580" name="TROGGOTH" entryId="c824-f471-3b8c-e580" primary="false" /></categories></selection><selection id="lsy01ln" name="Fellwater Troggoths (Scourge of Aqshy)" entryId="8517-ddbb-e340-b25e::6132-f299-106b-97e0" number="1" type="unit" from="entry"><profiles><profile id="824c-fb7d-6f5b-f737" name="Fellwater Troggoths" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="e5df-3c0a-1689-53a1" name="Gut-Wrenching Stench" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. You can spend up to 3 **rage dice**. If you do:
• Add X to the roll, where X is the number of **rage dice** spent.
• If your opponent's **fury level** is lower than yours, they must increase their **fury level** by 1, to a maximum of 7.
Then, on a 5+, the target has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="4999-9448-1e8e-fdcd" name="Regeneration" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Start of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="lv0tj3w" name="Fellwater Troggoth" entryId="8517-ddbb-e340-b25e::56b8-85cc-2b62-5c91" number="3" type="model" from="entry"><selections><selection id="lv5gff" name="Noxious Vomit" entryId="8517-ddbb-e340-b25e::27b6-4b63-162e-3f3d" number="3" type="upgrade" from="entry"><profiles><profile id="add5-0105-81e6-4d5c" name="Noxious Vomit" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">6&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">D3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="lv27ymt" name="Spiked Club" entryId="8517-ddbb-e340-b25e::cc05-4ee0-9ce7-6db5" number="3" type="upgrade" from="entry"><profiles><profile id="5a06-ac49-fcc3-ebe1" name="Spiked Club" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="180" /></costs><categories><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ce45-cc36-d92e-ef70" name="GLOOMSPITE GITZ" entryId="ce45-cc36-d92e-ef70" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="c824-f471-3b8c-e580" name="TROGGOTH" entryId="c824-f471-3b8c-e580" primary="false" /></categories></selection><selection id="m7q3wrn" name="Gobbapalooza" entryId="1e-76bb-2ac4-5ab6::a04f-574e-e278-ea32" number="1" type="unit" from="entry"><profiles><profile id="3a70-4bfa-a5c9-4ef8" name="Gobbapalooza" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">3</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="5d81-dd1b-f235-515f" name="Hallucinogenic Fungus Brews" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In the first battle round, this unit has **^^Ward (4+)^^**. In the second battle round, this unit has **^^Ward (5+)^^**. In the third and subsequent battle rounds, this unit has **^^Ward (6+)^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="f322-8b2-9674-d56e" name="Gobbapalooza Know-wotz" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, pick 1 of the following effects:
***Glareface Dance:*** Pick a friendly **^^Gloomspite Gitz^^** unit within this unit's combat range. Add 1 to run rolls and charge rolls for that unit until the start of your next turn.
***Nasty Poisons:*** Pick a friendly **^^Gloomspite Gitz^^** unit within this unit's combat range. Add 1 to the Rend characteristic of that unit's weapons until the start of your next turn.
***Mesmerise:*** Pick a visible enemy unit within 12&quot; of this unit. Until the start of your next turn, that unit cannot use commands.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="m9xowr" name="Gobbapalooza" entryId="1e-76bb-2ac4-5ab6::2986-3d85-202f-5d5d" number="5" type="model" from="entry"><selections><selection id="m9orj75" name="Staff, Stikka or Jaggedy Blade" entryId="1e-76bb-2ac4-5ab6::1c20-65bd-b785-3a4c" number="5" type="upgrade" from="entry"><profiles><profile id="90f9-1b7-d1ff-abde" name="Staff, Stikka or Jaggedy Blade" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">1</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="150" /></costs><categories><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ce45-cc36-d92e-ef70" name="GLOOMSPITE GITZ" entryId="ce45-cc36-d92e-ef70" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="76e8-7818-115c-6899" name="MOONCLAN" entryId="76e8-7818-115c-6899" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="836d-96c5-f628-0692" name="Moonclan Infantry" entryId="836d-96c5-f628-0692" primary="false" /></categories></selection><selection id="mle4hbj" name="Grinkrak's Looncourt" entryId="d1f3-95b6-505a-c3b9::07da-8a50-69be-b0c1" number="1" type="unit" from="entry"><profiles><profile id="aa57-cd45-f0bf-0945" name="Grinkrak's Looncourt" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="a62f-0bf0-ac07-b8de" name="Quest's End" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Start of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit can only use this ability if you control the object of this unit's quest and this unit is contesting it.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle, this unit has **^^Strike-first^^** and **^^Ward (4+)^^**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="a7d9-6958-1d44-a75d" name