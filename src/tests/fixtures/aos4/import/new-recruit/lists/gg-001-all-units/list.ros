dden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While a friendly **Snarlboss** is within this unit's combat range, both this unit and that **Snarlboss** have **^^Ward (5+)^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="wq0dq7j" name="Wolfgit Retinue" entryId="a563-a1fd-e05e-0619::1e61-ac78-eed7-6230" number="1" type="model" from="entry"><selections><selection id="wrqhlg" name="Grot Bow" entryId="a563-a1fd-e05e-0619::07d2-9aa5-18c3-9762" number="1" type="upgrade" from="entry"><profiles><profile id="7e2b-89cb-af16-e5af" name="Grot Bow" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">15&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">5+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">-</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="wrv8lj8" name="Snarlfang's Slavering Jaws" entryId="a563-a1fd-e05e-0619::5005-f542-5aae-9da3" number="1" type="upgrade" from="entry"><profiles><profile id="e01b-128e-c280-6517" name="Snarlfang's Slavering Jaws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics>