12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="omu4xxq" name="Moonclan Stabbas" entryId="1f57-2750-d197-7412::32c2-fbcc-235c-1298" number="1" type="model" from="entry"><selections><selection id="om985n" name="Stabba" entryId="1f57-2750-d197-7412::4e45-fedd-b586-44d" number="1" type="upgrade" from="entry"><profiles><profile id="e7c9-2160-669f-9d06" name="Stabba" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="onwadig" name="Musician" entryId="1f57-2750-d197-7412::c56d-cfaf-fdbd-3675::2475-183b-3802-4431" entryGroupId="1f57-2750-d197-7412::8943-f03f-3669-6d58" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="ef81-53a1-5559-5aa1" name="Musician" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any musicians, if it uses the 'Rally' command, you can make one additional rally roll of D6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="oo3mfk4" name="Moonclan Stabbas" entryId="1f57-2750-d197-7412::32c2-fbcc-235c-1298" number="1" type="model" from="entry"><selections><selection id="oo65hb" name="Stabba" entryId="1f57-2750-d197-7412::4e45-fedd-b586-44d" number="1" type="upgrade" from="entry"><profiles><profile id="e7c9-2160-669f-9d06" name="Stabba" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="ooakibl" name="Standard Bearer" entryId="1f57-2750-d197-7412::461e-9906-e46e-a6c5::7f34-77c9-597-62c3" entryGroupId="1f57-2750-d197-7412::8943-f03f-3669-6d58" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="1ec9-5b34-74df-6e40" name="Standard Bearer" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any standard bearers, add 1 to this unit's control score.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="osrflqq" name="Moonclan Stabbas" entryId="1f57-2750-d197-7412::32c2-fbcc-235c-1298" number="17" type="model" from="entry"><selections><selection id="os0wu4" name="Stabba" entryId="1f57-2750-d197-7412::4e45-fedd-b586-44d" number="17" type="upgrade" from="entry"><profiles><profile id="e7c9-2160-669f-9d06" name="Stabba" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ce45-cc36-d92e-ef70" name="GLOOMSPITE GITZ" entryId="ce45-cc36-d92e-ef70" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="76e8-7818-115c-6899" name="MOONCLAN" entryId="76e8-7818-115c-6899" primary="false" /><category id="21e3-b423-1543-7fad" name="MUSICIAN (1/20)" entryId="21e3-b423-1543-7fad" primary="false" /><category id="4eea-935a-1af-1f4" name="STANDARD BEARER (1/20)" entryId="4eea-935a-1af-1f4" primary="false" /><category id="836d-96c5-f628-0692" name="Moonclan Infantry" entryId="836d-96c5-f628-0692" primary="false" /></categories></selection><selection id="p6b3c4s" name="Rockgut Troggoths" entryId="5381-43bb-55b8-8ef0::6b55-8302-d5fe-f8b" number="1" type="unit" from="entry"><profiles><profile id="e414-dd5c-558f-aae9" name="Rockgut Troggoths" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="2e5-c6b1-d5ee-7c7" name="Regeneration" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Start of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="p8y4dsc" name="Rockgut Troggoth" entryId="5381-43bb-55b8-8ef0::202d-8ca9-de33-7cfa" number="3" type="model" from="entry"><selections><selection id="p94ims" name="Stone Maul or Craggy Hands" entryId="5381-43bb-55b8-8ef0::4a2b-9bc2-d3d6-361" number="3" type="upgrade" from="entry"><profiles><profile id="2b23-c6dc-b760-9388" name="Stone Maul or Craggy Hands" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="p9hv492" name="Throwin' Boulders" entryId="5381-43bb-55b8-8ef0::a60c-6e8b-d4da-54e1" number="3" type="upgrade" from="entry"><profiles><profile id="8c1e-8ab7-1ef5-29a1" name="Throwin' Boulders" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">1</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">5+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="170" /></costs><categories><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ce45-cc36-d92e-ef70" name="GLOOMSPITE GITZ" entryId="ce45-cc36-d92e-ef70" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="c824-f471-3b8c-e580" name="TROGGOTH" entryId="c824-f471-3b8c-e580" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /></categories></selection><selection id="pn2ycrc" name="Sneaky Snufflers" entryId="9e8f-650c-7daf-7cda::3b3c-9e13-1ddc-7f74" number="1" type="unit" from="entry"><profiles><profile id="67b9-e7-96af-9779" name="Sneaky Snufflers" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="4875-8230-2a39-f9ec" name="Looncap Mushrooms" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit is not in combat, pick a friendly **^^Moonclan^^** unit wholly within 12&quot; of it to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if the face of the Bad Moon is **Cacklin'** this turn. On a 3+, the target has **^^Ward (5+)^^** until the start of your next turn. On a 6+, also add 1 to the Attacks characteristic of the target's melee weapons until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="ppsxwb" name="Sneaky Snuffler" entryId="9e8f-650c-7daf-7cda::2e6d-6ef8-72e8-4a2e" number="6" type="model" from="entry"><selections><selection id="ppxymwp" name="Loonfungus Sickle" entryId="9e8f-650c-7daf-7cda::bbf9-bf04-680d-b250" number="6" type="upgrade" from="entry"><profiles><profile id="ca98-7a01-b9c5-bce9" name="Loonfungus Sickle" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="pqc0e3w" name="Snufflesquig's Gnashers" entryId="9e8f-650c-7daf-7cda::5552-1964-22eb-e7a6" number="6" type="upgrade" from="entry"><profiles><profile id="7780-f183-242c-29a" name="Snufflesquig's Gnashers" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="80" /></costs><categories><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ce45-cc36-d92e-ef70" name="GLOOMSPITE GITZ" entryId="ce45-cc36-d92e-ef70" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="76e8-7818-115c-6899" name="MOONCLAN" entryId="76e8-7818-115c-6899" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="836d-96c5-f628-0692" name="Moonclan Infantry" entryId="836d-96c5-f628-0692" primary="false" /></categories></selection><selection id="q2f5evb" name="Sporesplatta Fanatics" entryId="f2f9-4a27-f113-cf9d::618-3bfc-edf1-a568" number="1" type="unit" from="entry"><profiles><profile id="56ff-a904-75c8-8737" name="Sporesplatta Fanatics" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">2D6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">1</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="b415-7982-2a81-4113" name="Puffshroom Frenzy" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of melee weapons used by other friendly **^^Moonclan^^** units while they are wholly within 12&quot; of this unit. Subtract 1 from the Attacks characteristic of melee weapons used by enemy units while they are in combat with this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="330-f72c-17a1-10ab" name="A Prod in the Right Direction" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can use the 'Normal Move' ability as if it were your movement phase.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="q50xp0n" name="Sporesplatta Fanatic" entryId="f2f9-4a27-f113-cf9d::d6f9-47f1-82e4-55f5" number="5" type="model" from="entry"><selections><selection id="q5jesr" name="Spore-ball and Chain" entryId="f2f9-4a27-f113-cf9d::24fb-adb4-6a53-aae4" number="5" type="upgrade" from="entry"><profiles><profile id="e957-beee-b704-3151" name="Spore-ball and Chain" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">D3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="90" /></costs><categories><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ce45-cc36-d92e-ef70" name="GLOOMSPITE GITZ" entryId="ce45-cc36-d92e-ef70" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="76e8-7818-115c-6899" name="MOONCLAN" entryId="76e8-7818-115c-6899" primary="false" /><category id="836d-96c5-f628-0692" name="Moonclan Infantry" entryId="836d-96c5-f628-0692" primary="false" /></categories></selection><selection id="qmwv8um" name="Zarbag's Gitz" entryId="8c93-5efa-f6de-1c3a::5ebb-a3a6-b5a9-86c9" number="1" type="unit" from="entry"><profiles><profile id="cc96-f2f3-a73b-0096" name="Zarbag's Gitz" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="7b10-9590-b841-0a37" name="Sniffer Spite" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit's **Zarbag** is on the battlefield and within 3&quot; of a terrain feature, roll a dice. On a 4+, add 1 to this unit's power level for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="63a9-d60f-d205-5ee4" name="Zarbag" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit's **Zarbag** is on the battlefield, it has **^^Wizard (1)^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="qreesce" name="Bonekrakka" entryId="8c93-5efa-f6de-1c3a::b028-e971-1a1a-f5ae" number="1" type="model" from="entry"><selections><selection id="qrp72xb" name="Git Weapons" entryId="8c93-5efa-f6de-1c3a::7b0c-249b-97d3-9c40" number="1" type="upgrade" from="entry"><profiles><profile id="6be5-17bd-0ba9-f7d1" name="Git Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection><selection id="qrxo4az" name="Dibbz" entryId="8c93-5efa-f6de-1c3a::eebb-86cb-a538-b579" number="1" type="model" from="entry"><selections><selection id="qsur7pr" name="Moonclan Bow" entryId="8c93-5efa-f6d