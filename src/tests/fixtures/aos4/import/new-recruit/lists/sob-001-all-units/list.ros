n></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="482b-a44e-ffc6-df0a" name="SONS OF BEHEMAT" entryId="482b-a44e-ffc6-df0a" primary="false" /><category id="cdfb-7c8d-6a59-3866" name="GARGANT" entryId="cdfb-7c8d-6a59-3866" primary="false" /></categories></selection><selection id="ju3jq97" name="Mancrusher Mob" entryId="a296-fe56-a48c-4c2f::a0c1-1a99-2cf9-85f9" number="1" type="unit" from="entry"><profiles><profile id="bc81-7136-3757-e6cd" name="Mancrusher Mob" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">10</characteristic></characteristics></profile><profile id="8d88-dc4b-2cff-1f34" name="Stuff 'Em in Me Bag" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn, Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. If the roll is at least double the target's Health characteristic, 1 model in the target unit is slain.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="d5e6-b191-2b8c-6f76" name="Keep Up!" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit is wholly within 12&quot; of a friendly **^^Mega-Gargant^^**, this unit can use **^^Charge^^** abilities even if it used a **^^Run^^** ability in the same turn.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="989c-a90c-a4ef-125" name="'Oo's Under The Heel Now?" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this unit uses the 'Gargant Charge' ability, add 1 to the amount of mortal damage inflicted, if any, for each model in this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="jvil7tb" name="Mancrusher Gargant" entryId="a296-fe56-a48c-4c2f::bf4b-55e0-667c-3d90" number="3" type="model" from="entry"><selections><selection id="jvz4kq3" name="'Eadbutt" entryId="a296-fe56-a48c-4c2f::7a6b-47b1-6529-81d2" number="3" type="upgrade" from="entry"><profiles><profile id="25fb-d538-f6b7-92b1" name="'Eadbutt" hidden="false" typeI