s></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="482b-a44e-ffc6-df0a" name="SONS OF BEHEMAT" entryId="482b-a44e-ffc6-df0a" primary="false" /><category id="cdfb-7c8d-6a59-3866" name="GARGANT" entryId="cdfb-7c8d-6a59-3866" primary="false" /></categories></selection><selection id="jlvr6xb" name="Mancrusher Gargant (Scourge of Aqshy)" entryId="e074-e05d-7ef1-1bcd::101d-650a-0429-db5c" number="1" type="unit" from="entry"><profiles><profile id="c3b4-671c-1817-0446" name="Mancrusher Gargant" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">10</characteristic></characteristics></profile><profile id="c371-f739-5c1f-6609" name="Statue Tossing" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, the Damage characteristic of this unit's **Throwin' Rocks** is 3 instead of D3.
Then, you can spend up to 3 rage dice. If you do:
• For each rage dice spent, add 2 to the Attacks characteristic of this unit's **Throwin' Rocks** for the rest of the turn.
• If your opponent's **fury level** is lower than yours, they must increase their **fury level** by 1, to a maximum of 7.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="jl8uuhe" name="Mancrusher Gargant" entryId="e074-e05d-7ef1-1bcd::c977-0a82-6319-558a" number="1" type="model" from="entry"><selections><selection id="jnm1ed" name="'Eadbutt" entryId="e074-e05d-7ef1-1bcd::8b2f-8ad0-d03e-f82f" number="1" type="upgrade" from="entry"><profiles><profile id="7204-f863-55bd-c643" name="'Eadbutt" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">1</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">4</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="jnvu99e" name="Massive Club" entryId="e074-e05d-7ef1-1bcd::3323-1b0b-6046-6bb6" number="1" type="upgrade" from="entry"><profiles><profile id="4727-f7c3-5fe7-0454" name="Massive Club" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-