cteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="6ru7eqo" name="Clawlord on Gnaw-beast" entryId="e4f9-afb1-2fa1-66e9::118f-6fa1-8970-c521" number="1" type="model" from="entry"><selections><selection id="6vdj86" name="Gnaw-beast's Chisel Fangs" entryId="e4f9-afb1-2fa1-66e9::beb1-c193-42fe-1a94" number="1" type="upgrade" from="entry"><profiles><profile id="a706-5a-c738-6434" name="Gnaw-beast's Chisel Fangs" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="6voiqu" name="Ratling Pistol" entryId="e4f9-afb1-2fa1-66e9::de46-cfda-6165-83ec" number="1" type="upgrade" from="entry"><profiles><profile id="6038-d04c-2d9f-fa68" name="Ratling Pistol" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">D6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (Auto-wound), Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="6v4xw8" name="Warpforged Halberd" entryId="e4f9-afb1-2fa1-66e9::1fa1-c0e9-80e1-657e" number="1" type="upgrade" from="entry"><profiles><profile id="9a2d-197c-cc24-9ecb" name="Warpforged Halberd" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="e0fb-7194-508-f33b" name="VERMINUS" entryId="e0fb-7194-508-f33b" primary="false" /><category id="926c-df8c-6841-d49e" name="CAVALRY" entryId="926c-df8c-6841-d49e" primary="false" /></categories></selection><selection id="74jnpz9" name="Deathmaster" entryId="703-8991-676d-bf79::8231-16-26f7-f4aa" number="1" type="unit" from="entry"><profiles><profile id="a720-c30a-4d64-caec" name="Deathmaster" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">7&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="b70e-f9e9-2a75-7902" name="Shadowy Killers" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If the unmodified hit roll for an attack that targets this unit is 1-4, the attack fails and the attack sequence ends.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="5ddc-9bf6-b174-1534" name="Running Death" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While friendly **^^Eshin^^** units are wholly within 13&quot; of this unit, they can use **^^Shoot^^** and/or **^^Charge^^** abilities even if they used a **^^Run^^** ability in the same turn.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="74q30v7" name="Deathmaster" entryId="703-8991-676d-bf79::5082-9486-d90-1e0f" number="1" type="model" from="entry"><selections><selection id="78r608f" name="Eshin Throwing Stars" entryId="703-8991-676d-bf79::6cff-d38e-cdc0-f7d0" number="1" type="upgrade" from="entry"><profiles><profile id="c14-cc59-4f6-bb00" name="Eshin Throwing Stars" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">5</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">-</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (Auto-wound), Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="79t8vuf" name="Weeping Blade" entryId="703-8991-676d-bf79::a198-e5b6-6287-56c2" number="1" type="upgrade" from="entry"><profiles><profile id="7241-c004-f631-6822" name="Weeping Blade" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Hero^^** (+1 Rend), Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="a2e1-6655-23f6-6533" name="ESHIN" entryId="a2e1-6655-23f6-6533" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /></categories></selection><selection id="7hl357d" name="Deathmaster Crixxit" entryId="534b-3d02-8d52-0b53::d07c-20ca-d61f-40d7" number="1" type="unit" from="entry"><profiles><profile id="d51e-4854-8c71-a9a4" name="Deathmaster Crixxit" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">7&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="4158-d326-9857-4942" name="Master of Assassins" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Double the Damage characteristic of this unit's melee weapons for attacks that target an enemy **^^Hero^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="4455-3000-eb0e-43ef" name="Shadowblood Cloak" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **^^Eshin^^** unit that has 2 or more models and that is wholly within 18&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, remove this unit from the battlefield and set it up again wholly within 6&quot; of the target. This unit can be set up in combat.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="70c1-656d-c612-a8fa" name="Diversionary Assault" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **Gutter Runners** unit wholly within
13&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 2 to charge rolls for the target for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="7idxvur" name="Deathmaster Crixxit" entryId="534b-3d02-8d52-0b53::2d2e-a35a-bf57-273c" number="1" type="model" from="entry"><selections><selection id="7j1pc6q" name="The Blades of Thirteen Cuts" entryId="534b-3d02-8d52-0b53::c818-ccab-ea9e-0aa4" number="1" type="upgrade" from="entry"><profiles><profile id="1961-6ad1-b505-86a4" name="The Blades of Thirteen Cuts" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">13</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">2+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Hero^^**(+1 Rend), Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="150" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="a2e1-6655-23f6-6533" name="ESHIN" entryId="a2e1-6655-23f6-6533" primary="false" /></categories></selection><selection id="7qxfnec" name="Grey Seer" entryId="7299-ee25-cfb7-621f::a451-d214-7ed8-75ca" number="1" type="unit" from="entry"><profiles><profile id="d063-5111-30ae-9aa2" name="Grey Seer" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="89bc-bbb4-a341-bc51" name="Warpstone Shards" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The next time you make a casting roll for this unit this phase, roll 3D6 instead of 2D6. This roll cannot be rerolled or modified.
If the casting roll is 13, the spell is successfully cast and cannot be unbound. After the effect of that spell has been resolved, inflict D3 mortal damage on this unit.
If the casting roll is not 13, remove 1 dice of your choice from the casting roll and use the remaining 2D6 as the casting roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="7qyacdm" name="Grey Seer" entryId="7299-ee25-cfb7-621f::8fc3-4982-ceb9-e31b" number="1" type="model" from="entry"><selections><selection id="8101ad" name="Warpstone Staff" entryId="7299-ee25-cfb7-621f::8809-5178-7383-e8f5" number="1" type="upgrade" from="entry"><profiles><profile id="466b-bc62-9b51-e72f" name="Warpstone Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="7974-c5a2-e00a-f98f" name="MASTERCLAN" entryId="7974-c5a2-e00a-f98f" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /></categories></selection><selection id="8amcqlc" name="Grey Seer on Screaming Bell" entryId="d3e7-d46e-1989-7534::dc6a-710a-58a4-3c7b" number="1" type="unit" from="entry"><profiles><profile id="4b81-ce30-43c6-747a" name="Grey Seer on Screaming Bell" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">15</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="ff7a-8be5-39ec-80ec" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Crushing Bulk** is 4.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="c288-6154-dbc5-d378" name="Altar of the Horned Rat" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Friendly **^^Skaven Infantry^^** units have **^^Ward (6+)^^** while they are wholly within 13&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="2a6e-6eaa-7e74-d3a8" name="Peal of Doom" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice and apply the corresponding effect:
**1 *Magical Backlash:*** Inflict D3 mortal damage on this unit.
**2-4 *Wall of Unholy Sound:*** Until the start of your next turn, subtract 1 from hit rolls for combat attacks made by enemy units while they are within 13&quot; of this unit.
**5-6 *Apocalyptic Doom:*** Roll a D3 for each enemy unit within 13&quot; of this unit. On a 2+, inflict an amount of mortal damage on that unit equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="13a0-e954-fa3b-60b1" name="Cracks Call" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy unit that does not have **^^Fly^^** and is within 13&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">If the casting roll exceeds the target's **^^Move^^** characteristic, inflict an amount of mortal damage on the target equal to the difference between the casting roll and its **^^Move^^** characteristic.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="8bat1ai" name="Grey Seer on Screaming Bell" entryId="d3e7-d46e-1989-7534::85a6-45da-26a-210d" number="1" type="model" from="entry"><selections><selection id="8f2qla" name="Crushing Bulk" entryId="d3e7-d46e-1989-7534::f3c4-6ddf-3ccd-e1c2" number="1" type="upgrade" from="entry"><profiles><profile id="20d4-4fda-9815-2c9b" name="Crushing Bulk" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="8fw04wb" name="Rat Ogor's Tearing Claws" entryId="d3e7-d46e-1989-7534::8094-80b3-3aec-4224" number="1" type="upgrade" from="entry"><profiles><profile id="2d45-924b-37ac-f888" name="Rat Ogor's Tearing Claws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="8f2y48o" name="Warpstone Staff" entryId="d3e7-d46e-1989-7534::3df0-35e2-dbb2-12bc" number="1" type="upgrade" from="entry"><profiles><profile id="1f6a-9bfb-754c-bd07" name="Warpstone Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="310" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="f7bc-b618-4b5d-2bae" name="WAR MACHINE" entryId="f7bc-b618-4b5d-2bae" primary="false" /><category id="7974-c5a2-e00a-f98f" name="MASTERCLAN" entryId="7974-c5a2-e00a-f98f" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /></categories></selection><selection id="8p8mp1c" name="Grey Seer on Screaming Bell (Scourge of Aqshy)" entryId="5719-67f4-e546-5086::bd6f-e63d-70e9-c859" number="1" type="unit" from="entry"><profiles><profile id="fca7-f479-66ae-e0a9" name="Grey Seer on Screaming Bell" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">15</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="7db3-c07b-d516-6972" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Crushing Bulk** is 4.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="a074-1628-9623-e759" name="The Bell Tolls" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If the current battle round number is odd, add 2&quot; to the Move characteristic of friendly **^^Skaven^^** units while they are wholly within 13&quot; of this unit. If the current battle round number is even, subtract 1 from hit rolls for attacks made by enemy units that target a friendly **^^Skaven^^** unit while it is wholly within 13&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="0bd0-f3db-8eac-1f63" name="Echoes of the Vermindoom" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 visible friendly **^^Skaven^^** units wholly within 13&quot; of this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** each target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="0b88-99bf-50fb-3330" name="Pealing Portal" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, this unit counts as a friendly **Gnawhole** for the purposes of the 'Gnawhole Ambush', 'Tunnels Through Reality' and 'The Endless Vermintide' abilities.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="8qxr6ag" name="Grey Seer on Screaming Bell" entryId="5719-67f4-e546-5086::2ae3-b8e8-de19-7bf2" number="1" type="model" from="entry"><selections><selection id="8uu1ifb" name="Crushing Bulk" entryId="5719-67f4-e546-5086::f273-ac33-cc19-0704" number="1" type="upgrade" from="entry"><profiles><profile id="99b9-00fa-4ad4-cefc" name="Crushing Bulk" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage), Companion</characteristic></characteristics></profile></profiles></selection><selection id="8u3ffsq" name="Rat Ogor's Tearing Claws" entryId="5719-67f4-e546-5086::2c8a-dca9-729e-8cd3" number="1" type="upgrade" from="entry"><profiles><profile id="a584-7e18-e3c5-72f7" name="Rat Ogor's Tearing Claws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="8udb5oe" name="Warpstone Staff" entryId="5719-67f4-e546-5086::2a01-e088-2486-d5e0" number="1" type="upgrade" from="entry"><profiles><profile id="45fc-f7eb-f9f9-3042" name="Warpstone Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="330" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="f7bc-b618-4b5d-2bae" name="WAR MACHINE" entryId="f7bc-b618-4b5d-2bae" primary="false" /><category id="7974-c5a2-e00a-f98f" name="MASTERCLAN" entryId="7974-c5a2-e00a-f98f" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /></categories></selection><selection id="97j3vi5" name="Krittok Foulblade" entryId="a9a9-9048-a1b8-3fe7::64d0-3abe-62b7-7e40" number="1" type="unit" from="entry"><profiles><profile id="e328-0e2e-dcff-b846" name="Krittok Foulblade" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="7689-7588-7bc0-7805" name="Foster Competition" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to wound rolls for friendly **Stormvermin** units while they are wholly within 13&quot;of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="847b-944a-45e8-9523" name="Doomfang" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit has **^^Strike-first^^** for the rest of the turn but it cannot use commands this phase.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="04f1-d54f-1c8e-b2b8" name="A Reputation For Cunning" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" from="entry"><characteristics><characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Enemy Hero Phase</characteristic><characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic><characteristic name="Declare" typeId="b77f-7548-840e-c086"></characteristic><characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">You can pick 2 different eligible units to use the 'Always Three Clawsteps Ahead' ability this phase instead of 1, but at least 1 of those units must have the **^^Verminus^^** keyword.</characteristic><characteristic name="Keywords" typeId="445d-f443-5448-e7ce"></characteristic></characteristics><attributes><attribute name="Color" typeId="5c69-e4b9-19bc-e801">Yellow</attribute><attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Movement</attribute><attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="98w3y7k" name="Krittok Foulblade" entryId="a9a9-9048-a1b8-3fe7::788c-9a15-b036-6a7c" number="1" type="model" from="entry"><selections><selection id="9bm33xf" name="Doomfang" entryId="a9a9-9048-a1b8-3fe7::1030-d67a-9c3d-250a" number="1" type="upgrade" from="entry"><profiles><profile id="a264-444c-3bf0-06d4" name="Doomfang" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="9b54wqp" name="Warplock Pistol" entryId="a9a9-9048-a1b8-3fe7::ec55-ace1-8519-f553" number="1" type="upgrade" from="entry"><profiles><profile id="d1cc-22e2-3897-9736" name="Warplock Pistol" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="140" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c203-51a0-3d44-6b07" name="WARMASTER" entryId="c203-51a0-3d44-6b07" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="e0fb-7194-508-f33b" name="VERMINUS" entryId="e0fb-7194-508-f33b" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /></categories></selection><selection id="9oq8n8k" name="Lord Skreech Verminking" entryId="96e7-bdfc-d62-5b04::873-d49d-6d01-4397" number="1" type="unit" from="entry"><profiles><profile id="1811-6e2b-f5bc-1b07" name="Lord Skreech Veminking" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">13</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="23fe-c70f-26bd-e15a" name="The Thirteen-headed One" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of the following effects to apply until the start of your next turn. You cannot pick the same effect more than once per battle.
***Master of Dire Sorcery:*** Add 1 to casting rolls for friendly **^^Masterclan Wizards^^** while they are wholly within 13&quot; of this unit.
***Commander of Vermin:*** Add 1 to charge rolls for friendly **^^Verminus^^** units while they are wholly within 13&quot; of this unit.
***Knower of Warp-tech:*** Add 1 to hit rolls for shooting attacks made by friendly **^^Skryre^^** units while they are wholly within 13&quot; of this unit.
***Deliverer of Weeping Blades:*** Add 1 to the Rend characteristic of melee weapons used by friendly **^^Eshin^^** units while they are wholly within 13&quot; of this unit.
***Bringer of Plagues:*** Add 1 to chanting rolls for friendly **^^Pestilens Priests^^** while they are wholly within 13&quot; of this unit.
***Shaper of Fleshcraft:*** **Heal (D3)** each friendly **^^Moulder^^** unit wholly within 13&quot; of this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="1b6c-33a1-b48c-a34" name="Terrifying Monstrosity" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy **^^Infantry^^** unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+:
• The target cannot use commands for the rest of the turn.
• Subtract an amount equal to the roll from the target's control score until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="f0ad-470-69a7-cf14" name="The Dreaded Thirteenth Spell" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy unit within 13&quot; to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Roll 13 dice. For each 5+:
• Inflict 1 mortal damage on the target.
• You can return 1 slain model to a friendly **Clanrats** unit wholly within 13&quot; of this unit.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="9phk6ty" name="Lord Skreech Veminking" entryId="96e7-bdfc-d62-5b04::8705-edf4-3a82-ec58" number="1" type="model" from="entry"><selections><selection id="9qa0ovp" name="Glaive of the Rat King" entryId="96e7-bdfc-d62-5b04::b4d9-fa2-9cb2-be0" number="1" type="upgrade" from="entry"><profiles><profile id="999c-c407-a670-5963" name="Glaive of the Rat King" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">7</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (2 Hits)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="380" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="c203-51a0-3d44-6b07" name="WARMASTER" entryId="c203-51a0-3d44-6b07" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="7974-c5a2-e00a-f98f" name="MASTERCLAN" entryId="7974-c5a2-e00a-f98f" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="e0fb-7194-508-f33b" name="VERMINUS" entryId="e0fb-7194-508-f33b" primary="false" /><category id="e9fa-30a7-a728-b45e" name="PESTILENS" entryId="e9fa-30a7-a728-b45e" primary="false" /><category id="a2e1-6655-23f6-6533" name="ESHIN" entryId="a2e1-6655-23f6-6533" primary="false" /><category id="da36-ed81-79fe-ca75" name="SKRYRE" entryId="da36-ed81-79fe-ca75" primary="false" /><category id="3244-98f3-bb61-b9d3" name="MOULDER" entryId="3244-98f3-bb61-b9d3" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /></categories></selection><selection id="a38q86p" name="Master Moulder" entryId="3b44-18cd-8a0b-5c8::4b86-5244-fe24-99c6" number="1" type="unit" from="entry"><profiles><profile id="fdf3-828b-b145-fbdb" name="Master Moulder" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="7f66-a394-3922-41e1" name="Lord of Flesh-grafting" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick another friendly **^^Moulder^^** unit wholly within 13&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (3)** the target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="744d-b1d5-a5f2-56ce" name="Tyrannical Packmaster" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick another friendly **^^Moulder^^** unit within this unit's combat range to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to charge rolls for the target for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="a4bjbi" name="Master Moulder" entryId="3b44-18cd-8a0b-5c8::6ac2-9216-d2ca-a029" number="1" type="model" from="entry"><selections><selection id="a90o7nl" name="Arsenal of Mutation" entryId="3b44-18cd-8a0b-5c8::7158-097a-0c10-3865" number="1" type="upgrade" from="entry"><profiles><profile id="01d7-f453-2d00-ccaf" name="Arsenal of Mutation" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (2 Hits)</characteristic></characteristics></profile></profiles></selection><selection id="a9mhw9" name="Warpsyringe Pistol" entryId="3b44-18cd-8a0b-5c8::d08f-5814-8b4a-a7d5" number="1" type="upgrade" from="entry"><profiles><profile id="bca4-5d5d-3e23-8b8" name="Warpsyringe Pistol" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">D6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="80" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="3244-98f3-bb61-b9d3" name="MOULDER" entryId="3244-98f3-bb61-b9d3" primary="false" /></categories></selection><selection id="542lx" name="Plague Priest" entryId="98d0-7e0e-b303-6db0::90a1-d4c0-96ae-328" number="1" type="unit" from="entry"><profiles><profile id="5ad-fdf8-d601-1785" name="Plague Priest" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="e430-6e3d-c92a-feae" name="Feed on Pestilence" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Fight^^** ability for a friendly **^^Pestilens^^** unit wholly within 13&quot; of this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Give this unit 1 ritual point.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="55r22ep" name="Plague Priest" entryId="98d0-7e0e-b303-6db0::8053-8e6d-6500-8d3" number="1" type="model" from="entry"><selections><selection id="5925yjn" name="Warpstone-tipped Staff" entryId="98d0-7e0e-b303-6db0::1c21-3e8b-fffa-5176" number="1" type="upgrade" from="entry"><profiles><profile id="3d46-7c51-6878-d185" name="Warpstone-tipped Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="3fe-84f4-cec6-a1c1" name="PRIEST (1)" entryId="3fe-84f4-cec6-a1c1" primary="false" /><category id="e9fa-30a7-a728-b45e" name="PESTILENS" entryId="e9fa-30a7-a728-b45e" primary="false" /><category id="acaf-8bb6-d6f-3e2a" name="Legends" entryId="acaf-8bb6-d6f-3e2a" primary="false" /></categories></selection><selection id="amfltz6" name="Plague Priest on Plague Furnace" entryId="476b-6ecb-c5f8-cdee::6cc5-c1f4-812c-ee3b" number="1" type="unit" from="entry"><profiles><profile id="3df4-1274-9219-2621" name="Plague Priest on Plague Furnace" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">15</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="ea70-f2ff-db7f-e1e0" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Great Plague Censer** is 2.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3a06-271c-4c39-d9ab" name="Corrupting Influence" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract 1 from ward rolls for enemy units while they are within 13&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="e015-bb49-63ff-e845" name="Altar of the Great Corruptor" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Friendly **^^Pestilens^^** units have **^^Ward (6+)^^** while they are wholly within 13&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="anf5ei5" name="Plague Priest on Plague Furnace" entryId="476b-6ecb-c5f8-cdee::ce7c-5e36-42ee-a1dd" number="1" type="model" from="entry"><selections><selection id="as3d4dj" name="Crushing Bulk" entryId="476b-6ecb-c5f8-cdee::890f-9311-63de-5af1" number="1" type="upgrade" from="entry"><profiles><profile id="5899-cb43-5917-734a" name="Crushing Bulk" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="as6eu3r" name="Foetid Blades" entryId="476b-6ecb-c5f8-cdee::9c0b-7b5d-b5b0-ae57" number="1" type="upgrade" from="entry"><profiles><profile id="12b5-cb53-bc49-8db5" name="Foetid Blades" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="ar22so" name="Great Plague Censer" entryId="476b-6ecb-c5f8-cdee::df8f-210d-4614-701d" number="1" type="upgrade" from="entry"><profiles><profile id="ba06-b2a6-fad0-9de0" name="Great Plague Censer" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="assdpdk" name="Warpstone-tipped Staff" entryId="476b-6ecb-c5f8-cdee::5c50-328-99c4-5282" number="1" type="upgrade" from="entry"><profiles><profile id="14d0-5ac3-67aa-96ea" name="Warpstone-tipped Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="350" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="e9fa-30a7-a728-b45e" name="PESTILENS" entryId="e9fa-30a7-a728-b45e" primary="false" /><category id="3fe-84f4-cec6-a1c1" name="PRIEST (1)" entryId="3fe-84f4-cec6-a1c1" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="f7bc-b618-4b5d-2bae" name="WAR MACHINE" entryId="f7bc-b618-4b5d-2bae" primary="false" /></categories></selection><selection id="bdinl97" name="Thanquol on Boneripper" entryId="88c9-115c-3714-e884::63ad-17ef-38e1-210a" number="1" type="unit" from="entry"><profiles><profile id="3227-4262-9ac7-4031" name="Thanquol on Boneripper" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="a63c-84de-6e8c-fc5a" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Warpfire Braziers** is 4.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8ac-7f06-6c75-ff32" name="Staff of the Horned Rat" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to casting rolls for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="92c9-3f5b-20b-799f" name="Warp-amulet" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3931-3b61-7774-faf8" name="Boneripper Rampage" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3-5, inflict D3 mortal damage on the target. On a 6, inflict 2D3 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="9be5-4bff-d155-d2b3" name="Terrible Madness" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy unit within 13&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">The target cannot use commands until the start of your next turn. In addition, roll a number of dice equal to the number of models in the target unit. For each 6, inflict 1 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="bekfmol" name="Thanquol on Boneripper" entryId="88c9-115c-3714-e884::f269-5b69-e16f-da3e" number="1" type="model" from="entry"><selections><selection id="bfs6og7" name="Custom Warpfire Projectors" entryId="88c9-115c-3714-e884::fcc5-cdd7-4613-ac44" number="1" type="upgrade" from="entry"><profiles><profile id="ad11-7d34-c364-f9ee" name="Custom Warpfire Projectors" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Companion</characteristic></characteristics></profile></profiles></selection><selection id="bf7tl4d" name="Staff of the Horned Rat" entryId="88c9-115c-3714-e884::ce18-2a73-eae6-242d" number="1" type="upgrade" from="entry"><profiles><profile id="43a2-cc25-bb22-4a73" name="Staff of the Horned Rat" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="bfply7b" name="Warpfire Braziers" entryId="88c9-115c-3714-e884::c204-c82c-7b2f-7255" number="1" type="upgrade" from="entry"><profiles><profile id="1777-6e34-2070-88dd" name="Warpfire Braziers" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="310" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="c203-51a0-3d44-6b07" name="WARMASTER" entryId="c203-51a0-3d44-6b07" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="7974-c5a2-e00a-f98f" name="MASTERCLAN" entryId="7974-c5a2-e00a-f98f" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /></categories></selection><selection id="bs1l7fk" name="Verminlord Corruptor" entryId="6b0b-367d-ec80-2727::645a-2377-ae20-f9c" number="1" type="unit" from="entry"><profiles><profile id="9e3c-3ef9-273e-c9d2" name="Verminlord Corruptor" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">13</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="5dfd-ceb0-e616-8354" name="Lord of Great Plagues" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If the unmodified chanting roll for a friendly **^^Pestilens Priest^^** this phase was 6, pick 1 of the following effects to apply:
***Crimsonweal Curse:*** Pick an enemy unit within 13&quot; of this unit to be the target. For the rest of the battle, each time the target uses a **^^Move^^** ability, inflict D3 mortal damage on it after the **^^Move^^** ability has been resolved.
***The Neverplague:*** For the rest of the battle, you can re-roll chanting rolls for friendly **^^Pestilens Priests^^**.
***Undulant Scourge:*** Pick a visible enemy unit within 13&quot; of this unit to be the target. Inflict 2D3 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="f39b-32c-e0b0-c1cb" name="Plaguemaster" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 enemy units in combat with this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3 for each target. On a 2+:
• Inflict an amount of mortal damage on the target equal to the roll.
• Give this unit 1 ritual point.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="bs2kwg8" name="Verminlord Corruptor" entryId="6b0b-367d-ec80-2727::e930-9579-8b2b-45da" number="1" type="model" from="entry"><selections><selection id="bwltjtj" name="Plaguereapers" entryId="6b0b-367d-ec80-2727::283b-c3c4-5678-6a43" number="1" type="upgrade" from="entry"><profiles><profile id="f973-b7a3-1d53-6a2b" name="Plaguereapers" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="260" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="e9fa-30a7-a728-b45e" name="PESTILENS" entryId="e9fa-30a7-a728-b45e" primary="false" /><category id="3fe-84f4-cec6-a1c1" name="PRIEST (1)" entryId="3fe-84f4-cec6-a1c1" primary="false" /></categories></selection><selection id="c6hsuuc" name="Verminlord Corruptor (Scourge of Aqshy)" entryId="b56c-340c-dc27-3ead::9aff-5b17-16a9-ec71" number="1" type="unit" from="entry"><profiles><profile id="51e0-f7d4-2833-628e" name="Verminlord Corruptor" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">13</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="b58d-b80c-0032-803b" name="Foetid Features" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of the following effects to apply for the rest of the battle:
***Noisome Halitosis:*** Add 1 to the Damage characteristic of this unit's **Plague Breath**.
***Pestilential Seepage:*** While this unit is damaged, you can re-roll chanting rolls for friendly **^^Pestilens Priests^^** while they are wholly within 13&quot; of this unit.
***Curdled Miasma:*** While they are within 6&quot; of this unit, enemy units are not visible to other enemy units more than 3&quot; from them.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="bd24-cdb3-323b-628e" name="Seething Blight" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Spend 1 **rage dice**. If your opponent's **fury level** is lower than yours, they must increase their **fury level** by 1, to a maximum of 7. Then, pick a visible unit (friendly or enemy) wholly within 13&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle:
• Add 1 to the Attacks characteristic of the target's melee weapons.
• If an ability would heal or return any slain models to the target unit, that ability does not heal any damage points or return any slain models to it.
• If the target is replaced and the replacement unit has 1 model, allocate damage points to that replacement unit equal to half X (rounding up), where X is its Health characteristic minus the number of damage points allocated to it (if any).
• If the target is replaced and the replacement unit has more than 1 model, half the models in that replacement unit (rounding up) are automatically slain.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="c7g9zss" name="Verminlord Corruptor" entryId="b56c-340c-dc27-3ead::066e-25c9-68e2-a167" number="1" type="model" from="entry"><selections><selection id="cbhkqef" name="Plague Breath" entryId="b56c-340c-dc27-3ead::46e7-5401-d5ae-8893" number="1" type="upgrade" from="entry"><profiles><profile id="d47f-92c9-1752-eb93" name="Plague Breath" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="cbz356" name="Plaguereapers" entryId="b56c-340c-dc27-3ead::a0b0-9f32-2143-b985" number="1" type="upgrade" from="entry"><profiles><profile id="7808-d19f-dc92-a43d" name="Plaguereapers" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="310" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="e9fa-30a7-a728-b45e" name="PESTILENS" entryId="e9fa-30a7-a728-b45e" primary="false" /><category id="3fe-84f4-cec6-a1c1" name="PRIEST (1)" entryId="3fe-84f4-cec6-a1c1" primary="false" /></categories></selection><selection id="cn8jooc" name="Verminlord Deceiver" entryId="181f-fa52-9a52-12bd::de4e-185a-4671-283d" number="1" type="unit" from="entry"><profiles><profile id="e9e2-3dd0-1f1-f699" name="Verminlord Deceiver" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">13</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="62ff-c41a-bd1-65b7" name="Lord of Assassins" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared the 'Redeploy' command for a friendly **^^Eshin Infantry^^** unit wholly within 13&quot; of this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If you roll a 1-3 when determining the distance that unit can move, you can use a value of 4 instead.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="2576-5d86-146d-89f5" name="Burst From the Shadows" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is in combat, roll a dice. On a 4+, you can pick a point on the battlefield within 13&quot; of this unit and within 1&quot; of any enemy units. Remove this unit from the battlefield and set it up again within 1&quot; of that point.
**Designer's Note:** *This ability allows the unit to set up in combat with a new enemy unit.*</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="cnl6fhn" name="Verminlord Deceiver" entryId="181f-fa52-9a52-12bd::c9a1-9187-4c15-177f" number="1" type="model" from="entry"><selections><selection id="csrp865" name="Doomstar" entryId="181f-fa52-9a52-12bd::80ba-428d-3f7a-e72b" number="1" type="upgrade" from="entry"><profiles><profile id="19cf-2c82-af3e-3e5a" name="Doomstar" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">13&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="csec57o" name="Warpstiletto" entryId="181f-fa52-9a52-12bd::cf1e-4e0d-172e-8ced" number="1" type="upgrade" from="entry"><profiles><profile id="2c4d-ae64-fc0d-add4" name="Warpstiletto" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">3</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="390" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="a2e1-6655-23f6-6533" name="ESHIN" entryId="a2e1-6655-23f6-6533" primary="false" /></categories></selection><selection id="d6ntnd" name="Verminlord Warbringer" entryId="2f14-2a09-b928-6a47::6848-b440-5959-a43" number="1" type="unit" from="entry"><profiles><profile id="c681-7b64-4138-6823" name="Verminlord Warbringer" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">13</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="49ba-f669-bd46-9894" name="Tyrant of Battle" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 2 friendly **^^Verminus Infantry^^** units wholly within 13&quot; of this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The targets can each use the 'All-out Attack' or 'All-out Defence' command this phase even if that command has been used by a friendly unit this phase.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="bb8-73f2-4bb4-5e1d" name="Killing Blow" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a damaged enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. If the roll is less than the number of damage points the target has, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="d74ou1" name="Verminlord Warbringer" entryId="2f14-2a09-b928-6a47::83f6-3210-a3d6-b7d9" number="1" type="model" from="entry"><selections><selection id="demgilc" name="Doom Glaive and Spike-fist" entryId="2f14-2a09-b928-6a47::5574-8aaa-26ce-40aa" number="1" type="upgrade" from="entry"><profiles><profile id="62d6-6bc4-ab97-b33f" name="Doom Glaive and Spike-fist" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">7</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="260" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="e0fb-7194-508-f33b" name="VERMINUS" entryId="e0fb-7194-508-f33b" primary="false" /></categories></selection><selection id="5kbx3cp" name="Verminlord Warpseer" entryId="a894-c0e3-2a4-79d0::8dad-1c7-e47c-b608" number="1" type="unit" from="entry"><profiles><profile id="8121-e9b9-7a26-c16a" name="Verminlord Warpseer" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">13</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="4f03-25df-1515-f18" name="Divine the Future" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit is on the battlefield, add 2&quot; to the distance friendly units can move when using the 'Always Three Clawsteps Ahead' ability.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="d9f9-c8e3-e715-bab7" name="Arch-Manipulator" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 4+, the target has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="4848-6c22-2129-1d6c" name="Hurl Scry-orb" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit cannot use the 'Divine the Future' ability for the rest of the battle. Roll a dice. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3725-6880-8e1b-9faf" name="Tectonic Splintering" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy unit within 18&quot; to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, subtract 1 from the number of dice rolled when making charge rolls for the target, to a minimum of 1.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="5l9qexl" name="Verminlord Warpseer" entryId="a894-c0e3-2a4-79d0::f4c-bcc1-9409-e6b2" number="1" type="model" from="entry"><selections><selection id="5p012tj" name="Doom Glaive" entryId="a894-c0e3-2a4-79d0::d244-b12-fddd-ca68" number="1" type="upgrade" from="entry"><profiles><profile id="a1c8-bacf-ca50-c967" name="Doom Glaive" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="300" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="7974-c5a2-e00a-f98f" name="MASTERCLAN" entryId="7974-c5a2-e00a-f98f" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /></categories></selection><selection id="6hmusxx" name="Vizzik Skour, Prophet of the Horned Rat" entryId="ecc8-7506-0ac3-ca80::2a51-7859-e014-cecd" number="1" type="unit" from="entry"><profiles><profile id="aeea-c4ac-338e-bf84" name="Vizzik Skour, Prophet of the Horned Rat" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">15</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="dd88-d395-4d29-35d7" name="Fissures In Reality" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each enemy unit in combat with this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3 for each target. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="24b4-8469-b666-953e" name="Prophet of the Horned Rat" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can re-roll chanting rolls for this unit until the start of your next turn</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="59e0-d987-4ae5-b555" name="Gaze of the Gnaw" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 2+, for the rest of the turn:
• If this unit is in combat with the target when the target is picked to use a **^^Fight^^** ability, all of the target's attacks must target this unit.
• Subtract 1 from hit rolls and wound rolls for the target's combat attacks that target this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3ec7-5877-85e1-5f83" name="The Death Frenzy" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Any Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">8</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a visible enemy unit within 13&quot;of this unit or a visible friendly **^^Skaven Infantry^^** unit within 13&quot; of this unit to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the target is an enemy unit, subtract 1 from the Attacks characteristic of the target's melee weapons until the start of your next turn.
If the target is a friendly unit, it can use 2 **^^Fight^^** abilities this turn. After the first is used, however, the target has **^^Strike-last^^** for the rest of the turn.
If the chanting roll was 12+, you can pick 2 targets instead of 1.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="6iwt50a" name="Vizzik Skour, Prophet of the Horned Rat" entryId="ecc8-7506-0ac3-ca80::18c2-6ded-1797-e801" number="1" type="model" from="entry"><selections><selection id="6k6l96s" name="Host of Vermin" entryId="ecc8-7506-0ac3-ca80::3c69-013d-7252-16b1" number="1" type="upgrade" from="entry"><profiles><profile id="89f8-c816-3fdb-a3fd" name="Host of Vermin" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">10</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound), Companion</characteristic></characteristics></profile></profiles></selection><selection id="6koafnp" name="Unholy Gnawstaff" entryId="ecc8-7506-0ac3-ca80::c05e-2228-abe8-3777" number="1" type="upgrade" from="entry"><profiles><profile id="2731-2c4f-d515-5f02" name="Unholy Gnawstaff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D6</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="340" /></costs><categories><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="c203-51a0-3d44-6b07" name="WARMASTER" entryId="c203-51a0-3d44-6b07" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="7974-c5a2-e00a-f98f" name="MASTERCLAN" entryId="7974-c5a2-e00a-f98f" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="e692-853d-6db8-fdbe" name="PRIEST (2)" entryId="e692-853d-6db8-fdbe" primary="false" /></categories></selection><selection id="7hf3w2" name="Warlock Bombardier" entryId="d81b-11e8-df5e-ec45::c11b-a255-cd5e-cb23" number="1" type="unit" from="entry"><profiles><profile id="f8f2-64d1-99cc-1484" name="Warlock Bombardier" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="ec7e-ba13-31ad-8c13" name="More-more Doom!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Shoot^^** ability for this unit, it was not set up this turn and it has not used a **^^Move^^** ability this turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 2+, set the Damage characteristic of its **Doomrocket** to D3+3 for the rest of the turn. On a 1, inflict D3 mortal damage on this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="b95e-ad3c-db58-fda4" name="Explosive Payload" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to hit rolls for this unit's shooting attacks that target an enemy unit that has 10 or more models.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="7ijaw5" name="Warlock Bombardier" entryId="d81b-11e8-df5e-ec45::8af1-63a3-6ffb-89c0" number="1" type="model" from="entry"><selections><selection id="7r6l1q1r" name="Doomrocket" entryId="d81b-11e8-df5e-ec45::6f18-d359-63d7-3db6" number="1" type="upgrade" from="entry"><profiles><profile id="d885-a05-9719-3ad2" name="Doomrocket" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D6</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Anti-**^^Infantry^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="7regvqs" name="Firing Pole" entryId="d81b-11e8-df5e-ec45::6ff0-7219-9829-4e58" number="1" type="upgrade" from="entry"><profiles><profile id="9486-b22d-4ee1-3123" name="Firing Pole" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</charac