tic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (2 Hits), Anti-**^^Cavalry^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="170" /></costs><categories><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="da36-ed81-79fe-ca75" name="SKRYRE" entryId="da36-ed81-79fe-ca75" primary="false" /><category id="4700-6c86-cd5d-ed1b" name="WEAPON TEAM" entryId="4700-6c86-cd5d-ed1b" primary="false" /></categories></selection><selection id="ua2ksaj" name="Zikkit's Tunnelpack" entryId="f1ef-054a-bf45-75c8::2962-829f-aafd-fa84" number="1" type="unit" from="entry"><profiles><profile id="7c51-5b3d-5560-9d16" name="Zikkit's Tunnelpack" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="7cf9-d504-32de-e83a" name="Ka-boom!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit's **Tik Tik** is a token. If this unit's Tik Tik is on the battlefield, remove it from the battlefield and roll a D3. On a 2+, inflict an amount of mortal damage on the target equal to the roll and the target has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="092c-8af6-27f0-6601" name="Tunneling Team" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up this unit in reserve **drilling beneath the surface**. It has now been deployed.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="d447-ab67-c3db-8ab5" name="Tunnelpack Ambush" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick this unit if it is **drilling beneath the surface**.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up this unit anywhere on the battlefield more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="uc40zl7" name="Krittatok" entryId="f1ef-054a-bf45-75c8::93c6-7b9a-6174-de0c" number="1" type="model" from="entry"><selections><selection id="ugixsao" name="Mangy Claws" entryId="f1ef-054a-bf45-75c8::5064-d88d-0bad-3c16" number="1" type="upgrade" from="entry"><profiles><profile id="4d79-9a09-ed8a-2850" name="Mangy Claws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="ugsnvam" name="Skryre Bombs" entryId="f1ef-054a-bf45-75c8::8160-97a3-e0fc-f7cf" number="1" type="upgrade" from="entry"><profiles><profile id="6806-7dcf-0d3b-dea7" name="Skryre Bombs" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17