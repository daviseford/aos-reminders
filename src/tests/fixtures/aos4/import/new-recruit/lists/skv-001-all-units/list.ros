gories></selection><selection id="jn9omr" name="Skabbik's Plaguepack" entryId="808a-9e1e-1a7b-cf53::4f4c-4e64-71f7-d4b2" number="1" type="unit" from="entry"><profiles><profile id="7bb7-44f6-d6fe-97e0" name="Skabbik's Plaguepack" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="ca05-ed6e-1386-4ded" name="Enshrouding Fumes" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract 1 from hit rolls for shooting attacks that target this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="0d1e-e875-6cd0-4125" name="Skritter" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit's **Skritter** is a token. If you make a chanting roll of 1 for this unit while its **Skritter** is on the battlefield, you can remove its **Skritter** from the battlefield and then re-roll that chanting roll.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="jpsvhab" name="Itchitt" entryId="808a-9e1e-1a7b-cf53::67bf-2065-d45f-5397" number="1" type="model" from="entry"><selections><selection id="jrp884" name="Plaguepack Weapons" entryId="808a-9e1e-1a7b-cf53::4b87-a9fd-b732-6e49" number="1" type="upgrade" from="entry"><profiles><profile id="aaef-4574-426e-92d4" name="Plaguepack Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection><selection id="jppqey9" name="Poxlix" entryId="808a-9e1e-1a7b-cf53::c0e4-e292-5917-fcb3" number="1" type="model" from="entry"><selections><selection id="jseqmm9" name="Plaguepack Weapons" entryId="808a-9e1e-1a7b-cf53::cf89-4944-d570-dafd" number="1" type="upgrade" from="entry"><profiles><profile id="737c-04dc-2438-bd67" name="Plaguepack Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Auto-wound)</characteristic>