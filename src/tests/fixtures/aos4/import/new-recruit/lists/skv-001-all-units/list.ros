characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="acaf-8bb6-d6f-3e2a" name="Legends" entryId="acaf-8bb6-d6f-3e2a" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="da36-ed81-79fe-ca75" name="SKRYRE" entryId="da36-ed81-79fe-ca75" primary="false" /></categories></selection><selection id="w125bm" name="Brood Terror" entryId="9659-8454-494e-94dd::4a53-c768-57de-d622" number="1" type="unit" from="entry"><profiles><profile id="d39e-4962-3897-0976" name="Brood Terror" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="6ae6-57c2-6ebc-8bd1" name="Warpstone Fumes" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 2+, for the rest of the turn, subtract 1 from hit rolls for attacks made by enemy units while they are within 6&quot; of this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="bf08-b4da-4652-cb43" name="Regenerating Terror" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D6)** this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="w29yafn" name="Brood Terror" entryId="9659-8454-494e-94dd::d82b-07b4-703e-54ec" number="1" type="model" from="entry"><selections><selection id="w5hmsx" name="Bladed Limbs" entryId="9659-8454-494e-94dd::f41e-04f4-fbbb-901e" number="1" type="upgrade" from="entry"><profiles><profile id="450a-758d-6d0b-d134" name="Bladed Limbs" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="w5aluwm" name="Chain-flail" entryId="9659-8454-494e-94dd::7209-c4b3-f60e-a96f" number="1" type="upgrade" from="entry"><profiles><profile id="0eae-afc1-7987-f1ae" name="Chain-flail" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection><selection id="w5uzdch" name="Warpflame Scourger" entryId="9659-8454-494e-94dd::dc56-faf6-22fb-fc09" number="1" type="upgrade" from="entry"><profiles><profile id="a691-3538-3fe3-d9b4" name="Warpflame Scourger" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">15&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2D6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Anti-**^^Infantry^^** (+1 Rend), Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="220" /></costs><categories><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="3244-98f3-bb61-b9d3" name="MOULDER" entryId="3244-98f3-bb61-b9d3" primary="false" /><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /></categories></selection><selection id="pre5kh6" name="Hell Pit Abomination" entryId="64d8-f0c2-2319-a22e::375a-e09f-9459-5237" number="1" type="unit" from="entry"><profiles><profile id="6da4-76cb-213c-efa9" name="Hell Pit Abomination" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">D6+5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="52c3-f70b-e6aa-349" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Gnashing Teeth and Flailing Fists** is 8.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3c12-8517-ab19-918c" name="Avalanche of Flesh" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy **^^Infantry^^** unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, roll a dice for each model in the target unit. For each 5+, inflict 1 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="4564-ffd9-bca8-a9b" name="Regenerating Monstrosity" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D6)** this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="a747-2706-e6a2-5d71" name="Too Horrible to Die" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The first time this unit would be destroyed, before removing it from the battlefield, roll a dice and apply the corresponding effect:
**1 *Dead:*** This unit is destroyed.
**2-4 *The Rats Emerge:*** Roll a D3 for each enemy unit in combat with this unit. On a 2+, inflict an amount of mortal damage on that unit equal to the roll. Then, this unit is destroyed.
**5-6 *It's Alive!:*** This unit is not destroyed and any remaining damage points inflicted on it have no effect. Then, **Heal (D6)** this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="pr4b66" name="Hell Pit Abomination" entryId="64d8-f0c2-2319-a22e::304-f997-d8f0-b86a" number="1" type="model" from="entry"><selections><selection id="ptf0tr" name="Gnashing Teeth and Flailing Fists" entryId="64d8-f0c2-2319-a22e::e953-422f-e97e-ef3e" number="1" type="upgrade" from="entry"><profiles><profile id="58ec-c1b8-69f-62a1" name="Gnashing Teeth and Flailing Fists" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">13</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Infantry^^** (+1 Rend), Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="200" /></costs><categories><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="3244-98f3-bb61-b9d3" name="MOULDER" entryId="3244-98f3-bb61-b9d3" primary="false" /><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /></categories></selection><selection id="qcworsi" name="Doom-flayers" entryId="1dc6-90e9-4539-7fb4::c759-c695-2cf9-5d59" number="1" type="unit" from="entry"><profiles><profile id="24f-15cd-72b9-a002" name="Doom-flayers" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">2D6+3&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">4</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="8db-5631-e692-e07d" name="Whirling Doom" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this phase, pick an enemy unit within 1&quot; of it to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="qe67fgr" name="Doom-flayer" entryId="1dc6-90e9-4539-7fb4::9eb5-541e-7721-b935" number="2" type="model" from="entry"><selections><selection id="qea137bp" name="Whirling Blades" entryId="1dc6-90e9-4539-7fb4::36a9-eaef-18cd-9209" number="2" type="upgrade" from="entry"><profiles><profile id="ac77-cf8e-d991-60df" name="Whirling Blades" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2D6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Infantry^^** (+1 Rend), Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="da36-ed81-79fe-ca75" name="SKRYRE" entryId="da36-ed81-79fe-ca75" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /></categories></selection><selection id="r7k5p6r" name="Doomwheel" entryId="8525-3a5d-da38-1bbb::3971-7e19-a33d-c1a8" number="1" type="unit" from="entry"><profiles><profile id="111e-9c35-161c-959f" name="Doomwheel" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">2D6+7&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="5a42-da96-abc8-256b" name="Rolling Doom" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can move a distance up to its **^^Move^^** characteristic. This unit can pass through other models and the combat ranges of enemy units, but it cannot end that move in combat.
Then, pick up to 3 enemy units that this unit passed across during that move to be the targets. Roll a D3 for each target. On a 2+, inflict an amount of mortal damage on the target equal to the roll.
**Designer's Note:** *This unit can use this ability even if it is in combat.*</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Core^^**, **^^Move^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="r8mvwp" name="Doomwheel" entryId="8525-3a5d-da38-1bbb::3ad7-69c2-3222-2f4a" number="1" type="model" from="entry"><selections><selection id="r9nqzt8" name="Grinding Wheels" entryId="8525-3a5d-da38-1bbb::9499-7b36-f073-6480" number="1" type="upgrade" from="entry"><profiles><profile id="d706-d6cf-4222-4749" name="Grinding Wheels" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="r97eawx" name="Warp Bolts" entryId="8525-3a5d-da38-1bbb::90f5-5a2a-886f-ef9a" number="1" type="upgrade" from="entry"><profiles><profile id="1cfb-3d3a-99ae-9008" name="Warp Bolts" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">13&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">D6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /><category id="da36-ed81-79fe-ca75" name="SKRYRE" entryId="da36-ed81-79fe-ca75" primary="false" /></categories></selection><selection id="s1q5jkq" name="Plagueclaw" entryId="a16b-628e-56cf-c980::2eef-4222-6eaf-1e39" number="1" type="unit" from="entry"><profiles><profile id="ba99-23ff-6074-225a" name="Plagueclaw" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">3&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="239c-bd42-76bc-486b" name="Bubonic Barrage" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this unit uses a **^^Shoot^^** ability, if all of its attacks targeted the same enemy unit, after that ability has been resolved, roll a dice. If the result is equal to or less than the number of models in that enemy unit that were slain by attacks made by this unit's **Plagueclaw Catapult** this phase, that enemy unit has **^^Strike‑last^^** for the rest of the turn.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="s23yb5c" name="Plagueclaw" entryId="a16b-628e-56cf-c980::80fc-2b5-2421-83f2" number="1" type="model" from="entry"><selections><selection id="s3xvvtg" name="Crew's Teeth and Knives" entryId="a16b-628e-56cf-c980::8016-786f-5b1d-b324" number="1" type="upgrade" from="entry"><profiles><profile id="d7f3-54ec-b5d1-119a" name="Crew's Teeth and Knives" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">D6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159"></characteristic></characteristics></profile></profiles></selection><selection id="s3z23k" name="Plagueclaw Catapult" entryId="a16b-628e-56cf-c980::f5ca-cc0-3d69-78e4" number="1" type="upgrade" from="entry"><profiles><profile id="d05d-a2aa-53f9-620b" name="Plagueclaw Catapult" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">24&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D6</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Anti-**^^Infantry^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /><category id="e9fa-30a7-a728-b45e" name="PESTILENS" entryId="e9fa-30a7-a728-b45e" primary="false" /></categories></selection><selection id="sn6v5gl" name="Ratling Warpblaster" entryId="400f-c9f7-c20d-8316::6792-1e93-a367-95c8" number="1" type="unit" from="entry"><profiles><profile id="7357-6a95-73e5-1cc1" name="Ratling Warpblaster" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="5bf4-da9b-f1d6-e2a8" name="More-more Warpstone Bullets!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is within the combat range of a friendly **^^Skryre Hero^^**, this unit's **Hail of Warpstone Bullets** has an Attacks characteristic of 6D6+3 instead of 3D6+3 for the rest of the turn. However, for each unmodified hit roll of 1 for an attack made with this unit's **Hail of Warpstone Bullets**, inflict 1 mortal damage on this unit after the **^^Shoot^^** ability has been resolved.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="d11-9a61-13d0-4d8d" name="Overwhelming Fire" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to hit rolls for this unit's shooting attacks that target an enemy unit that has 10 or more models.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="so2k9l8" name="Ratling Warpblaster" entryId="400f-c9f7-c20d-8316::f94c-7b0-5185-522c" number="1" type="model" from="entry"><selections><selection id="spqs8f" name="Hail of Warpstone Bullets" entryId="400f-c9f7-c20d-8316::292e-430c-8c4a-924f" number="1" type="upgrade" from="entry"><profiles><profile id="daf7-4ef6-3c1e-2272" name="Hail of Warpstone Bullets" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">20&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3D6+3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Crit (Auto-wound)</characteristic></characteristics></profile></profiles></selection><selection id="sp527x6" name="Thrall-rats' Claws" entryId="400f-c9f7-c20d-8316::1110-e6bc-f609-75ee" number="1" type="upgrade" from="entry"><profiles><profile id="6af5-57fa-fc01-f4f3" name="Thrall-rats' Claws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /><category id="da36-ed81-79fe-ca75" name="SKRYRE" entryId="da36-ed81-79fe-ca75" primary="false" /></categories></selection><selection id="timeino" name="Warp Lightning Cannon" entryId="43d-4fcb-5d5c-c436::3133-1d09-96d0-9a9b" number="1" type="unit" from="entry"><profiles><profile id="450c-6744-b657-bdd7" name="Warp Lightning Cannon" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">3&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="1b71-65b9-467b-6e29" name="More-more Warp Lightning!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is within the combat range of a friendly **^^Skryre Hero^^**, add 6 to the Attacks characteristic of this unit's **Warp Lightning Blast** for the rest of the turn.
However, for each unmodified hit roll of 1 for an attack made with this unit's **Warp Lightning Blast**, inflict D3 mortal damage on this unit after the **^^Shoot^^** ability has been resolved.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="7df7-d366-bd68-a0d3" name="Warp Lightning Blast" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each attack made with this weapon in a single phase must target the same enemy unit. Each hit inflicts 1 mortal damage on the target and the attack sequence ends.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="tj63n15" name="Warp Lightning Cannon" entryId="43d-4fcb-5d5c-c436::d4eb-8213-9f6b-18c3" number="1" type="model" from="entry"><selections><selection id="tkls9or" name="Crew's Teeth and Knives" entryId="43d-4fcb-5d5c-c436::57e4-aa18-22d6-f99" number="1" type="upgrade" from="entry"><profiles><profile id="ef31-8459-f31a-4568" name="Crew's Teeth and Knives" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">D6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="tkve3si" name="Warp Lightning Blast" entryId="43d-4fcb-5d5c-c436::76bf-d9ef-3e8c-6314" number="1" type="upgrade" from="entry"><profiles><profile id="b048-a9d7-ab42-16d1" name="Warp Lightning Blast" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">20&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2D6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">⟝See Warp Lightning Blast ability⟞</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">⟝See Warp Lightning Blast ability⟞</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">⟝See Warp Lightning Blast ability⟞</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /><category id="da36-ed81-79fe-ca75" name="SKRYRE" entryId="da36-ed81-79fe-ca75" primary="false" /></categories></selection><selection id="uf3nv4n" name="Warp-Grinder" entryId="8659-2919-d1ca-2cd4::0a17-a47d-e51f-ea9a" number="1" type="unit" from="entry"><profiles><profile id="f2b9-600b-5090-3757" name="Warp-Grinder" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="3374-514d-f3b8-64e9" name="Tunnel Skulkers" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick this unit and up to 1 friendly non-**^^Monster Skaven^^** unit if those units have not been deployed.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up those units in reserve **in the tunnels below**. They have now been deployed.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="281d-94c9-cf58-7e62" name="Warp-ambush" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You can only use this ability if this unit is **in the tunnels below**.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice and pick one of the following effects.
• On a 4+, pick an enemy unit that is more than 6&quot; from all other enemy units. You can set up this unit on the battlefield in combat with that enemy unit and not in combat with any other enemy units. Then, if another friendly unit was set up **in the tunnels below** with the 'Tunnel Skulkers' ability, you can set up that unit wholly within 6&quot; of this unit, in combat with that enemy unit, and not in combat with any other enemy units.
• You can set up this unit anywhere on the battlefield more than 9&quot; from all enemy units. Then, if another friendly unit was set up **in the tunnels below** with the 'Tunnel Skulkers' ability, you can set up that unit wholly within 6&quot; of this unit and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="ug61b2j" name="Warp-Grinder" entryId="8659-2919-d1ca-2cd4::4dc0-0913-eba0-a181" number="1" type="model" from="entry"><selections><selection id="uhqx8k" name="Crew's Teeth and Knives" entryId="8659-2919-d1ca-2cd4::4f9e-4b6d-5db6-02ff" number="1" type="upgrade" from="entry"><profiles><profile id="9047-0870-fd9d-5b15" name="Crew's Teeth and Knives" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">D6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="uhml3bt" name="Warpstone Drill-fang" entryId="8659-2919-d1ca-2cd4::c28f-bc5e-7621-1c3f" number="1" type="upgrade" from="entry"><profiles><profile id="5e14-f3b2-382d-3748" name="Warpstone Drill-fang" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">D3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">3</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">5</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="da36-ed81-79fe-ca75" name="SKRYRE" entryId="da36-ed81-79fe-ca75" primary="false" /><category id="f7bc-b618-4b5d-2bae" entryId="f7bc-b618-4b5d-2bae" name="WAR MACHINE" primary="true" /></categories></selection></selections><categories><category name="HERO" id="gftyf3p" primary="false" entryId="6e72-1656-d554-528a" /><category name="INFANTRY" id="gft86u" primary="false" entryId="75d6-6995-dfcc-3898" /><category name="MONSTER" id="ggh3doo" primary="false" entryId="6d54-625c-d063-13e2" /><category name="WAR MACHINE" id="ggpjm4o" primary="false" entryId="f7bc-b618-4b5d-2bae" /><category name="CAVALRY" id="xdbwrqf" primary="false" entryId="926c-df8c-6841-d49e" /><category name="BEAST" id="xd801x" primary="false" entryId="b224-8c8e-ca93-9860" /><category name="Illegal Units" id="xdkp28g" primary="false" entryId="(Illegal Units)" /></categories></force></forces></force></forces></roster>