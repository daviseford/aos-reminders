<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<roster id="qyx2my" name="skv-001-all-units" battleScribeVersion="2.03" generatedBy="https://newrecruit.eu" gameSystemId="e51d-b1a3-75fc-dc3g" gameSystemName="Age of Sigmar 4.0" gameSystemRevision="98" xmlns="http://www.battlescribe.net/schema/rosterSchema"><costs><cost name="pts" typeId="points" value="8350" /></costs><costLimits><costLimit name="pts" typeId="points" value="0" /></costLimits><forces><force id="r75yuqr" name="✦ General's Handbook 2026-27" entryId="0151-9c5b-2f1e-32d4" catalogueId="231a-2a83-26f0-a718" catalogueRevision="50" catalogueName="Skaven"><selections><selection id="492w5lb" name="Allow Legends" entryId="7e59-2237-4890-a80a" number="1" type="upgrade" from="entry"><categories><category id="676-2b78-7bbf-ba9c" entryId="676-2b78-7bbf-ba9c" name="Configuration" primary="true" /></categories></selection><selection id="4fig699" name="Battle Traits: Skaven" entryId="706f-237e-b646-2049::8205-6284-a94b-5c93" number="1" type="upgrade" from="entry"><profiles><profile id="43a0-6a45-2db6-e6b7" name="Too Quick to Hit-hit" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">No mortal damage is inflicted on friendly **^^Skaven Infantry^^** and **^^Cavalry^^** units by **^^Retreat^^** abilities.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="7bc0-81f8-517-8512" name="The Lurking Vermintide" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Skaven^^** unit that has not been deployed.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up that unit in reserve **in the tunnels below**. It has now been deployed.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="4afc-1984-267c-d0e6" name="Splinters of the Vermindoom" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round (Army), Start of Battle Round</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You can use this ability if there are fewer than 3 friendly **Gnawholes** on the battlefield.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up a **Gnawhole** on the battlefield more than 9&quot; from all enemy units, more than 3&quot; from all objectives and more than 1&quot; from all other terrain features.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="7666-f02d-f4bb-b6df" name="Always Three Clawsteps Ahead" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Enemy Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly non-**^^Monster Skaven^^** unit that is not in combat and was not set up this turn to use this ability.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">That unit can use the 'Normal Move' ability as if it were your movement phase.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ecef-dcaf-c3d8-a942" name="Gnawhole Ambush" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Skaven^^** unit that is **in the tunnels below** to use this ability.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up that unit wholly within 6&quot; of a friendly **Gnawhole** and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><categories><category id="3360-1158-e879-9606" entryId="3360-1158-e879-9606" name="Reference" primary="true" /></categories></selection><selection id="s7nj5dq" name="Battle Formation" entryId="7282-bd59-2d5a-ec6f" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="4kres5m" name="Battle Formation" entryId="7282-bd59-2d5a-ec6f" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="s9sq5ch" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="4qej7v" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="sb828fq" name="Manifestation Lore" entryId="ccbd-e1e3-89db-861" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="4xrglx" name="Manifestation Lore" entryId="ccbd-e1e3-89db-861" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="seuhpsr" name="Prayer Lore" entryId="3e70-c7f6-9775-bee6" number="1" type="upgrade" from="entry"><selections><selection id="sel1p8d" name="Noxious Prayers" entryId="681d-5f0f-71c3-e914::845-9690-bc02-3e5" entryGroupId="681d-5f0f-71c3-e914::ebf2-4ec0-9d1d-3dce" number="1" type="upgrade" from="group" group="Prayer Lores"><selections><selection id="sg9ep16" name="Bile-torrent" entryId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::c372-c6f1-c401-3405" entryGroupId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::3334-b742-4447-2c69" number="1" type="upgrade" from="group" group="Noxious Prayers"><profiles><profile id="4d8c-ca04-b33-21b9" name="Bile-torrent" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Skaven Priest^^** to chant this prayer, pick a visible enemy unit within 13&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Roll a number of dice equal to the number of models in the target unit. For each 5+, inflict 1 mortal damage on the target. If the chanting roll was 8+, inflict 1 mortal damage on the target for each 4+ instead.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="sfjd6a" name="Filth-crust" entryId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::d5d6-ab98-cf12-9f18" entryGroupId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::3334-b742-4447-2c69" number="1" type="upgrade" from="group" group="Noxious Prayers"><profiles><profile id="f4dd-d5cd-fbbb-aa9" name="Filth-crust" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Skaven Priest^^** to chant this prayer, pick a visible friendly **^^Skaven Infantry^^** unit wholly within 13&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Add 1 to wound rolls for the target's combat attacks until the start of your next turn. In addition, if the chanting roll was 8+, the target's melee weapons have **Crit (Mortal)** until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="sgu2dxt" name="Rabid-tough" entryId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::45d2-e1aa-ed11-195d" entryGroupId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::3334-b742-4447-2c69" number="1" type="upgrade" from="group" group="Noxious Prayers"><profiles><profile id="df68-5cb3-fdcd-92c2" name="Rabid-tough" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Skaven Priest^^** to chant this prayer, pick a visible friendly **^^Skaven Infantry^^** unit wholly within 13&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Subtract 1 from wound rolls for attacks that target that unit until the start of your next turn. In addition, if the chanting roll was 8+, add 1 to save rolls for the target until the start of your next turn</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="54hoa7" name="Prayer Lore" entryId="3e70-c7f6-9775-bee6" number="1" type="upgrade" from="entry"><selections><selection id="542odfk" name="Noxious Prayers" entryId="681d-5f0f-71c3-e914::845-9690-bc02-3e5" entryGroupId="681d-5f0f-71c3-e914::ebf2-4ec0-9d1d-3dce" number="1" type="upgrade" from="group" group="Prayer Lores"><selections><selection id="55j6ni" name="Bile-torrent" entryId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::c372-c6f1-c401-3405" entryGroupId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::3334-b742-4447-2c69" number="1" type="upgrade" from="group" group="Noxious Prayers"><profiles><profile id="4d8c-ca04-b33-21b9" name="Bile-torrent" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Skaven Priest^^** to chant this prayer, pick a visible enemy unit within 13&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Roll a number of dice equal to the number of models in the target unit. For each 5+, inflict 1 mortal damage on the target. If the chanting roll was 8+, inflict 1 mortal damage on the target for each 4+ instead.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="55zj7xm" name="Filth-crust" entryId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::d5d6-ab98-cf12-9f18" entryGroupId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::3334-b742-4447-2c69" number="1" type="upgrade" from="group" group="Noxious Prayers"><profiles><profile id="f4dd-d5cd-fbbb-aa9" name="Filth-crust" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Skaven Priest^^** to chant this prayer, pick a visible friendly **^^Skaven Infantry^^** unit wholly within 13&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Add 1 to wound rolls for the target's combat attacks until the start of your next turn. In addition, if the chanting roll was 8+, the target's melee weapons have **Crit (Mortal)** until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="55cr7bg" name="Rabid-tough" entryId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::45d2-e1aa-ed11-195d" entryGroupId="681d-5f0f-71c3-e914::eedd-1e9a-4f46-50fb::3334-b742-4447-2c69" number="1" type="upgrade" from="group" group="Noxious Prayers"><profiles><profile id="df68-5cb3-fdcd-92c2" name="Rabid-tough" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Skaven Priest^^** to chant this prayer, pick a visible friendly **^^Skaven Infantry^^** unit wholly within 13&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Subtract 1 from wound rolls for attacks that target that unit until the start of your next turn. In addition, if the chanting roll was 8+, add 1 to save rolls for the target until the start of your next turn</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="shpk9c4" name="Spell Lore" entryId="2514-59e9-bb0e-48ce" number="1" type="upgrade" from="entry"><selections><selection id="shmqlq" name="Lore of Ruin" entryId="88d0-e430-f8be-2977::686-85bc-5efd-b9f1" entryGroupId="88d0-e430-f8be-2977::5b1f-2df0-bfaa-f649" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="si1ex4l" name="Skitterleap" entryId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::5c2e-77ab-1feb-b879" entryGroupId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::dea7-0648-cf56-54e2" number="1" type="upgrade" from="group" group="Lore of Ruin"><profiles><profile id="7580-d73f-4dda-cbfa" name="Skitterleap" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Skaven Wizard^^** to cast this spell, pick a visible friendly **^^Skaven Hero^^** wholly within 13&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Remove the target from the battlefield and set it up again on the battlefield more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection><selection id="sibd26" name="Warpgale" entryId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::ab43-d75c-7e9f-fa4d" entryGroupId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::dea7-0648-cf56-54e2" number="1" type="upgrade" from="group" group="Lore of Ruin"><profiles><profile id="245b-3151-8e02-551f" name="Warpgale" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Skaven Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">The target has **^^Strike-last^^** for the rest of the turn</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute></attributes></profile></profiles></selection><selection id="si19ous" name="Wither" entryId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::ed65-28d5-efda-37af" entryGroupId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::dea7-0648-cf56-54e2" number="1" type="upgrade" from="group" group="Lore of Ruin"><profiles><profile id="eb4e-6a9d-87cb-b436" name="Wither" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Skaven Wizard^^** to cast this spell, pick a visible enemy unit within 13&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict D3 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="5c2vzms" name="Spell Lore" entryId="2514-59e9-bb0e-48ce" number="1" type="upgrade" from="entry"><selections><selection id="5ce9qhk" name="Lore of Ruin" entryId="88d0-e430-f8be-2977::686-85bc-5efd-b9f1" entryGroupId="88d0-e430-f8be-2977::5b1f-2df0-bfaa-f649" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="5dg6xra" name="Skitterleap" entryId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::5c2e-77ab-1feb-b879" entryGroupId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::dea7-0648-cf56-54e2" number="1" type="upgrade" from="group" group="Lore of Ruin"><profiles><profile id="7580-d73f-4dda-cbfa" name="Skitterleap" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Skaven Wizard^^** to cast this spell, pick a visible friendly **^^Skaven Hero^^** wholly within 13&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Remove the target from the battlefield and set it up again on the battlefield more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection><selection id="5dcclkb" name="Warpgale" entryId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::ab43-d75c-7e9f-fa4d" entryGroupId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::dea7-0648-cf56-54e2" number="1" type="upgrade" from="group" group="Lore of Ruin"><profiles><profile id="245b-3151-8e02-551f" name="Warpgale" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Skaven Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">The target has **^^Strike-last^^** for the rest of the turn</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute></attributes></profile></profiles></selection><selection id="5dwbesh" name="Wither" entryId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::ed65-28d5-efda-37af" entryGroupId="88d0-e430-f8be-2977::b1f6-8f0b-da99-0d0d::dea7-0648-cf56-54e2" number="1" type="upgrade" from="group" group="Lore of Ruin"><profiles><profile id="eb4e-6a9d-87cb-b436" name="Wither" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Skaven Wizard^^** to cast this spell, pick a visible enemy unit within 13&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict D3 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="sjmmlg" name="Gnawhole" entryId="45ff-e8f5-da76-16b2::a177-dc85-8fd5-3509" number="1" type="unit" from="entry"><rules><rule id="a2f0-cc51-6f93-f81e" name="Gnawhole" hidden="false"><description>**The following universal terrain abilities apply to this terrain feature (Terrain, 1.2):
Cover**</description></rule></rules><profiles><profile id="6fab-6d2e-bb4f-7588" name="Volatile Ground" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Models can pass through this terrain feature but cannot be set up on or end moves on any part of this terrain feature.
Each time an enemy unit ends a move that passed through or across this terrain feature, roll a D3. On a 2+, inflict an amount of mortal damage on that unit equal to the roll.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="507e-2e1a-b28-78b5" name="Gnawhole" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic></characteristics></profile><profile id="a81b-3802-2d67-c5a7" name="Tunnels Through Reality" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Skaven^^** unit that is not in combat and is wholly within 6&quot; of this terrain feature to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove the target from the battlefield and set it up again wholly within 6&quot; of another friendly **Gnawhole** and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="9d13-1e94-8089-8cac" name="The Endless Vermintide" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" from="entry"><characteristics><characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Once Per Turn (Army), End of Your Turn</characteristic><characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic><characteristic name="Declare" typeId="b77f-7548-840e-c086">Pick a friendly non-**^^Hero Skaven Infantry^^** unit that has been destroyed to be the target.</characteristic><characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Set up a replacement unit with half the number of models from the target unit (rounding up) wholly within 6&quot; of a friendly **Gnawhole** and more than 3&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="445d-f443-5448-e7ce"></characteristic></characteristics><attributes><attribute name="Color" typeId="5c69-e4b9-19bc-e801">Purple</attribute><attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute><attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8" /></attributes></profile></profiles><categories><category id="cdd6-ffa1-9b32-4cb8" entryId="cdd6-ffa1-9b32-4cb8" name="FACTION TERRAIN" primary="true" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="cce6-9e5a-dd33-a755" name="SKAVEN" entryId="cce6-9e5a-dd33-a755" primary="false" /></categories></selection><selection id="5j9ukhf" name="Gnawhole" entryId="45ff-e8f5-da76-16b2::a177-dc85-8fd5-3509" number="1" type="unit" from="entry"><rules><rule id="a2f0-cc51-6f93-f81e" name="Gnawhole" hidden="false"><description>**The following universal terrain abilities apply to this terrain feature (Terrain, 1.2):
Cover**</description></rule></rules><profiles><profile id="6fab-6d2e-bb4f-7588" name="Volatile Ground" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Models can pass through this terrain feature but cannot be set up on or end moves on any part of this terrain feature.
