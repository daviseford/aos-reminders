<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<roster id="ofv9w6a" name="idk-001-all-units" battleScribeVersion="2.03" generatedBy="https://newrecruit.eu" gameSystemId="e51d-b1a3-75fc-dc3g" gameSystemName="Age of Sigmar 4.0" gameSystemRevision="98" xmlns="http://www.battlescribe.net/schema/rosterSchema"><costs><cost name="pts" typeId="points" value="3390" /></costs><costLimits><costLimit name="pts" typeId="points" value="0" /></costLimits><forces><force id="otmlpb" name="✦ General's Handbook 2026-27" entryId="0151-9c5b-2f1e-32d4" catalogueId="40a4-1c1c-8a00-bb65" catalogueRevision="41" catalogueName="Idoneth Deepkin"><selections><selection id="1mkcvbt" name="Allow Legends" entryId="7e59-2237-4890-a80a" number="1" type="upgrade" from="entry"><categories><category id="676-2b78-7bbf-ba9c" entryId="676-2b78-7bbf-ba9c" name="Configuration" primary="true" /></categories></selection><selection id="1q5e0tn" name="Battle Traits: Idoneth Deepkin" entryId="44d6-5b9f-c32b-630e::fedc-c96f-444c-4021" number="1" type="upgrade" from="entry"><rules><rule id="4887-96e1-fd55-e0aa" hidden="false"><description>**Designer's Note:** *Once per battle round, you can use a* **^^Tidal^^** *ability from either the Tides of the Sea or the Tides of the Storm. If you do so, you unlock the next ability in the same set in the next battle round. You can switch sets at any time, though this resets your progress. For example, if you use the 'Concealing Tide' ability in the first battle round, in the second, you can either use 'Swift Tide' or switch sets and use 'Unpredictable Tide'.*</description></rule></rules><profiles><profile id="be04-5479-f37e-a203" name="Concealing Tide" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round, Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You can only use this ability if you did not use it in the previous battle round and you have not used any other **^^Tidal^^** abilities this round.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle round, subtract 1 from hit rolls for attacks that target friendly **^^Idoneth Deepkin^^** units that did not use any **^^Charge^^** abilities in the same turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Tidal^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="0656-4279-7aec-d19b" name="Swift Tide" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round, Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You can only use this ability if you used the 'Concealing Tide' ability in the previous battle round and you have not used any other **^^Tidal^^** abilities this round.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle round, friendly **^^Idoneth Deepkin^^** units can use **^^Run^^** abilities and still use **^^Shoot^^** and/or **^^Charge^^** abilities later in the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Tidal^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa">be04-5479-f37e-a203</attribute></attributes></profile><profile id="12ed-8fb6-93d4-18ac" name="Sea's Embrace" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round, Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You can only use this ability if you used the 'Swift Tide' ability in the previous battle round and you have not used any other **^^Tidal^^** abilities this round.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Friendly **^^Idoneth Deepkin^^** units have **^^Strike-first^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Tidal^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa">0656-4279-7aec-d19b</attribute></attributes></profile><profile id="ad82-dde8-cdb2-9eb5" name="Unpredictable Tide" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round, Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You can only use this ability if you did not use it in the previous battle round and you have not used any other **^^Tidal^^** abilities this round. Pick a friendly **^^Idoneth Deepkin^^** unit that is not in combat to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove the target from the battlefield and set it up again wholly within 7&quot; of a battlefield edge and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Tidal^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="6721-3e17-45cb-be45" name="Inexorable Tide" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round, Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You can only use this ability if you used the 'Unpredictable Tide' ability in the previous battle round and you have not used any other **^^Tidal^^** abilities this round.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Subtract 1 from the Rend characteristic of weapons used for attacks that target friendly **^^Idoneth Deepkin^^** units for the rest of the battle round.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Tidal^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa">ad82-dde8-cdb2-9eb5</attribute></attributes></profile><profile id="5c7e-29d4-002d-d8f9" name="Storm's Wrath" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round, Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You can only use this ability if you used the 'Inexorable Tide' ability in the previous battle round and you have not used any other **^^Tidal^^** abilities this round.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Friendly **^^Idoneth Deepkin^^** units' melee weapons have **Crit (Mortal)** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Tidal^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa">6721-3e17-45cb-be45</attribute></attributes></profile><profile id="1fbe-750e-1ee9-8f54" name="Twin Tides" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn(Army), Reaction: You declared an Attack ability for a friendly **^^Akhelian^^** unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a visible friendly **^^Namarti^^** unit that has not used an **^^Attack^^** ability this phase to be the target.
• If this unit used a **^^Shoot^^** ability, immediately after the **^^Shoot^^** ability used by this unit has been resolved, the target can be picked to use a **^^Shoot^^** ability as if it were your shooting phase.
• If this unit used a **^^Fight^^** ability, immediately after the **^^Fight^^** ability used by this unit has been resolved, the target can be picked to use a **^^Fight^^** ability. If the target does so, for the rest of the phase, add 1 to the Attacks characteristic of its weapons but all of its attacks must target enemy units that had any damage points allocated to it this phase by this unit's attacks.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b">The friendly **^^Akhelian^^** unit using that **^^Attack^^** ability.</characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><categories><category id="3360-1158-e879-9606" entryId="3360-1158-e879-9606" name="Reference" primary="true" /></categories></selection><selection id="phz77id" name="Battle Formation" entryId="265a-3eb9-64b5-5dd8" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="1urx2i" name="Battle Formation" entryId="265a-3eb9-64b5-5dd8" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="pmach2h" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="20gc33" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="pobqrk9" name="Manifestation Lore" entryId="e4c-4af1-3d18-34c5" number="1" type="upgrade" from="entry"><selections><selection id="prxoltk" name="Lore of the Abyss" entryId="1d7d-152b-0c3d-03b9::f144-32f5-419c-ce4f" entryGroupId="1d7d-152b-0c3d-03b9::177b-58ce-7de9-a97d" number="1" type="upgrade" from="group" group="Manifestation Lores"><selections><selection id="ps96pr" name="Abyssal Tendril" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::3119-d5b8-b327-5d37::dab7-b1f5-b4ae-ecba" entryGroupId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::d4f7-919b-4440-9992" number="1" type="unit" from="group" group="Lore of the Abyss"><profiles><profile id="0857-d5bb-f988-fc8b" name="Abyssal Tendril" hidden="false" typeId="1287-3a-9799-7e40" typeName="Manifestation" from="entry"><characteristics><characteristic name="Move" typeId="c28a-6000-2a0b-e7cf">-</characteristic><characteristic name="Health" typeId="d1b9-3068-515-131e">6</characteristic><characteristic name="Save" typeId="80c7-7691-b6ed-d6a6">6+</characteristic><characteristic name="Banishment" typeId="97a2-d412-9ac-6a37">6+</characteristic></characteristics><attributes><attribute name="Base Size" typeId="50db-066e-a3e7-696f" /></attributes></profile><profile id="3998-27ac-3099-5966" name="Crushing Coil" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to hit rolls for attacks made by friendly **^^Idoneth Deepkin Manifestations^^** that target an **ensnared** enemy unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="6024-5e68-fd77-b0d2" name="Watery Clutch" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this **^^Manifestation^^** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. If the roll exceeds the target's Health characteristic, the target is **ensnared** for the rest of the turn.
A unit cannot use commands while it is **ensnared**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="ptze2a" name="Freezing Grasp" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::3119-d5b8-b327-5d37::e939-b6ee-fafd-13d8" number="1" type="upgrade" from="entry"><profiles><profile id="5e55-299f-c342-2a2c" name="Freezing Grasp" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections><categories><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="bff0-8be9-719f-4afc" name="MANIFESTATION" entryId="bff0-8be9-719f-4afc" primary="false" /><category id="e7bc-543-4076-553c" name="ENDLESS SPELL" entryId="e7bc-543-4076-553c" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="a1b1-39d1-f6ed-bf2" name="INCARNATE" entryId="a1b1-39d1-f6ed-bf2" primary="false" /></categories></selection><selection id="psy5pt7" name="Incarnate of the Deep" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::8eb9-a2a0-5cbc-c8c5::57e2-8574-3a89-5b81" entryGroupId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::d4f7-919b-4440-9992" number="1" type="unit" from="group" group="Lore of the Abyss"><profiles><profile id="93ea-b16d-77bd-28de" name="Incarnate of the Deep" hidden="false" typeId="1287-3a-9799-7e40" typeName="Manifestation" from="entry"><characteristics><characteristic name="Move" typeId="c28a-6000-2a0b-e7cf">10&quot;</characteristic><characteristic name="Health" typeId="d1b9-3068-515-131e">12</characteristic><characteristic name="Save" typeId="80c7-7691-b6ed-d6a6">4+</characteristic><characteristic name="Banishment" typeId="97a2-d412-9ac-6a37">9+</characteristic></characteristics><attributes><attribute name="Base Size" typeId="50db-066e-a3e7-696f" /></attributes></profile><profile id="32a1-55c0-e4b3-fe71" name="Surrender to the Sea" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When this **^^Manifestation^^** is removed from play, each friendly **Abyssal Tendril** on the battlefield is automatically removed from play.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="7496-ba44-98bd-da2f" name="Grasping Tendrils" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if it is your turn.
On a 4+:
• You can remove 1 friendly **Abyssal Tendril** from the battlefield.
• If there are fewer than 2 friendly Abyssal Tendrils on the battlefield, you can set up an **Abyssal Tendril** wholly within 9&quot; of this **^^Manifestation^^**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="cf59-e609-1520-5a5c" name="Wild Form" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this **^^Manifestation^^** is targeted by the 'Banish Manifestation' ability, if it would be banished, it is not banished. Instead, allocate 6 damage points to it (ward rolls cannot be made for those damage points).</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="pvo1reg" name="Crushing Maw and Scything Waves" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::8eb9-a2a0-5cbc-c8c5::ab1d-68aa-60cb-7c84" number="1" type="upgrade" from="entry"><profiles><profile id="f64a-41b0-7923-5888" name="Crushing Maw and Scything Waves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Faction Terrain^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections><categories><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="bff0-8be9-719f-4afc" name="MANIFESTATION" entryId="bff0-8be9-719f-4afc" primary="false" /><category id="e7bc-543-4076-553c" name="ENDLESS SPELL" entryId="e7bc-543-4076-553c" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="a1b1-39d1-f6ed-bf2" name="INCARNATE" entryId="a1b1-39d1-f6ed-bf2" primary="false" /></categories></selection><selection id="psf6sk7" name="Summon Incarnate of the Deep" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::4001-3a55-7fc6-5fe1" entryGroupId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::d4f7-919b-4440-9992" number="1" type="upgrade" from="group" group="Lore of the Abyss"><profiles><profile id="a3c1-5eef-3417-080f" name="Summon Incarnate of the Deep" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">8</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">If there is not a friendly **Incarnate of the Deep** endless spell on the battlefield, pick a friendly **^^Idoneth Deepkin Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Set up an **Incarnate of the Deep** wholly within 12&quot; of the caster, visible to them and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Summon^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="26an0be" name="Manifestation Lore" entryId="e4c-4af1-3d18-34c5" number="1" type="upgrade" from="entry"><selections><selection id="27d1d2k" name="Lore of the Abyss" entryId="1d7d-152b-0c3d-03b9::f144-32f5-419c-ce4f" entryGroupId="1d7d-152b-0c3d-03b9::177b-58ce-7de9-a97d" number="1" type="upgrade" from="group" group="Manifestation Lores"><selections><selection id="286j50s" name="Abyssal Tendril" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::3119-d5b8-b327-5d37::dab7-b1f5-b4ae-ecba" entryGroupId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::d4f7-919b-4440-9992" number="1" type="unit" from="group" group="Lore of the Abyss"><profiles><profile id="0857-d5bb-f988-fc8b" name="Abyssal Tendril" hidden="false" typeId="1287-3a-9799-7e40" typeName="Manifestation" from="entry"><characteristics><characteristic name="Move" typeId="c28a-6000-2a0b-e7cf">-</characteristic><characteristic name="Health" typeId="d1b9-3068-515-131e">6</characteristic><characteristic name="Save" typeId="80c7-7691-b6ed-d6a6">6+</characteristic><characteristic name="Banishment" typeId="97a2-d412-9ac-6a37">6+</characteristic></characteristics><attributes><attribute name="Base Size" typeId="50db-066e-a3e7-696f" /></attributes></profile><profile id="3998-27ac-3099-5966" name="Crushing Coil" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to hit rolls for attacks made by friendly **^^Idoneth Deepkin Manifestations^^** that target an **ensnared** enemy unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="6024-5e68-fd77-b0d2" name="Watery Clutch" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this **^^Manifestation^^** to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. If the roll exceeds the target's Health characteristic, the target is **ensnared** for the rest of the turn.
A unit cannot use commands while it is **ensnared**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="29fz02s" name="Freezing Grasp" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::3119-d5b8-b327-5d37::e939-b6ee-fafd-13d8" number="1" type="upgrade" from="entry"><profiles><profile id="5e55-299f-c342-2a2c" name="Freezing Grasp" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections><categories><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="bff0-8be9-719f-4afc" name="MANIFESTATION" entryId="bff0-8be9-719f-4afc" primary="false" /><category id="e7bc-543-4076-553c" name="ENDLESS SPELL" entryId="e7bc-543-4076-553c" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="a1b1-39d1-f6ed-bf2" name="INCARNATE" entryId="a1b1-39d1-f6ed-bf2" primary="false" /></categories></selection><selection id="286nvkm" name="Incarnate of the Deep" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::8eb9-a2a0-5cbc-c8c5::57e2-8574-3a89-5b81" entryGroupId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::d4f7-919b-4440-9992" number="1" type="unit" from="group" group="Lore of the Abyss"><profiles><profile id="93ea-b16d-77bd-28de" name="Incarnate of the Deep" hidden="false" typeId="1287-3a-9799-7e40" typeName="Manifestation" from="entry"><characteristics><characteristic name="Move" typeId="c28a-6000-2a0b-e7cf">10&quot;</characteristic><characteristic name="Health" typeId="d1b9-3068-515-131e">12</characteristic><characteristic name="Save" typeId="80c7-7691-b6ed-d6a6">4+</characteristic><characteristic name="Banishment" typeId="97a2-d412-9ac-6a37">9+</characteristic></characteristics><attributes><attribute name="Base Size" typeId="50db-066e-a3e7-696f" /></attributes></profile><profile id="32a1-55c0-e4b3-fe71" name="Surrender to the Sea" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When this **^^Manifestation^^** is removed from play, each friendly **Abyssal Tendril** on the battlefield is automatically removed from play.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="7496-ba44-98bd-da2f" name="Grasping Tendrils" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if it is your turn.
On a 4+:
• You can remove 1 friendly **Abyssal Tendril** from the battlefield.
• If there are fewer than 2 friendly Abyssal Tendrils on the battlefield, you can set up an **Abyssal Tendril** wholly within 9&quot; of this **^^Manifestation^^**.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="cf59-e609-1520-5a5c" name="Wild Form" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this **^^Manifestation^^** is targeted by the 'Banish Manifestation' ability, if it would be banished, it is not banished. Instead, allocate 6 damage points to it (ward rolls cannot be made for those damage points).</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="29f7k0l" name="Crushing Maw and Scything Waves" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::8eb9-a2a0-5cbc-c8c5::ab1d-68aa-60cb-7c84" number="1" type="upgrade" from="entry"><profiles><profile id="f64a-41b0-7923-5888" name="Crushing Maw and Scything Waves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Faction Terrain^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections><categories><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="bff0-8be9-719f-4afc" name="MANIFESTATION" entryId="bff0-8be9-719f-4afc" primary="false" /><category id="e7bc-543-4076-553c" name="ENDLESS SPELL" entryId="e7bc-543-4076-553c" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="a1b1-39d1-f6ed-bf2" name="INCARNATE" entryId="a1b1-39d1-f6ed-bf2" primary="false" /></categories></selection><selection id="286axql" name="Summon Incarnate of the Deep" entryId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::4001-3a55-7fc6-5fe1" entryGroupId="1d7d-152b-0c3d-03b9::9ed5-0deb-537f-60b5::d4f7-919b-4440-9992" number="1" type="upgrade" from="group" group="Lore of the Abyss"><profiles><profile id="a3c1-5eef-3417-080f" name="Summon Incarnate of the Deep" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">8</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">If there is not a friendly **Incarnate of the Deep** endless spell on the battlefield, pick a friendly **^^Idoneth Deepkin Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Set up an **Incarnate of the Deep** wholly within 12&quot; of the caster, visible to them and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Summon^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="pyvk3b" name="Spell Lore" entryId="dd2a-9dcb-6ca-87e4" number="1" type="upgrade" from="entry"><selections><selection id="pyq4cvp" name="Lore of the Deeps" entryId="b9dc-e715-bab3-a633::26a7-5dac-2100-34ac" entryGroupId="b9dc-e715-bab3-a633::cb9f-db01-c709-20a1" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="pzkvwdj" name="Counter-current" entryId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::b097-945b-1126-f189" entryGroupId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::53e8-e844-ab93-2ca5" number="1" type="upgrade" from="group" group="Lore of the Deeps"><profiles><profile id="778c-2469-85cc-1214" name="Counter-current" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Idoneth Deepkin Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, halve run rolls and charge rolls for the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection><selection id="pzti09" name="Pressure of the Deep" entryId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::88f7-f0dd-c017-8e5d" entryGroupId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::53e8-e844-ab93-2ca5" number="1" type="upgrade" from="group" group="Lore of the Deeps"><profiles><profile id="d6cf-bfd1-e0eb-86fb" name="Pressure of the Deep" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Idoneth Deepkin Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Roll a dice for each model in the target unit. For each 5+, inflict 1 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection><selection id="pzgqm6" name="Steed of Tides" entryId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::64d7-3841-e28f-63ed" entryGroupId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::53e8-e844-ab93-2ca5" number="1" type="upgrade" from="group" group="Lore of the Deeps"><profiles><profile id="87cb-8bfd-ab34-9bc3" name="Steed of Tides" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Idoneth Deepkin Wizard^^** to cast this spell, pick a visible friendly **^^Idoneth Deepkin^^** unit wholly within 12&quot; of them and not in combat to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Remove the target from the battlefield and set it up again on the battlefield more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="2fpuavb" name="Spell Lore" entryId="dd2a-9dcb-6ca-87e4" number="1" type="upgrade" from="entry"><selections><selection id="2f6f37f" name="Lore of the Deeps" entryId="b9dc-e715-bab3-a633::26a7-5dac-2100-34ac" entryGroupId="b9dc-e715-bab3-a633::cb9f-db01-c709-20a1" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="2gafytpj" name="Counter-current" entryId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::b097-945b-1126-f189" entryGroupId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::53e8-e844-ab93-2ca5" number="1" type="upgrade" from="group" group="Lore of the Deeps"><profiles><profile id="778c-2469-85cc-1214" name="Counter-current" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Idoneth Deepkin Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, halve run rolls and charge rolls for the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection><selection id="2gdme4o" name="Pressure of the Deep" entryId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::88f7-f0dd-c017-8e5d" entryGroupId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::53e8-e844-ab93-2ca5" number="1" type="upgrade" from="group" group="Lore of the Deeps"><profiles><profile id="d6cf-bfd1-e0eb-86fb" name="Pressure of the Deep" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Idoneth Deepkin Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Roll a dice for each model in the target unit. For each 5+, inflict 1 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection><selection id="2gu8vh" name="Steed of Tides" entryId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::64d7-3841-e28f-63ed" entryGroupId="b9dc-e715-bab3-a633::6d8b-665a-c987-1c02::53e8-e844-ab93-2ca5" number="1" type="upgrade" from="group" group="Lore of the Deeps"><profiles><profile id="87cb-8bfd-ab34-9bc3" name="Steed of Tides" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Idoneth Deepkin Wizard^^** to cast this spell, pick a visible friendly **^^Idoneth Deepkin^^** unit wholly within 12&quot; of them and not in combat to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Remove the target from the battlefield and set it up again on the battlefield more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="q1yo3ne" name="Gloomtide Shipwreck" entryId="cf8c-d2d8-cc3f-cbe1::cdd1-4012-45ab-ed95" number="1" type="unit" from="entry"><rules><rule id="c642-2873-3610-8709" name="Gloomtide Shipwreck" hidden="false"><description>**The following universal terrain abilities apply to this terrain feature (Terrain, 1.2):
Cover, Obscuring**</description></rule></rules><profiles><profile id="85e9-b38c-d016-840b" name="Rise from the Depths" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This ability must be used instead of the 'Deploy Faction Terrain' ability.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up this faction terrain either as 1 terrain feature consisting of 2 scenery pieces (that must be set up within 3&quot; of each other) or as 2 separate terrain features. Set up each terrain feature wholly within friendly territory and more than 3&quot; from all objectives and other terrain features. After you have done so, it has been deployed.
If this faction terrain is set up as 1 terrain feature consisting of 2 scenery pieces, it has a Health characteristic of 14 instead of 7.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy Terrain^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bab-4909-2439-abf3" name="Gloomtide Shipwreck" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic></characteristics></profile><profile id="f97b-a741-5349-16e4" name="Guardians of the Deep" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to save rolls for friendly **^^Idoneth Deepkin Infantry^^** and **^^Cavalry^^** units while they are wholly within 6&quot; of this terrain feature.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="e135-2afc-f787-00c9" name="Phantasmal Ruin" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Models can pass through this terrain feature but cannot be set up on or end moves on any part of this terrain feature.
Each time an enemy unit ends a move that passed through or across this terrain feature, roll a D3. On a 2+, inflict an amount of mortal damage on that unit equal to the roll.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="cdd6-ffa1-9b32-4cb8" entryId="cdd6-ffa1-9b32-4cb8" name="FACTION TERRAIN" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /></categories></selection><selection id="2peio2m" name="Gloomtide Shipwreck" entryId="cf8c-d2d8-cc3f-cbe1::cdd1-4012-45ab-ed95" number="1" type="unit" from="entry"><rules><rule id="c642-2873-3610-8709" name="Gloomtide Shipwreck" hidden="false"><description>**The following universal terrain abilities apply to this terrain feature (Terrain, 1.2):
Cover, Obscuring**</description></rule></rules><profiles><profile id="85e9-b38c-d016-840b" name="Rise from the Depths" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This ability must be used instead of the 'Deploy Faction Terrain' ability.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up this faction terrain either as 1 terrain feature consisting of 2 scenery pieces (that must be set up within 3&quot; of each other) or as 2 separate terrain features. Set up each terrain feature wholly within friendly territory and more than 3&quot; from all objectives and other terrain features. After you have done so, it has been deployed.
If this faction terrain is set up as 1 terrain feature consisting of 2 scenery pieces, it has a Health characteristic of 14 instead of 7.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy Terrain^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bab-4909-2439-abf3" name="Gloomtide Shipwreck" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic></characteristics></profile><profile id="f97b-a741-5349-16e4" name="Guardians of the Deep" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to save rolls for friendly **^^Idoneth Deepkin Infantry^^** and **^^Cavalry^^** units while they are wholly within 6&quot; of this terrain feature.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="e135-2afc-f787-00c9" name="Phantasmal Ruin" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Models can pass through this terrain feature but cannot be set up on or end moves on any part of this terrain feature.
Each time an enemy unit ends a move that passed through or across this terrain feature, roll a D3. On a 2+, inflict an amount of mortal damage on that unit equal to the roll.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="cdd6-ffa1-9b32-4cb8" entryId="cdd6-ffa1-9b32-4cb8" name="FACTION TERRAIN" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /></categories></selection></selections><costs><cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="1" /></costs><categories><category name="Configuration" id="9sf2vi7" primary="false" entryId="676-2b78-7bbf-ba9c" /><category name="Reference" id="9s69phr" primary="false" entryId="3360-1158-e879-9606" /><category name="Army Composition" id="owm2zzrs" primary="false" entryId="ac97-b27c-7e35-7ab9" /><category name="FACTION TERRAIN" id="owaspvj" primary="false" entryId="cdd6-ffa1-9b32-4cb8" /><category name="Illegal Units" id="0x2vuo8" primary="false" entryId="(Illegal Units)" /></categories><forces><force id="hmd3tzg" name="Auxillary Units" entryId="6084-3baa-f00b-ac0a::8732-47c4-9f1c-e71e" catalogueId="40a4-1c1c-8a00-bb65" catalogueRevision="41" catalogueName="Idoneth Deepkin"><selections><selection id="2vlamf5" name="Akhelian King" entryId="7b37-fd79-ec14-532f::1d8e-2553-5bf3-901b" number="1" type="unit" from="entry"><profiles><profile id="d8cd-fae7-4449-6baf" name="Akhelian King" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="df2f-c342-ce81-6eb9" name="Wave Rider" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this phase, pick an enemy unit within 1&quot; of it to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. On a 2+:
• Inflict an amount of mortal damage on the target equal to the roll.
• Add 1 to the Rend characteristic of this unit's **Akhelian Royal Weapons** for attacks that target that enemy unit for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="b5af-fe01-6e8c-7afd" name="Crest of the Wave" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit charged this turn, add 1 to the Rend characteristic of melee weapons used by other friendly **^^Idoneth Deepkin^^** units for attacks that target enemy units in combat with this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="2woi6l9" name="Akhelian King" entryId="7b37-fd79-ec14-532f::c1e1-276d-d1f7-a5c9" number="1" type="model" from="entry"><selections><selection id="334y7c8" name="Akhelian Royal Weapons" entryId="7b37-fd79-ec14-532f::ea8f-3bb9-406c-d3b1" number="1" type="upgrade" from="entry"><profiles><profile id="87-2598-5aa9-b44b" name="Akhelian Royal Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="33a52np" name="Deepmare's Fangs, Talons and Lashing Tails" entryId="7b37-fd79-ec14-532f::415a-6588-e1c-37fd" number="1" type="upgrade" from="entry"><profiles><profile id="fd90-c53e-8662-4fc6" name="Deepmare's Fangs, Talons and Lashing Tails" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="140" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="926c-df8c-6841-d49e" name="CAVALRY" entryId="926c-df8c-6841-d49e" primary="false" /><category id="108a-4ad6-bb90-a5ea" name="AKHELIAN" entryId="108a-4ad6-bb90-a5ea" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /></categories></selection><selection id="3caht2t" name="Akhelian Thrallmaster" entryId="1d40-88fc-5d08-15b0::8b16-dadd-dd26-1c6d" number="1" type="unit" from="entry"><profiles><profile id="9250-30c6-d49e-210f" name="Akhelian Thrallmaster" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="288-aa7c-ea43-2b67" name="Thrallmaster" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Fight^^** ability for this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a friendly **Namarti Thralls** unit that has not used a **^^Fight^^** ability this turn and is within this unit's combat range to be the target. The target can be picked to use a **^^Fight^^** ability immediately after the **^^Fight^^** ability used by this unit has been resolved.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="25-a26-e82a-5d1a" name="Akhelian Insights" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Melee weapons used by friendly **^^Namarti^^** units have **Crit (2 Hits)** while they are wholly within 12&quot; of this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="3dvzmli" name="Akhelian Thrallmaster" entryId="1d40-88fc-5d08-15b0::b228-f5df-8575-adeb" number="1" type="model" from="entry"><selections><selection id="3hbp64l" name="Esoteric Weapons" entryId="1d40-88fc-5d08-15b0::a352-a9f-80ea-ccae" number="1" type="upgrade" from="entry"><profiles><profile id="3092-713d-b6f5-324f" name="Esoteric Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="90" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="108a-4ad6-bb90-a5ea" name="AKHELIAN" entryId="108a-4ad6-bb90-a5ea" primary="false" /></categories></selection><selection id="3vysip" name="Eidolon of Mathlann, Aspect of the Sea" entryId="8bd9-c5ad-d2c4-7c43::9ca1-3e30-fb7-44c0" number="1" type="unit" from="entry"><profiles><profile id="50b2-da95-c685-7fe8" name="Eidolon of Mathlann, Aspect of the Sea" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="ea29-2d7a-119b-1f55" name="Dormant Energies" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to casting rolls for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="bdc5-8eff-df89-9964" name="Tranquillity of the Abyss" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignore negative modifiers to the control scores of friendly **^^Idoneth Deepkin^^** units while they are wholly within 12&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="e4e4-d59c-32a1-ed71" name="Vengeful Waves" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit has not charged this turn, pick an enemy unit in combat with it to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, the target cannot use commands for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="d4b3-bede-2080-6771" name="Tsunami of Terror" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick up to 3 different visible enemy units within 12&quot; of this unit to be the targets, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Subtract 1 from save rolls for combat attacks that target those units until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="3w5ssy" name="Eidolon of Mathlann, Aspect of the Sea" entryId="8bd9-c5ad-d2c4-7c43::83ce-c077-1da9-1f57" number="1" type="model" from="entry"><selections><selection id="40s4lmk" name="Blasts of Abyssal Energy" entryId="8bd9-c5ad-d2c4-7c43::f237-1652-391b-9dad" number="1" type="upgrade" from="entry"><profiles><profile id="c481-d3d3-f014-289b" name="Blasts of Abyssal Energy" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection><selection id="4029pvw" name="Psi-trident and Deep-sea Sceptre" entryId="8bd9-c5ad-d2c4-7c43::4b4f-f610-2036-603a" number="1" type="upgrade" from="entry"><profiles><profile id="fcf4-7cc8-450e-d655" name="Psi-trident and Deep-sea Sceptre" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">7</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="340" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="539b-2079-26e-d477" name="EIDOLON" entryId="539b-2079-26e-d477" primary="false" /><category id="8179-697a-9f4c-91d4" name="WIZARD (2)" entryId="8179-697a-9f4c-91d4" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /></categories></selection><selection id="48hs8e" name="Eidolon of Mathlann, Aspect of the Storm" entryId="eee-f7d1-5823-79d7::2f12-e371-2aa-baa2" number="1" type="unit" from="entry"><profiles><profile id="fa48-f039-e3ac-32cd" name="Eidolon of Mathlann, Aspect of the Storm" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="b507-23d7-e519-69a0" name="Drench With Hate" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to wound rolls for combat attacks made by friendly **^^Idoneth Deepkin^^** units while they are wholly within 12&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3e12-4a6f-5779-f168" name="Crashing Upon the Foe" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit can use **^^Charge^^** abilities even if it used a **^^Retreat^^** ability in the same turn. In addition, no mortal damage is inflicted on this unit by **^^Retreat^^** abilities.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="916b-d72b-8ac8-efa3" name="Pulled Into the Depths" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy **^^Hero^^** in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, the target has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="481kys" name="Eidolon of Mathlann, Aspect of the Storm" entryId="eee-f7d1-5823-79d7::a34-e816-1b7e-9a57" number="1" type="model" from="entry"><selections><selection id="4ezuzj" name="Spear of Repressed Fury and Crulhook" entryId="eee-f7d1-5823-79d7::a086-2fa2-de29-b3eb" number="1" type="upgrade" from="entry"><profiles><profile id="2c89-939f-f0ae-9fa3" name="Spear of Repressed Fury and Crulhook" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">7</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="280" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="539b-2079-26e-d477" name="EIDOLON" entryId="539b-2079-26e-d477" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /></categories></selection><selection id="4mha34" name="Ikon of the Sea" entryId="bf1b-a06a-1b46-d0e2::565b-35a6-8589-d10b" number="1" type="unit" from="entry"><profiles><profile id="1720-796f-4329-456e" name="Ikon of the Sea" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">7&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="ce62-bd37-6e12-5a87" name="The Surging Sea" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick this unit and up to 1 friendly **^^Idoneth Deepkin^^** unit within this unit's combat range to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, add 1 to the number of dice rolled when making charge rolls for the targets, to a maximum of 3.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orance</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="a726-0d53-4693-99cc" name="Rapid Approach" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit can use a **^^Run^^** ability and still use **^^Charge^^** abilities later in the turn</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="4mure7b" name="Ikon of the Sea" entryId="bf1b-a06a-1b46-d0e2::4c23-eeec-1852-7fae" number="1" type="model" from="entry"><selections><selection id="4rjoh0h" name="Tidal Glaive" entryId="bf1b-a06a-1b46-d0e2::356d-623c-e190-77c0" number="1" type="upgrade" from="entry"><profiles><profile id="c7f2-65a2-bdf6-591c" name="Tidal Glaive" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="108a-4ad6-bb90-a5ea" name="AKHELIAN" entryId="108a-4ad6-bb90-a5ea" primary="false" /></categories></selection><selection id="4z51vdh" name="Ikon of the Storm" entryId="9121-9e92-2c64-f5ba::ef74-f822-eae2-d57c" number="1" type="unit" from="entry"><profiles><profile id="cff4-df93-1538-fa5d" name="Ikon of the Storm" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">7&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="20f6-1028-da75-9e2b" name="Storm of Blades" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can use 2 **^^Fight^^** abilities this phase. After the first is used, however, this unit has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="2ebc-7312-3b2a-5b80" name="Whirlpool's Fury" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Enemy units cannot use **^^Retreat^^** abilities while they are in combat with this unit.
Friendly units that use a **^^Retreat^^** ability while they are wholly within 12&quot; of this unit can still use **^^Shoot^^** and/or **^^Charge^^** abilities later in the turn.
No mortal damage is inflicted on friendly **^^Idoneth Deepkin^^** units by **^^Retreat^^** abilities while they are wholly within 12&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="50yivnk" name="Ikon of the Storm" entryId="9121-9e92-2c64-f5ba::c0dd-4ccf-b18a-d36c" number="1" type="model" from="entry"><selections><selection id="542i4ta9" name="Maelstrom Blades" entryId="9121-9e92-2c64-f5ba::facd-a351-3ba3-0983" number="1" type="upgrade" from="entry"><profiles><profile id="c98d-7a03-d00a-1d0e" name="Maelstrom Blades" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">7</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="130" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="108a-4ad6-bb90-a5ea" name="AKHELIAN" entryId="108a-4ad6-bb90-a5ea" primary="false" /></categories></selection><selection id="5fc6s2" name="Isharann Soulrender" entryId="89fd-d694-5697-6db0::b597-c539-60f-da1f" number="1" type="unit" from="entry"><profiles><profile id="c03e-9f4-3281-646c" name="Isharann Soulrender" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="6822-231b-cd10-d7f0" name="Lurelight" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 different friendly **^^Namarti^^** units wholly within 12&quot; of this unit to be the targets. You cannot pick the same unit to be the target of this ability more than once per turn.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make a lurelight roll of D3 for each target unit. On a 2+, return a number of slain models to the target unit equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="15ce-dda6-8aec-5f94" name="Hangman's Knot" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy **^^Hero^^** in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll 2D6. If the roll exceeds the target's Health characteristic, it is automatically destroyed.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="5gsn2vw" name="Isharann Soulrender" entryId="89fd-d694-5697-6db0::9560-6896-d8a7-d0a3" number="1" type="model" from="entry"><selections><selection id="5pm89ri" name="Rakerdart's Serrated Bill" entryId="89fd-d694-5697-6db0::496b-cbff-30c8-40b3" number="1" type="upgrade" from="entry"><profiles><profile id="bb4e-a78e-50d6-134f" name="Rakerdart's Serrated Bill" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="5pjacl" name="Talúnhook" entryId="89fd-d694-5697-6db0::1200-fc43-1aad-b6a8" number="1" type="upgrade" from="entry"><profiles><profile id="1f6-8a64-1d7c-4c3a" name="Talúnhook" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="90" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="c96-48d5-fd6d-b079" name="ISHARANN" entryId="c96-48d5-fd6d-b079" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /></categories></selection><selection id="5yrrz8" name="Isharann Soulscryer" entryId="9918-f75d-a637-126a::1296-cd3a-b6fc-f28f" number="1" type="unit" from="entry"><profiles><profile id="c798-5f85-e047-9a44" name="Isharann Soulscryer" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="56b0-5ffe-baa0-cc9f" name="Finder of Ways" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared the 'Unpredictable Tide' ability or the 'Steed of Tides' ability</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Instead of setting up the targets as described in the ability used, set them up on the battlefield wholly within 12&quot; of this unit and more than 7&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="5yidu2" name="Isharann Soulscryer" entryId="9918-f75d-a637-126a::b7c1-2274-4e24-efcb" number="1" type="model" from="entry"><selections><selection id="62rbjgg" name="Abyssal Touch" entryId="9918-f75d-a637-126a::3c92-b41a-14c6-ff5" number="1" type="upgrade" from="entry"><profiles><profile id="b4ee-73fb-3df-62f8" name="Abyssal Touch" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="c96-48d5-fd6d-b079" name="ISHARANN" entryId="c96-48d5-fd6d-b079" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /></categories></selection><selection id="6b3oic" name="Isharann Tidecaster" entryId="ecdb-4908-38cc-c69e::b3e9-4dba-c419-550" number="1" type="unit" from="entry"><profiles><profile id="6e0d-dcfb-9478-a308" name="Isharann Tidecaster" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="f8b2-2fb-40e5-2523" name="Master of the Ethersea" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Make an Isharann ritual roll of D6.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">On a 3+, pick 1 of the following effects to apply until the start of your next turn:
***Creeping Mist:*** Friendly **^^Idoneth Deepkin^^** units cannot be targeted by shooting attacks unless the attacking model is within 12&quot; of them.
***Surging Stream:*** Add 1 to run rolls and charge rolls for friendly **^^Idoneth Deepkin^^** units.
***Spiteful Riptide:*** Each time an enemy unit uses a **^^Retreat^^** ability, after the effect of that ability has been resolved, inflict D3 mortal damage on that unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="6ckxst" name="Isharann Tidecaster" entryId="ecdb-4908-38cc-c69e::16e5-8a0f-c8d3-57e2" number="1" type="model" from="entry"><selections><selection id="6guspv4" name="Pelagic Staff" entryId="ecdb-4908-38cc-c69e::3189-b6d0-a6e-574e" number="1" type="upgrade" from="entry"><profiles><profile id="64df-3c57-8bd4-1813" name="Pelagic Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="c96-48d5-fd6d-b079" name="ISHARANN" entryId="c96-48d5-fd6d-b079" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /></categories></selection><selection id="6pqinaa" name="Isharann Tidecaster (Scourge of Aqshy)" entryId="4ece-7230-21e3-dc73::6bd1-ab10-e0f1-5a1b" number="1" type="unit" from="entry"><profiles><profile id="9000-a922-3abc-36af" name="Isharann Tidecaster" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="09c1-5b91-87c6-292c" name="Master of the Ethersea" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **^^Idoneth Deepkin^^** unit wholly within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If the target is **^^Namarti^^**, pick 1 of the following effects to apply until the start of your next turn. Otherwise, make an **^^Isharann^^** ritual roll of D6. On a 3+, pick 1 of the following effects to apply until the start of your next turn.
***Torrent of Blows*:** Pick 1 of the target's melee weapons. That weapon has **Crit (2 Hits)**.
***Protection of the Waves*:** While this unit is within 3&quot; of and visible to the target, both units have **^^Ward (5+)^^**.
***Frenzy of the Ethersea*:** For each unmodified hit roll of 1 for a combat attack that targets that friendly unit, inflict 1 mortal damage on the attacking unit after the **^^Fight^^** ability has been resolved.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="6q73xas" name="Isharann Tidecaster" entryId="4ece-7230-21e3-dc73::272a-0f03-2a63-a8ee" number="1" type="model" from="entry"><selections><selection id="6uh9ogx" name="Pelagic Staff" entryId="4ece-7230-21e3-dc73::62f4-9f27-cfa8-ad51" number="1" type="upgrade" from="entry"><profiles><profile id="15c1-9688-360e-f7bd" name="Pelagic Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="120" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="c96-48d5-fd6d-b079" name="ISHARANN" entryId="c96-48d5-fd6d-b079" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /></categories></selection><selection id="74ej8wr" name="Lotann, Warden of the Soul Ledgers" entryId="d4dd-cb90-27f2-1bb::50be-c90a-20c4-66ed" number="1" type="unit" from="entry"><profiles><profile id="7694-b095-a0b8-b4ac" name="Lotann, Warden of the Soul Ledgers" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="9b53-a348-d9e3-1988" name="Fount of Willpower" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn, Reaction: You declared a **^^Spell^^** ability for a friendly **^^Isharann^^** unit wholly within 12&quot; of this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove 1 of this unit's **soul-quota tokens**. Then, you can re-roll the casting roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="2bdb-3ae0-8d10-2ab0" name="Catalogue of Souls" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time an enemy unit is destroyed, give this unit a **soul-quota token**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8df6-a78f-8299-c7c6" name="Empowered by Memory" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible friendly **^^Idoneth Deepkin^^** unit wholly within 18&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">The target's melee weapons have **Crit (Auto-wound)** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="741q0fm" name="Lotann, Warden of the Soul Ledgers" entryId="d4dd-cb90-27f2-1bb::f61a-e48-47a4-fdf6" number="1" type="model" from="entry"><selections><selection id="75xsmt" name="Meloch's Tentacles and Weapons" entryId="d4dd-cb90-27f2-1bb::2e94-41b8-bb33-9bae" number="1" type="upgrade" from="entry"><profiles><profile id="93a0-d162-c808-b985" name="Meloch's Tentacles and Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="c96-48d5-fd6d-b079" name="ISHARANN" entryId="c96-48d5-fd6d-b079" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /></categories></selection><selection id="7jmv4f" name="Mathaela, Oracle of the Abyss" entryId="c5ce-af02-ae54-3722::bf44-ec35-5b38-b2db" number="1" type="unit" from="entry"><profiles><profile id="82a7-8c68-1508-275d" name="Mathaela, Oracle of the Abyss" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="50e1-8aa1-f3a6-c6c5" name="Siren Song of The Abyss" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 friendly **^^Idoneth Deepkin^^** units wholly within 12&quot; of this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, add 1 to the Attacks characteristic of the targets' **Companion** weapons.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ac62-c51d-02e8-6c17" name="Crushing Pressure" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy unit within 18&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Roll a number of dice equal to the target's Health characteristic, to a maximum of 10. For each 4+, inflict 1 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="7kj9cep" name="Mathaela, Oracle of the Abyss" entryId="c5ce-af02-ae54-3722::fb19-7c28-128b-2826" number="1" type="model" from="entry"><selections><selection id="7lfmwkb" name="Dark Shoal's Ferocious Bites" entryId="c5ce-af02-ae54-3722::f8dd-c55e-3c82-2a68" number="1" type="upgrade" from="entry"><profiles><profile id="5a6e-1164-02bc-f8af" name="Dark Shoal's Ferocious Bites" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="7l8gj5" name="Riptide Blast" entryId="c5ce-af02-ae54-3722::29c8-7f56-4be7-25fe" number="1" type="upgrade" from="entry"><profiles><profile id="61c2-3db9-5788-49b7" name="Riptide Blast" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">18&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="7l7oc7" name="Staff of the Abyss" entryId="c5ce-af02-ae54-3722::d3e9-e6aa-d5ea-b02c" number="1" type="upgrade" from="entry"><profiles><profile id="6ed0-570c-8770-5d60" name="Staff of the Abyss" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="150" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="c96-48d5-fd6d-b079" name="ISHARANN" entryId="c96-48d5-fd6d-b079" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /></categories></selection><selection id="7twt6t" name="Volturnos, High King of the Deep" entryId="278b-c82c-70aa-ccc7::301e-efbe-65c3-bf78" number="1" type="unit" from="entry"><profiles><profile id="e505-845c-55d7-c2b1" name="Volturnos, High King of the Deep" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="97b1-a57f-b683-7dcb" name="First Among Akhelians" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to hit rolls for combat attacks made by other friendly **^^Akhelian^^** units while they are wholly within 12&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="349-2ec8-553b-a79f" name="Cealith, the High King's Shield" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit has **^^Ward (3+)^^** against mortal damage inflicted by **^^Spell^^** abilities, **^^Prayer^^** abilities or abilities used by **^^Manifestations^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="4a58-cfb1-b050-ea5f" name="Supreme Lord of Tides" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 other friendly **^^Idoneth Deepkin^^** units wholly within 12&quot; of this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to the Attacks characteristic of the targets' melee weapons for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="7trjmnf" name="Volturnos, High King of the Deep" entryId="278b-c82c-70aa-ccc7::2860-1673-d0f2-c3b9" number="1" type="model" from="entry"><selections><selection id="7uue047" name="The Astra Solus" entryId="278b-c82c-70aa-ccc7::b490-ae66-b100-6c42" number="1" type="upgrade" from="entry"><profiles><profile id="89fa-14e6-a7ef-6960" name="The Astra Solus" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">2+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="7vx8afg" name="Uasall's Fangs, Talons and Lashing Tails" entryId="278b-c82c-70aa-ccc7::affe-74a9-8b68-4824" number="1" type="upgrade" from="entry"><profiles><profile id="292-b19c-615c-f118" name="Uasall's Fangs, Talons and Lashing Tails" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="190" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="c8fc-7a72-6665-2f34" name="IDONETH DEEPKIN" entryId="c8fc-7a72-6665-2f34" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="c203-51a0-3d44-6b07" name="WARMASTER" entryId="c203-51a0-3d44-6b07" primary="false" /><category id="926c-df8c-6841-d49e" name="CAVALRY" entryId="926c-df8c-6841-d49e" primary="false" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="108a-4ad6-bb90-a5ea" name="AKHELIAN" entryId="108a-4ad6-bb90-a5ea" primary="false" /><category id="ee22-3575-6590-