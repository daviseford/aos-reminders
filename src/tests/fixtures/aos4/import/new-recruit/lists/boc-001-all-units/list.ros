81-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="104b-51ec-2c38-96e7" name="Aura of Madness" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Roll a D3. On a 2+, pick up to a number of enemy units equal to the roll that are within 9&quot; of this unit to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, each time the unmodified hit roll for a combat attack made by the target is 1, inflict 1 mortal damage on the target after the **^^Fight^^** ability has been resolved.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="k82kq5" name="Jabberslythe" entryId="d662-c505-1986-b5c8::b35e-ccc6-ca66-7ae8" number="1" type="model" from="entry"><selections><selection id="k9penow" name="Slythey Tongue" entryId="d662-c505-1986-b5c8::460b-e444-6f3b-9663" number="1" type="upgrade" from="entry"><profiles><profile id="b060-65e3-d3b7-f59d" name="Slythey Tongue" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">8&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</cha