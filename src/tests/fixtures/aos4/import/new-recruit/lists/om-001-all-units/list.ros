sed by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="84y4gub" name="Gnoblar" entryId="139a-e1a2-a79a-6fce::ce03-420-a035-4327" number="19" type="model" from="entry"><selections><selection id="85blitd" name="Motley Assortment of Weapons" entryId="139a-e1a2-a79a-6fce::5561-763f-1fcf-729" number="19" type="upgrade" from="entry"><profiles><profile id="4de8-7ad9-7563-18d8" name="Motley Assortment of Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">1</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">5+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="8563nyq" name="Sharp Stuff" entryId="139a-e1a2-a79a-6fce::f1c4-67d3-d408-bb0d" number="19" type="upgrade" from="entry"><profiles><profile id="580a-b610-a19f-6a8a" name="Sharp Stuff" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">8&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">1</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">5+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">-</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="130" /></costs><categories><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="743-1bd8-e3d-ced2" name="OGOR MAWTRIBES" entryId="743-1bd8-e3d-ced2" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /></categories></selection><selection id="8f56jq" name="Gorger Mawpack" entryId="1f2a-58a9-839b-59b0::8d6b-1912-d60a-5163" number="1" type="unit" from="entry"><profiles><profile id="67ca-7f59-1abe-de13" name="Gorger Mawpack" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="d7cb-c86-82b3-9a0c" name="Troglodytic Lurkers" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick this unit if it has not been deployed.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up this unit in reserve **lurking on the fringes**. It has now been deployed.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="aea5-a3ca-4899-8779" name="Frenzied Hunters" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick this unit if it is **lurking on the fringes**.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up this unit on the battlefield wholly within 9&quot; of a battlefield edge and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="8g9bytq" name="Gorger" entryId="1f2a-58a9-839b-59b0::f973-1619-d15b-d393" number="1" type="model" from="entry"><selections><selection id="8gon1yh" name="Clubs, Claws and Jaws" entryId="1f2a-58a9-839b-59b0::2f6b-8bdd-4508-8953" number="1" type="upgrade" from="entry"><profiles><profile id="2936-b63d-7ce8-c9c1" name="Clubs, Claws and Jaws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Infantry^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="8hmyxyf" name="Champion" entryId="1f2a-58a9-839b-59b0::5ed6-d451-7721-33b8::9c21-1746-9873-a5b5" entryGroupId="1f2a-58a9-839b-59b0::5eb8-9302-658-27fb" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="8huoyl" name="Gorger" entryId="1f2a-58a9-839b-59b0::f973-1619-d15b-d393" number="1" type="model" from="entry"><selections><selection id="8in5o7j" name="Clubs, Claws and Jaws" entryId="1f2a-58a9-839b-59b0::2f6b-8bdd-4508-8953" number="1" type="upgrade" from="entry"><profiles><profile id="2936-b63d-7ce8-c9c1" name="Clubs, Claws and Jaws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Infantry^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="8ixi94z" name="Musician" entryId="1f2a-58a9-839b-59b0::9d5a-4af-8119-2448::2475-183b-3802-4431" entryGroupId="1f2a-58a9-839b-59b0::5eb8-9302-658-27fb" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="ef81-53a1-5559-5aa1" name="Musician" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit contains any musicians, if it uses the 'Rally' command, you can make one additional rally roll of D6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="8jkc2nj" name="Gorger" entryId="1f2a-58a9-839b-59b0::f973-1619-d15b-d393" number="3" type="model" from="entry"><selections><selection id="8jxek5f" name="Clubs, Claws and Jaws" entryId="1f2a-58a9-839b-59b0::2f6b-8bdd-4508-8953" number="3" type="upgrade" from="entry"><profiles><profile id="2936-b63d-7ce8-c9c1" name="Clubs, Claws and Jaws" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Infantry^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="240" /></costs><categories><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="743-1bd8-e3d-ced2" name="OGOR MAWTRIBES" entryId="743-1bd8-e3d-ced2" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ddcb-3c91-472f-c35a" name="OGOR" entryId="ddcb-3c91-472f-c35a" primary="false" /><category id="11c3-dbff-a3f7-ab" name="CHAMPION (1/5)" entryId="11c3-dbff-a3f7-ab" primary="false" /><category id="dd6f-27e9-b16e-24ee" name="MUSICIAN (1/5)" entryId="dd6f-27e9-b16e-24ee" primary="false" /></categories></selection><selection id="0di094e" name="Icefall Yhetees" entryId="92ef-3f35-c07d-5d50::5fed-90de-715-e720" number="1" type="unit" from="entry"><profiles><profile id="f517-99cf-b23a-e92c" name="Icefall Yhetees" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">4</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="4725-1412-71e9-fefb" name="Bounding Leaps" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Enemy Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can move up to 3&quot;. It can move into combat.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="0fhbv1" name="Icefall Yhetee" entryId="92ef-3f35-c07d-5d50::9e89-4d5f-6604-4a47" number="3" type="model" from="entry"><selections><selection id="0fhezur" name="Claws and Ice‑encrusted Weapons" entryId="92ef-3f35-c07d-5d50::8d2c-6b95-b316-59d" number="3" type="upgrade" from="entry"><profiles><profile id="f057-a600-e068-bab8" name="Claws and Ice‑encrusted Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="743-1bd8-e3d-ced2" name="OGOR MAWTRIBES" entryId="743-1bd8-e3d-ced2" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="1a3d-33f9-c4cc-fe0" name="BEASTCLAW RAIDERS" entryId="1a3d-33f9-c4cc-fe0" primary="false" /><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /></categories></selection><selection id="0pfwvq" name="Ironguts" entryId="d797-f5f5-84e3-e83e::7ea4-f81b-b7cc-b16e" number="1" type="unit" from="entry"><profiles><profile id="52f4-69e-67c2-c56f" name="Ironguts" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">4</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="3d7c-6719-e553-3ad5" name="Down to the Ironguts" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can use 2 **^^Fight^^** abilities this phase. After the first is used, however, this unit has Strike-last for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="1949-91ca-3796-3da7" name="Protect the Tyrant" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit is within the combat ranges of any friendly Tyrants, both this unit and those Tyrants have Ward (6+).</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="0r9btlq" name="Irongut" entryId="d797-f5f5-84e3-e83e::5f5a-635f-ec38-84df" number="1" type="model" from="entry"><selections><selection id="0sb71mq" name="Irongut Weapon" entryId="d797-f5f5-84e3-e83e::3b9c-25a7-5794-fa18" number="1" type="upgrade" from="entry"><profiles>