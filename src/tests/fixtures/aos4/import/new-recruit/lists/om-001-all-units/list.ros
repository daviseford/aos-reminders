xri" name="Irongut Weapon" entryId="d797-f5f5-84e3-e83e::3b9c-25a7-5794-fa18" number="1" type="upgrade" from="entry"><profiles><profile id="6163-a98b-17b6-2d4e" name="Irongut Weapon" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="210" /></costs><categories><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="743-1bd8-e3d-ced2" name="OGOR MAWTRIBES" entryId="743-1bd8-e3d-ced2" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="ddcb-3c91-472f-c35a" name="OGOR" entryId="ddcb-3c91-472f-c35a" primary="false" /><category id="5c0d-5e93-d71f-f0da" name="GUTBUSTERS" entryId="5c0d-5e93-d71f-f0da" primary="false" /><category id="fe9c-1d27-a698-5f31" name="MUSICIAN (1/4)" entryId="fe9c-1d27-a698-5f31" primary="false" /><category id="7528-e097-91b0-f4f9" name="STANDARD BEARER (1/4)" entryId="7528-e097-91b0-f4f9" primary="false" /></categories></selection><selection id="1inaai" name="Leadbelchers" entryId="96ee-3e88-f022-9f5a::15cd-469c-4ed6-afef" number="1" type="unit" from="entry"><profiles><profile id="7623-a53d-8c13-ace" name="Leadbelchers" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">4</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="a8ab-ce71-ba62-3fc6" name="Firing from the Belly" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit has not used a Move ability this turn and was not set up this turn, add 1 to hit rolls for this unit's shooting attacks for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="334f-de4c-6a85-bbd0" name="Powder Gnoblars" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit has up to 2 **Powder Gnoblar** tokens. Each time this unit uses a **^^Shoot^^** ability, for each of this unit's **Powder Gnoblars** that are on the battlefield, you can re-roll 1 random characteristic roll for this unit's Attacks characteristic. If a random characteristic roll re-rolled in this manner is 1, remove 1 of this unit's **Powder Gnoblars** from the battlefield.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="1jzloz" name="Leadbelcher" entryId="96ee-3e88-f022-9f5a::ad1d-156f-e5f9-6136" number="1" type="model" from="entry"><selections><selection id="1k40cx1" name="Bludgeoning Blows" entryId="96ee-3e88-f022-9f5a::fbf0-55d3-2cb4-ec90" number="1" type="upgrade" from="entry"><profiles><profile id="818a-7a07-8aff-340d" name="Bludgeoning Blows" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="1kdjzke" name="Leadbelcher Gun" entryId="96ee-3e88-f022-9f5a::acfa-507b-a4c0-4ddf" number="1" type="upgrade" from="entry"><profiles><profile id="5b5e-61bb-c592-c812" name="Leadbelcher Gun" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">15&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">D3</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</cha