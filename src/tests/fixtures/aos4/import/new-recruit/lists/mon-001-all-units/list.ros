ristic name="Health" typeId="96be-54ae-ce7b-10b7">4</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="7d79-7386-38c7-c7d8" name="Pall of Exhaustion" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if the target is in combat with any other friendly **^^Rotbringers^^** units. On a 3+, the target has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="ysrsen9" name="Sloven Knight" entryId="fd62-4ee3-f07a-9a49::40a6-066c-b28a-86bf" number="1" type="model" from="entry"><selections><selection id="yspn58" name="Entropic Bludgeons" entryId="fd62-4ee3-f07a-9a49::bbfd-d378-ac93-c044" number="1" type="upgrade" from="entry"><profiles><profile id="9ce2-3651-0d5f-b02e" name="Entropic Bludgeons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="ysg9mc" name="Foetid Nag's Hooves" entryId="fd62-4ee3-f07a-9a49::e39c-f2a4-918b-506f" number="1" type="upgrade" from="entry"><profiles><profile id="f794-a5a5-5330-a32b" name="Foetid Nag's Hooves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="ystaqy" name="Champion" entryId="fd62-4ee3-f07a-9a49::93a4-9feb-221c-6d70::9c21-1746-9873-a5b5" entryGroupId="fd62-4ee3-f07a-9a49::44a7-9f0a-d196-48d4" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="ytre7h" name="Sloven Knight" entryId="fd62-4ee3-f07a-9a49::40a6-066c-b28a-86bf" number="2" type="model" from="entry"><selections><selection id="yu5f4e4" name="Entropic Bludgeons" entryId="fd62-4ee3-f07a-9a49::bbfd-d378-ac93-c044" number="2" type="upgrade" from="entry"><profiles><profile id="9ce2-3651-0d5f-b02e" name="Entropic Bludgeons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="yubes7" name="Foetid Nag's Hooves" entryId="fd62-4ee3-f07a-9a49::e39c-f2a4-918b-506f" number="2" type="upgrade" from="entry"><profiles><profile id="f794-a5a5-5330-a32b" name="Foetid Nag's Hooves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="180" /></costs><categories><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="ca3c-6c3b-4887-3a9d" name="MAGGOTKIN OF NURGLE" entryId="ca3c-6c3b-4887-3a9d" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="b665-bb9e-c89c-ad7d" name="ROTBRINGERS" entryId="b665-bb9e-c89c-ad7d" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="926c-df8c-6841-d49e" entryId="926c-df8c-6841-d49e" name="CAVALRY" primary="true" /></categories></selection><selection id="z8257pi" name="Sloven Knights (Scourge of Aqshy)" entryId="81a5-0c74-821a-b185::0c0e-7f14-fa95-989f" number="1" type="unit" from="entry"><profiles><profile id="fb28-6148-e049-92ca" name="Sloven Knights" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">4</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="da36-ee3b-95ab-19ff" name="Indolent Bludgeoning" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, while the target is in combat with both this unit and another friendly **^^Maggotkin of Nurgle^^** unit, add 1 to the Damage characteristic of this unit's melee weapons for attacks that target that enemy unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="zbyhg93" name="Sloven Knight" entryId="81a5-0c74-821a-b185::adc4-6f45-d09e-e495" number="1" type="model" from="entry"><selections><selection id="zblnhe" name="Entropic Bludgeons" entryId="81a5-0c74-821a-b185::3f44-1e08-b6f3-b006" number="1" type="upgrade" from="entry"><profiles><profile id="de36-9bcf-80e4-6a36" name="Entropic Bludgeons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="zbtnlnn" name="Foetid Nag's Hooves" entryId="81a5-0c74-821a-b185::0186-e21c-b056-2ac2" number="1" type="upgrade" from="entry"><profiles><profile id="671a-c730-30ba-382e" name="Foetid Nag's Hooves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="zbmkzun" name="Champion" entryId="81a5-0c74-821a-b185::8e85-0dc7-e0b8-023d::9c21-1746-9873-a5b5" entryGroupId="81a5-0c74-821a-b185::1e0c-7b90-35b2-b0a8" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="zcjy2d" name="Sloven Knight" entryId="81a5-0c74-821a-b185::adc4-6f45-d09e-e495" number="2" type="model" from="entry"><selections><selection id="zc25ooj" name="Entropic Bludgeons" entryId="81a5-0c74-821a-b185::3f44-1e08-b6f3-b006" number="2" type="upgrade" from="entry"><profiles><profile id="de36-9bcf-80e4-6a36" name="Entropic Bludgeons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage)</characteristic></characteristics></profile></profiles></selection><selection id="zc7ruvc" name="Foetid Nag's Hooves" entryId="81a5-0c74-821a-b185::0186-e21c-b056-2ac2" number="2" type="upgrade" from="entry"><profiles><profile id="671a-c730-30ba-382e" name="Foetid Nag's Hooves" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="210" /></costs><categories><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="ca3c-6c3b-4887-3a9d" name="MAGGOTKIN OF NURGLE" entryId="ca3c-6c3b-4887-3a9d" primary="false" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="b665-bb9e-c89c-ad7d" name="ROTBRINGERS" entryId="b665-bb9e-c89c-ad7d" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="926c-df8c-6841-d49e" entryId="926c-df8c-6841-d49e" name="CAVALRY" primary="true" /></categories></selection><selection id="zr492yb" name="Beast of Nurgle" entryId="7ea9-910a-ce67-7f::8197-2f04-e647-f5c" number="1" type="unit" from="entry"><profiles><profile id="b756-df5-c86e-f5a1" name="Beast of Nurgle" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">7&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="4d31-aae1-861a-da68" name="Attention Seekers" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit is not in combat, pick the closest enemy unit to it to be the target. If 2 or more enemy units are tied to be the closest, you can pick which is the target. Then, make a charge roll of 2D6.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can move a distance up to the value of the charge roll. During that move, this unit can move into combat and can pass through models in the target unit, but it must end that move within 1/2&quot; of the target. Then, inflict D3 mortal damage on the target. If it does so, this unit has charged.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Core^^**, **^^Move^^**, **^^Charge^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c681-8a44-8f44" name="Beast" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit has a maximum control score of 1.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="zscvkhu" name="Beast of Nurgle" entryId="7ea9-910a-ce67-7f::e848-7195-c93b-9fd" number="1" type="model" from="entry"><selections><selection id="zutf1xq" name="Filthy Claws and Slobbering Maw" entryId="7ea9-910a-ce67-7f::c75a-65f2-3572-d864" number="1" type="upgrade" from="entry"><profiles><profile id="68d8-cd8-7c5d-e907" name="Filthy Claws and Slobbering Maw" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="319b-38ee-d10d-e800" name="CHAOS" entryId="319b-38ee-d10d-e800" primary="false" /><category id="ca3c-6c3b-4887-3a9d" name="MAGGOTKIN OF NURGLE" entryId="ca3c-6c3b-4887-3a9d" primary="false" /><category id="dc0b-e417-51f4-10f0" name="DAEMON" entryId="dc0b-e417-51f4-10f0" primary="false" /><category id="b224-8c8e-ca93-9860" entryId="b224-8c8e-ca93-9860" name="BEAST" primary="true" /></categories></selection><selection id="08vg7r" name="Nurglings" entryId="787f-8a7a-8596-54b1::3495-8e1e-11c-5784" number="1" type="unit" from="entry"><profiles><profile id="dceb-28af-85a4-d67" name="Nurglings" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">4</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="76de-92b8-f0da-704a" name="Endless Swarm" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit can only use this ability if it has been destroyed.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up a replacement unit wholly within 6&quot; of a friendly **Feculent Gnarlmaw** and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7