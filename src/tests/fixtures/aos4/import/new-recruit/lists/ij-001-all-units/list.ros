ics></profile></profiles></selection><selection id="n94bh24" name="Grunta's Tusks" entryId="93db-eaf9-a8a-f813::c402-9834-5a1d-25c3" number="2" type="upgrade" from="entry"><profiles><profile id="b699-137e-7487-a664" name="Grunta's Tusks" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Charge (+1 Damage), Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="160" /></costs><categories><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="926c-df8c-6841-d49e" entryId="926c-df8c-6841-d49e" name="CAVALRY" primary="true" /></categories></selection></selections><categories><category name="HERO" id="168agv" primary="false" entryId="6e72-1656-d554-528a" /><category name="INFANTRY" id="164t67f" primary="false" entryId="75d6-6995-dfcc-3898" /><category name="MONSTER" id="16osiow" primary="false" entryId="6d54-625c-d063-13e2" /><category name="WAR MACHINE" id="cjfj4du" primary="false" entryId="f7bc-b618-4b5d-2bae" /><category name="CAVALRY" id="17199vo" primary="false" entryId="926c-df8c-6841-d49e" /><category name="BEAST" id="cj8uyvj" primary="false" entryId="b224-8c8e-ca93-9860" /><category name="Illegal Units" id="cj41hzu" primary="false" entry