haracteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The first time an enemy **^^Monster^^** is destroyed by this unit, add 1 to wound rolls for this unit's attacks for the rest of the battle.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="mvf070s" name="'Ardskull" entryId="a30c-ee36-5665-b6c4::2850-eb11-c815-7ab4" number="1" type="model" from="entry"><selections><selection id="mv6fjhx" name="Krusha Weapons" entryId="a30c-ee36-5665-b6c4::d721-26e0-1de7-5f07" number="1" type="upgrade" from="entry"><profiles><profile id="084b-e203-35da-65d3" name="Krusha Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Monster^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection><selection id="mvk6taq" name="Morgok" entryId="a30c-ee36-5665-b6c4::5f22-aae5-4ea7-58d8" number="1" type="model" from="entry"><selections><selection id="mw90cai" name="Krusha Weapons" entryId="a30c-ee36-5665-b6c4::b660-efc8-2b36-7adc" number="1" type="upgrade" from="entry"><profiles><profile id="5f5c-0fe0-dbf0-6244" name="Krusha Weapons" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"