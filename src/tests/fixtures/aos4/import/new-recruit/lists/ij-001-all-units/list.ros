<roster id="deg4azg" name="ij-001-all-units" battleScribeVersion="2.03" generatedBy="https://newrecruit.eu" gameSystemId="e51d-b1a3-75fc-dc3g" gameSystemName="Age of Sigmar 4.0" gameSystemRevision="98" xmlns="http://www.battlescribe.net/schema/rosterSchema"><costs><cost name="pts" typeId="points" value="3770" /></costs><costLimits><costLimit name="pts" typeId="points" value="0" /></costLimits><forces><force id="dqdzxe" name="✦ General's Handbook 2026-27" entryId="0151-9c5b-2f1e-32d4" catalogueId="832c-fd6-a535-ffae" catalogueRevision="43" catalogueName="Ironjawz"><selections><selection id="k0zqzrl" name="Allow Legends" entryId="7e59-2237-4890-a80a" number="1" type="upgrade" from="entry"><categories><category id="676-2b78-7bbf-ba9c" entryId="676-2b78-7bbf-ba9c" name="Configuration" primary="true" /></categories></selection><selection id="k575tsb" name="Battle Traits: Ironjawz" entryId="827-e827-4f40-c1ce::d8ca-c367-a211-97b3" number="1" type="upgrade" from="entry"><profiles><profile id="618e-f241-f5d4-a04b" name="Ironjawz Waaagh!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Ironjawz Hero^^** to be the target. You cannot pick the same **^^Hero^^** to be the target of this ability more than once per battle.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, the following effects apply to friendly **^^Ironjawz^^** units while they are wholly within 18&quot; of the target:
• Add 1 to charge rolls for those units.
• Add 1 to the Attacks characteristic of those units' melee weapons.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Waaagh!^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="a85a-85d4-514a-44a3" name="Mighty Destroyers" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Ironjawz^^** unit that was not set up this turn to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The target can move up to 3&quot;. It can move into combat. If it was in combat at the start of the move, it must end that move in combat.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><categories><category id="3360-1158-e879-9606" entryId="3360-1158-e879-9606" name="Reference" primary="true" /></categories></selection><selection id="eoc4n" name="Battle Formation" entryId="1218-968b-bd6e-351e" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="k9yikio" name="Battle Formation" entryId="1218-968b-bd6e-351e" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="erj4zwl" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="kf1z7wo" name="Battle Tactic Cards" entryId="1668-6989-2470-5e10" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="eu0r683" name="Manifestation Lore" entryId="94cc-9a4c-e4a2-6da1" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="klz7asl" name="Manifestation Lore" entryId="94cc-9a4c-e4a2-6da1" number="1" type="upgrade" from="entry"><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="exeqzpm" name="Prayer Lore" entryId="35fa-60e6-258a-561f" number="1" type="upgrade" from="entry"><selections><selection id="exs1hbc" name="Warbeats" entryId="7339-e4f5-ee09-bd87::36aa-af55-d210-d137" entryGroupId="7339-e4f5-ee09-bd87::a537-457-99e-8b30" number="1" type="upgrade" from="group" group="Prayer Lores"><selections><selection id="eyzejbr" name="Fixin' Beat" entryId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::3e3e-a616-5969-6d0b" entryGroupId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::3188-fb52-1d9a-d3ad" number="1" type="upgrade" from="group" group="Warbeats"><profiles><profile id="5606-7489-d49f-e84" name="Fixin' Beat" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Ironjawz Priest^^** to chant this prayer, pick a visible friendly **^^Ironjawz^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">**Heal (D6)** the target. If the chanting roll was 8+, **Heal (D3+3)** the target instead.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="eyi4yq" name="Get 'Em Beat" entryId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::2929-c9d5-1e9e-1d3e" entryGroupId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::3188-fb52-1d9a-d3ad" number="1" type="upgrade" from="group" group="Warbeats"><profiles><profile id="8b84-cf49-aa4c-7814" name="Get 'Em Beat" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Ironjawz Priest^^** to chant this prayer, pick a visible friendly **^^Ironjawz^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">For the rest of the turn, add 1 to charge rolls for the target. In addition, if the chanting roll was 8+, add 1 to the number of dice rolled when making charge rolls for the target, to a maximum of 3.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="eyuw1w" name="Killa Beat" entryId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::88f3-56cc-3ffe-ff27" entryGroupId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::3188-fb52-1d9a-d3ad" number="1" type="upgrade" from="group" group="Warbeats"><profiles><profile id="55b0-9f01-4604-6322" name="Killa Beat" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Ironjawz Priest^^** to chant this prayer, pick a visible friendly **^^Ironjawz^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Add 1 to the Damage characteristic of the target's melee weapons until the start of your next turn. If the chanting roll was 10+, you can pick up to 2 eligible units to be the targets instead of 1.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="ks74ppm" name="Prayer Lore" entryId="35fa-60e6-258a-561f" number="1" type="upgrade" from="entry"><selections><selection id="ks4usk" name="Warbeats" entryId="7339-e4f5-ee09-bd87::36aa-af55-d210-d137" entryGroupId="7339-e4f5-ee09-bd87::a537-457-99e-8b30" number="1" type="upgrade" from="group" group="Prayer Lores"><selections><selection id="kt38d08" name="Fixin' Beat" entryId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::3e3e-a616-5969-6d0b" entryGroupId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::3188-fb52-1d9a-d3ad" number="1" type="upgrade" from="group" group="Warbeats"><profiles><profile id="5606-7489-d49f-e84" name="Fixin' Beat" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Ironjawz Priest^^** to chant this prayer, pick a visible friendly **^^Ironjawz^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">**Heal (D6)** the target. If the chanting roll was 8+, **Heal (D3+3)** the target instead.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="kt7d37m" name="Get 'Em Beat" entryId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::2929-c9d5-1e9e-1d3e" entryGroupId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::3188-fb52-1d9a-d3ad" number="1" type="upgrade" from="group" group="Warbeats"><profiles><profile id="8b84-cf49-aa4c-7814" name="Get 'Em Beat" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Ironjawz Priest^^** to chant this prayer, pick a visible friendly **^^Ironjawz^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">For the rest of the turn, add 1 to charge rolls for the target. In addition, if the chanting roll was 8+, add 1 to the number of dice rolled when making charge rolls for the target, to a maximum of 3.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection><selection id="kt50ttl" name="Killa Beat" entryId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::88f3-56cc-3ffe-ff27" entryGroupId="7339-e4f5-ee09-bd87::67e6-2bfb-e5d4-6979::3188-fb52-1d9a-d3ad" number="1" type="upgrade" from="group" group="Warbeats"><profiles><profile id="55b0-9f01-4604-6322" name="Killa Beat" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)" from="entry"><characteristics><characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic><characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic><characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Ironjawz Priest^^** to chant this prayer, pick a visible friendly **^^Ironjawz^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic><characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Add 1 to the Damage characteristic of the target's melee weapons until the start of your next turn. If the chanting roll was 10+, you can pick up to 2 eligible units to be the targets instead of 1.</characteristic><characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute><attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute><attribute name="Parent Node" typeId="5d25-63d6-3935-9312" /></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="f0u1bx5" name="Spell Lore" entryId="6876-59db-5e39-aa8a" number="1" type="upgrade" from="entry"><selections><selection id="f1hjpj" name="Lore of the Weird" entryId="6bce-6e0-ed32-6b66::4936-321c-38e9-4dc" entryGroupId="6bce-6e0-ed32-6b66::b5b-5dbc-9d3b-d075" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="f2demtr" name="Bash 'Em, Ladz" entryId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::108f-8694-8e15-b05e" entryGroupId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::0713-41e8-e557-2eb6" number="1" type="upgrade" from="group" group="Lore of the Weird"><profiles><profile id="ea0c-5e7-77ba-167d" name="Bash 'Em, Ladz" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ironjawz Wizard^^** to cast this spell, pick a visible friendly **^^Ironjawz^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">The target's melee weapons have **Crit (2 Hits)** until the start of your next turn</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection><selection id="f2e23c" name="Da Great Big Green Hand of Gork" entryId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::0f36-4605-74ec-d7f8" entryGroupId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::0713-41e8-e557-2eb6" number="1" type="upgrade" from="group" group="Lore of the Weird"><profiles><profile id="d612-3e23-847d-c58b" name="Da Great Big Green Hand of Gork" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ironjawz Wizard^^** to cast this spell, pick a visible friendly unit wholly within 12&quot; of them and not in combat to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Remove the target from the battlefield and set it up again wholly within 24&quot; of the caster and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection><selection id="f2iuyk" name="Mighty 'Eadbutt" entryId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::c3fb-0027-f11d-453d" entryGroupId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::0713-41e8-e557-2eb6" number="1" type="upgrade" from="group" group="Lore of the Weird"><profiles><profile id="d016-5f8d-9e32-4df0" name="Mighty 'Eadbutt" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ironjawz Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict D3 mortal damage on the target. If the target is a **^^Wizard^^**, inflict 3 mortal damage on the target instead.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="kzorf3x" name="Spell Lore" entryId="6876-59db-5e39-aa8a" number="1" type="upgrade" from="entry"><selections><selection id="l0pnltk" name="Lore of the Weird" entryId="6bce-6e0-ed32-6b66::4936-321c-38e9-4dc" entryGroupId="6bce-6e0-ed32-6b66::b5b-5dbc-9d3b-d075" number="1" type="upgrade" from="group" group="Spell Lores"><selections><selection id="l0cqq2q" name="Bash 'Em, Ladz" entryId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::108f-8694-8e15-b05e" entryGroupId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::0713-41e8-e557-2eb6" number="1" type="upgrade" from="group" group="Lore of the Weird"><profiles><profile id="ea0c-5e7-77ba-167d" name="Bash 'Em, Ladz" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ironjawz Wizard^^** to cast this spell, pick a visible friendly **^^Ironjawz^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">The target's melee weapons have **Crit (2 Hits)** until the start of your next turn</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection><selection id="l0imqqq" name="Da Great Big Green Hand of Gork" entryId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::0f36-4605-74ec-d7f8" entryGroupId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::0713-41e8-e557-2eb6" number="1" type="upgrade" from="group" group="Lore of the Weird"><profiles><profile id="d612-3e23-847d-c58b" name="Da Great Big Green Hand of Gork" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ironjawz Wizard^^** to cast this spell, pick a visible friendly unit wholly within 12&quot; of them and not in combat to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Remove the target from the battlefield and set it up again wholly within 24&quot; of the caster and more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute></attributes></profile></profiles></selection><selection id="l0winf7" name="Mighty 'Eadbutt" entryId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::c3fb-0027-f11d-453d" entryGroupId="6bce-6e0-ed32-6b66::9da0-cf03-a001-662e::0713-41e8-e557-2eb6" number="1" type="upgrade" from="group" group="Lore of the Weird"><profiles><profile id="d016-5f8d-9e32-4df0" name="Mighty 'Eadbutt" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" from="entry"><characteristics><characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic><characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic><characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ironjawz Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic><characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict D3 mortal damage on the target. If the target is a **^^Wizard^^**, inflict 3 mortal damage on the target instead.</characteristic><characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic></characteristics><attributes><attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute><attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute></attributes></profile></profiles></selection></selections></selection></selections><categories><category id="ac97-b27c-7e35-7ab9" entryId="ac97-b27c-7e35-7ab9" name="Army Composition" primary="true" /></categories></selection><selection id="f49ui9l" name="Bossrokk Tower" entryId="73b0-a8fe-3e4b-391c::092c-1ddc-6678-db32" number="1" type="unit" from="entry"><rules><rule id="2fe4-c3be-79bf-ca8f" name="Bossrokk Tower" hidden="false"><description>**The following universal terrain abilities apply to this terrain feature (Terrain, 1.2):
Cover, Impassable**</description></rule></rules><profiles><profile id="f22e-a187-3eba-0a67" name="Man da Tower!" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this terrain feature has a Shouty Boss:
• The Shouty Boss cannot use **^^Move^^** abilities.
• Instead of measuring range or visibility to the Shouty Boss, measure to this terrain feature instead.
• All attacks that would target the Shouty Boss target this terrain feature instead.
• If this terrain feature is destroyed, before removing it from the battlefield, inflict D3 mortal damage on the Shouty Boss. Then, set up the Shouty Boss on the battlefield within 3&quot; of this terrain feature and not in combat. That unit is no longer the Shouty Boss. If it is not possible to set up the Shouty Boss, it is slain.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8c61-11d2-e0f8-2aad" name="Bossrokk Tower" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic></characteristics></profile><profile id="d236-0df7-ff07-1e20" name="Up We Go!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this terrain feature does not have a Shouty Boss , pick a friendly **^^Ironjawz Infantry Hero^^** that is not in combat and is within 3&quot; of it  to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Place the target on this terrain feature. The target is now a Shouty Boss (see 'Man da Tower').</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="40ac-68ad-a4eb-ea6a" name="Aggressively Bossy" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn, Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 18&quot; of this terrain feature to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if this terrain feature has a Shouty Boss. On a 4+, pick 1 of the following effects to apply to the target until the start of your next turn:
***Dat's Ours, Ya Git!:*** Subtract 3 from the target's control score.
***Zog Off Wiv Ya Magic!:*** Subtract 1 from casting rolls and/or chanting rolls for the target.
***Oi! Hold it!:*** Subtract 1 from the number of dice rolled when making charge rolls for the target, to a minimum of 1.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="fb9e-5498-9c49-7f52" name="I'm Off!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this terrain feature has a Shouty Boss that was not placed on it this turn, set up the Shouty Boss on the battlefield wholly within 6&quot; of this terrain feature and not in combat. That unit is no longer a Shouty Boss.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><categories><category id="cdd6-ffa1-9b32-4cb8" entryId="cdd6-ffa1-9b32-4cb8" name="FACTION TERRAIN" primary="true" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /></categories></selection><selection id="lc3cnf" name="Bossrokk Tower" entryId="73b0-a8fe-3e4b-391c::092c-1ddc-6678-db32" number="1" type="unit" from="entry"><rules><rule id="2fe4-c3be-79bf-ca8f" name="Bossrokk Tower" hidden="false"><description>**The following universal terrain abilities apply to this terrain feature (Terrain, 1.2):
Cover, Impassable**</description></rule></rules><profiles><profile id="f22e-a187-3eba-0a67" name="Man da Tower!" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this terrain feature has a Shouty Boss:
• The Shouty Boss cannot use **^^Move^^** abilities.
• Instead of measuring range or visibility to the Shouty Boss, measure to this terrain feature instead.
• All attacks that would target the Shouty Boss target this terrain feature instead.
• If this terrain feature is destroyed, before removing it from the battlefield, inflict D3 mortal damage on the Shouty Boss. Then, set up the Shouty Boss on the battlefield within 3&quot; of this terrain feature and not in combat. That unit is no longer the Shouty Boss. If it is not possible to set up the Shouty Boss, it is slain.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="8c61-11d2-e0f8-2aad" name="Bossrokk Tower" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic></characteristics></profile><profile id="d236-0df7-ff07-1e20" name="Up We Go!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this terrain feature does not have a Shouty Boss , pick a friendly **^^Ironjawz Infantry Hero^^** that is not in combat and is within 3&quot; of it  to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Place the target on this terrain feature. The target is now a Shouty Boss (see 'Man da Tower').</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="40ac-68ad-a4eb-ea6a" name="Aggressively Bossy" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn, Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 18&quot; of this terrain feature to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if this terrain feature has a Shouty Boss. On a 4+, pick 1 of the following effects to apply to the target until the start of your next turn:
***Dat's Ours, Ya Git!:*** Subtract 3 from the target's control score.
***Zog Off Wiv Ya Magic!:*** Subtract 1 from casting rolls and/or chanting rolls for the target.
***Oi! Hold it!:*** Subtract 1 from the number of dice rolled when making charge rolls for the target, to a minimum of 1.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="fb9e-5498-9c49-7f52" name="I'm Off!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this terrain feature has a Shouty Boss that was not placed on it this turn, set up the Shouty Boss on the battlefield wholly within 6&quot; of this terrain feature and not in combat. That unit is no longer a Shouty Boss.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><categories><category id="cdd6-ffa1-9b32-4cb8" entryId="cdd6-ffa1-9b32-4cb8" name="FACTION TERRAIN" primary="true" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /></categories></selection></selections><costs><cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="1" /></costs><categories><category name="Configuration" id="u1rwkm" primary="false" entryId="676-2b78-7bbf-ba9c" /><category name="Reference" id="u1chaem" primary="false" entryId="3360-1158-e879-9606" /><category name="Army Composition" id="dwv0dog" primary="false" entryId="ac97-b27c-7e35-7ab9" /><category name="FACTION TERRAIN" id="dwsnafp" primary="false" entryId="cdd6-ffa1-9b32-4cb8" /><category name="Illegal Units" id="bova3mk" primary="false" entryId="(Illegal Units)" /></categories><forces><force id="15v9umr" name="Auxillary Units" entryId="6084-3baa-f00b-ac0a::8732-47c4-9f1c-e71e" catalogueId="832c-fd6-a535-ffae" catalogueRevision="43" catalogueName="Ironjawz"><selections><selection id="lor7c28" name="Ardboy Big Boss" entryId="ba04-3602-ef65-10a5::e020-20c4-a638-6d2b" number="1" type="unit" from="entry"><profiles><profile id="cc6-c796-e3d2-f36f" name="Ardboy Big Boss" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="4571-de81-edd8-8e28" name="Iron-fisted Commander" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If a friendly **Ardboyz** unit wholly within 12&quot; of this unit uses the 'Rally' command, you can make 3 additional rally rolls of D6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="1cd9-9771-5fc7-bf76" name="Get Bashin'!" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to shield bash rolls for friendly **Ardboyz** units while they are wholly within 12&quot; of this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="lo4apyq" name="Ardboy Big Boss" entryId="ba04-3602-ef65-10a5::57ae-a31-338e-741e" number="1" type="model" from="entry"><selections><selection id="lteu849" name="Boss-hacka and Choppa" entryId="ba04-3602-ef65-10a5::77b9-1264-7344-c3" number="1" type="upgrade" from="entry"><profiles><profile id="d5b-ba98-8893-3b58" name="Boss-hacka and Choppa" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">7</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="90" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /></categories></selection><selection id="m62d8f" name="Gordrakk, the Fist of Gork" entryId="70cd-5229-7b3f-94cb::b8a1-7664-687e-c0d9" number="1" type="unit" from="entry"><profiles><profile id="ba75-deec-3042-bfb6" name="Gordrakk, the Fist of Gork" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">20</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="d06b-5137-75b1-25a7" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of **Bigteef's Fists and Tail** is 6.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="31ef-8175-88b-13c2" name="Monster Grapple" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy **^^Monster^^** in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, pick 1 of the target's weapons. You must pick a **Companion** weapon if it has any. Halve the Attacks characteristic of that weapon (rounding up) for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="e1e8-a426-8ad3-64a2" name="Voice of Gork" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Reaction: You declared a **^^Waaagh!^^** ability</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Until the start of your next turn, add 1 to hit rolls for combat attacks made by friendly **^^Ironjawz^^** units while they are wholly within 18&quot; of this unit.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="36e6-77c0-2f4-8cab" name="Strength From Victory" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If any damage points were allocated to an enemy unit by this unit's combat attacks this turn and that enemy unit has been destroyed, give this unit a **Waaagh! token**, to a maximum of 3.
Until the end of the next turn, add 1 to the Attacks characteristic of this unit's weapons for each **Waaagh! token** it has.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="m7l99e" name="Gordrakk, the Fist of Gork" entryId="70cd-5229-7b3f-94cb::f1f7-2127-e95b-20b4" number="1" type="model" from="entry"><selections><selection id="m82h22i" name="Bigteef's Fists and Tail" entryId="70cd-5229-7b3f-94cb::c941-a2a7-3bfb-d37a" number="1" type="upgrade" from="entry"><profiles><profile id="b357-7a0d-cfc9-159b" name="Bigteef's Fists and Tail" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Monster^^** (+1 Rend), Companion</characteristic></characteristics></profile></profiles></selection><selection id="m8mxo1f" name="Bigteef's Roar" entryId="70cd-5229-7b3f-94cb::f72c-a9e6-28cc-6bd5" number="1" type="upgrade" from="entry"><profiles><profile id="934f-5743-2ac4-406c" name="Bigteef's Roar" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">8&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">-</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat, Companion</characteristic></characteristics></profile></profiles></selection><selection id="m8xaape" name="Smasha and Kunnin'" entryId="70cd-5229-7b3f-94cb::bfa3-8ef5-ac0b-d8f0" number="1" type="upgrade" from="entry"><profiles><profile id="d367-64f-ec0b-aa8f" name="Smasha and Kunnin'" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Hero^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="340" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="c203-51a0-3d44-6b07" name="WARMASTER" entryId="c203-51a0-3d44-6b07" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="48d5-c85-c069-733a" name="MAW-KRUSHA" entryId="48d5-c85-c069-733a" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /></categories></selection><selection id="meoin2a" name="Kragnos, the End of Empires" entryId="6343-e28f-bef2-a199::2a45-46b2-62f9-63cc" number="1" type="unit" from="entry"><profiles><profile id="d49a-ca03-104-c44b" name="Kragnos, the End of Empires" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">18</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">15</characteristic></characteristics></profile><profile id="d590-353e-2fe2-e54d" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of **The Dread Mace** is 4 and this unit has a Control characteristic of 10.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="1682-108e-330e-4da0" name="Avatar of Destruction" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this unit would be automatically destroyed, it is not automatically destroyed. Instead, allocate 6 damage points to it (ward rolls cannot be made for those damage points).</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="1295-7f6e-c910-5c9d" name="Rampaging Destruction" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit charged this phase, pick 1 of the following effects:
• Roll a dice for each enemy unit within 1&quot; of this unit. On a 2+, inflict an amount of mortal damage on that unit equal to the roll.
• Pick an enemy **^^Monster^^** in combat with this unit and roll 2D6. On a 7, this ability has no effect. Otherwise, inflict an amount of mortal damage on that unit equal to the results on the dice used for the 2D6 roll multiplied together. For example, a 2D6 roll of 2 and 6 would inflict 12 mortal damage (2 × 6).</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="e5b8-2d37-259d-87a6" name="The End of Empires" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, add 1 to the number of dice rolled when making charge rolls for friendly **^^Destruction^^** units while they are wholly within 12&quot; of this unit, to a maximum of 3.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ec2f-e8e-94ff-9aa0" name="The Shield Inviolate" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: Opponent declared a **^^Spell^^** ability</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit was picked to be the target of that spell, roll a dice. On a 3+, ignore the effect of that spell on this unit. This unit can use this ability more than once per phase but only once per **^^Spell^^** ability.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="mfc9kav" name="Kragnos, the End of Empires" entryId="6343-e28f-bef2-a199::11bd-e956-ea84-5e76" number="1" type="model" from="entry"><selections><selection id="mh5v23l" name="Hooves of Wrack and Ruin" entryId="6343-e28f-bef2-a199::e41b-4676-aafd-cf28" number="1" type="upgrade" from="entry"><profiles><profile id="aab8-2038-53ff-1cd" name="Hooves of Wrack and Ruin" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="mh4t7ic" name="The Dread Mace" entryId="6343-e28f-bef2-a199::59d8-824-dd81-4d9e" number="1" type="upgrade" from="entry"><profiles><profile id="62cc-c03b-f390-ea56" name="The Dread Mace" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">3</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">4</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="mhpt4z" name="Tuskbreaker" entryId="6343-e28f-bef2-a199::ac7f-a30d-3a72-a496" number="1" type="upgrade" from="entry"><profiles><profile id="799e-d1d1-3f33-aa37" name="Tuskbreaker" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (2 Hits)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="580" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="c203-51a0-3d44-6b07" name="WARMASTER" entryId="c203-51a0-3d44-6b07" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="6e42-3c75-4cb5-337a" name="KRULEBOYZ" entryId="6e42-3c75-4cb5-337a" primary="false" /></categories></selection><selection id="mo27rp5" name="Megaboss" entryId="4079-fb73-a4d7-7b0d::4e07-f63a-6315-b48b" number="1" type="unit" from="entry"><profiles><profile id="e8e5-8560-5331-37a" name="Megaboss" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="8557-bf37-78c7-ea5d" name="Lead da Brutes" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Fight^^** ability for this unit</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a friendly **^^Brute^^** unit that has not used a **^^Fight^^** ability  this turn and is within this unit's combat range to be the target. The  target can be picked to use a **^^Fight^^** ability immediately after the **^^Fight^^** ability used by this unit has been resolved. If it is picked to do so, add 1 to the Attacks characteristic of that unit's melee weapons for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="fe7-6e6c-e3d5-cec8" name="Strength From Victory" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If any damage points were allocated to an enemy unit by this unit's combat attacks this turn and that enemy unit has been destroyed, give this unit a **Waaagh! token**, to a maximum of 3.
Until the end of the next turn, add 1 to the Attacks characteristic of this unit's weapons for each **Waaagh! token** it has.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="moy44f" name="Megaboss" entryId="4079-fb73-a4d7-7b0d::1ba9-5017-6a18-2aee" number="1" type="model" from="entry"><selections><selection id="msivokm" name="Boss-choppa" entryId="4079-fb73-a4d7-7b0d::8200-bc1f-235c-d69e" number="1" type="upgrade" from="entry"><profiles><profile id="f6b3-b16f-c6c9-3fb9" name="Boss-choppa" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="130" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /></categories></selection><selection id="n2rpqh8" name="Megaboss (Scourge of Aqshy)" entryId="a88b-3cc8-4945-99fe::215e-afa9-d599-8f10" number="1" type="unit" from="entry"><profiles><profile id="ffe0-ea51-dfe3-d50c" name="Megaboss" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="c29b-21ae-4345-b102" name="Get In There And Wallop 'Em!" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round (Army), Any Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly Ironjawz unit wholly within 12&quot; of this unit and that was not set up this turn to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, when you use the 'Mighty Destroyers' ability, you can pick that friendly unit to be a second target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="255f-26cc-9206-a954" name="You Ain't Gonna Show Me Up" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit used a Fight ability this turn, spend 1 rage dice. If your opponent's fury level is lower than yours, they must increase their fury level by 1, to a maximum of 7.
Then, add 1 to the Damage characteristic of this unit's Boss-choppa for the rest of the battle. This unit can be affected by this ability multiple times and the effects are cumulative.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="n20dd9" name="Megaboss" entryId="a88b-3cc8-4945-99fe::dc31-9aa7-428b-884b" number="1" type="model" from="entry"><selections><selection id="n7szt2tq" name="Boss-choppa" entryId="a88b-3cc8-4945-99fe::4755-5035-2afe-4cc0" number="1" type="upgrade" from="entry"><profiles><profile id="ac73-be0a-2f0b-7974" name="Boss-choppa" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="150" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /></categories></selection><selection id="nfvqvor" name="Megaboss on Maw-krusha" entryId="d3e0-6a4-afe6-46f5::8400-417c-251b-860a" number="1" type="unit" from="entry"><profiles><profile id="9ee8-2e91-e692-9775" name="Megaboss on Maw-krusha" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">18</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="f3b4-1a52-be04-b724" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its ** Maw-krusha's Fists and Tail** is 5.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3f1a-a95a-2922-1a97" name="Destructive Bulk" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit charged this turn, roll a D3. On a 2+, this unit can move 2D6&quot;. It can move through  the combat range of enemy units and can end that move in combat. Then, pick an enemy unit that this unit passed across during that move. Inflict an amount of mortal damage on the target equal to the D3 roll. If the target is **^^Infantry^^**, double the mortal damage inflicted.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="232-55a0-317f-f9cf" name="Strength From Victory" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If any damage points were allocated to an enemy unit by this unit's combat attacks this turn and that enemy unit has been destroyed, give this unit a **Waaagh! token**, to a maximum of 3.
Until the end of the next turn, add 1 to the Attacks characteristic of this unit's weapons for each **Waaagh! token** it has.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="ng8d87" name="Megaboss on Maw-krusha" entryId="d3e0-6a4-afe6-46f5::1282-b117-581a-3a07" number="1" type="model" from="entry"><selections><selection id="nm84yu" name="Boss-choppa or Boss-hacka" entryId="d3e0-6a4-afe6-46f5::766d-84fa-2882-b32c" number="1" type="upgrade" from="entry"><profiles><profile id="3d02-4bb-8efb-6690" name="Boss-choppa or Boss-hacka" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Infantry^^** (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="nn5ibah" name="Maw-krusha's Fists and Tail" entryId="d3e0-6a4-afe6-46f5::9116-3d-7cb3-afcf" number="1" type="upgrade" from="entry"><profiles><profile id="943b-26a8-50cf-e1e1" name="Maw-krusha's Fists and Tail" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">8</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-**^^Infantry^^** (+1 Rend), Companion</characteristic></characteristics></profile></profiles></selection><selection id="nne3rm8" name="Maw-krusha's Roar" entryId="d3e0-6a4-afe6-46f5::9347-2ae3-5d6-22a7" number="1" type="upgrade" from="entry"><profiles><profile id="7c87-431b-2516-2a43" name="Maw-krusha's Roar" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">8&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">6</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">-</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">1</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat, Companion</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="330" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="48d5-c85-c069-733a" name="MAW-KRUSHA" entryId="48d5-c85-c069-733a" primary="false" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /></categories></selection><selection id="o2h1t2l" name="Tuskboss on Maw-grunta" entryId="9c72-2d1d-778a-27d6::3520-fc6a-d4fc-1c1f" number="1" type="unit" from="entry"><profiles><profile id="4632-f3cd-fdae-addf" name="Tuskboss on Maw-grunta" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="ac77-f712-7ad8-318c" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Maw-grunta's Tusks** is 3.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="106-2a7e-b0f5-d29c" name="Head of the Stampede" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this phase, pick up to 3 friendly **^^Maw‑grunta^^** units wholly within 12&quot; of this unit that charged this turn to be the targets.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 **momentum point** to each target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="b59a-39f9-2271-db6e" name="Unstoppable Momentum" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this unit has charged as a result of using a **^^Charge^^** ability, it gains 1 **momentum point**. Each time it uses a **^^Run^^** ability, it gains 2 **momentum points**. It can have a maximum of 3 **momentum points** at once.
Add the number of **momentum points** this unit has to the Damage characteristic of its **^^Maw-grunta's Tusks^^**. At the end of each battle round, subtract 1 from its **momentum points**, to a minimum of 0.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="o36er0g" name="Tuskboss on Maw-grunta" entryId="9c72-2d1d-778a-27d6::2a0d-d010-cb8f-ddc7" number="1" type="model" from="entry"><selections><selection id="o8oqia3" name="Kill-choppas" entryId="9c72-2d1d-778a-27d6::5b32-e66a-2632-6934" number="1" type="upgrade" from="entry"><profiles><profile id="3ac1-1fff-710f-1d5b" name="Kill-choppas" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="o83h4q6" name="Maw-grunta's Trotters" entryId="9c72-2d1d-778a-27d6::7ee3-bbad-eba8-f196" number="1" type="upgrade" from="entry"><profiles><profile id="5c6f-25d7-63c5-7050" name="Maw-grunta's Trotters" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">5+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="o8jzzb8" name="Maw-grunta's Tusks" entryId="9c72-2d1d-778a-27d6::d9bd-6499-20c3-d732" number="1" type="upgrade" from="entry"><profiles><profile id="935a-6956-fe4-17db" name="Maw-grunta's Tusks" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Companion</characteristic></characteristics></profile></profiles></selection><selection id="o81xp4g" name="Pig-hacka" entryId="9c72-2d1d-778a-27d6::7f7b-ab3c-4653-a3cf" number="1" type="upgrade" from="entry"><profiles><profile id="156e-d7a1-7a7b-4956" name="Pig-hacka" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">7</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="270" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="6d54-625c-d063-13e2" name="MONSTER" entryId="6d54-625c-d063-13e2" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="ef0c-475e-6f5d-5c68" name="MAW-GRUNTA" entryId="ef0c-475e-6f5d-5c68" primary="false" /></categories></selection><selection id="oikzar3" name="Warchanter" entryId="3076-d691-5aa5-3d56::7d89-20b4-7ed4-6ca0" number="1" type="unit" from="entry"><profiles><profile id="da4f-b50-64a3-8545" name="Warchanter" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="1bd0-bd40-a9b8-eb02" name="Rhythm of Destruction" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If any enemy models were slain this turn by this unit's combat attacks, give this unit D3 ritual points.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="ojz6pt7" name="Warchanter" entryId="3076-d691-5aa5-3d56::b569-1b3-852c-eb58" number="1" type="model" from="entry"><selections><selection id="onlbr9" name="Gorkstikk and Morkstikk" entryId="3076-d691-5aa5-3d56::48b5-d012-bc1a-a5e9" number="1" type="upgrade" from="entry"><profiles><profile id="6044-1fcb-61c9-e15c" name="Gorkstikk and Morkstikk" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="3fe-84f4-cec6-a1c1" name="PRIEST (1)" entryId="3fe-84f4-cec6-a1c1" primary="false" /></categories></selection><selection id="ovi8rwk" name="Weirdnob Shaman" entryId="da11-fae6-a09f-d32c::e824-4e07-12f6-309c" number="1" type="unit" from="entry"><profiles><profile id="74-e154-5b4-4632" name="Weirdnob Shaman" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="73a6-66b9-f6f-4cf7" name="Brutal Power" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to this unit's power level while there are any friendly **^^Ironjawz^^** units that have 10 or more models wholly within 12&quot; of it.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="ow9w2zb" name="Weirdnob Shaman" entryId="da11-fae6-a09f-d32c::d5ca-4205-5103-d53b" number="1" type="model" from="entry"><selections><selection id="p0dtryq" name="Green Puke" entryId="da11-fae6-a09f-d32c::4f3f-8f01-ac9c-d6a2" number="1" type="upgrade" from="entry"><profiles><profile id="607e-d739-f806-fdb3" name="Green Puke" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">4</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">4+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">-</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="p0m3e5" name="Waaagh! Staff" entryId="da11-fae6-a09f-d32c::217-a68-7955-6a2" number="1" type="upgrade" from="entry"><profiles><profile id="ddcc-d3df-1179-36d" name="Waaagh! Staff" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">3</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">D3</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="110" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="6f28-c3f6-4b1b-8aff" name="WIZARD (1)" entryId="6f28-c3f6-4b1b-8aff" primary="false" /></categories></selection><selection id="p8t8phh" name="Zoggrok Anvilsmasha" entryId="8627-4cd3-fc78-9e8c::d4c-6af5-1346-a8ab" number="1" type="unit" from="entry"><profiles><profile id="1742-12cd-419a-69d9" name="Zoggrok Anvilsmasha" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="2f1e-9a5-dca3-bac8" name="Klonk" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">**Klonk** is a token. You can re-roll forgin' rolls for this unit while this unit's **Klonk** is on the battlefield. If you make an unmodified save roll of 1 for this unit, remove this unit's **Klonk** from the battlefield after the **^^Attack^^** ability has been resolved (the damage point is still inflicted).</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="be8b-b8e0-cf66-346f" name="Power of da Great Green God" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **^^Ironjawz Infantry^^** unit wholly within 12&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make a forgin' roll of D6. Add 1 to the roll if this unit is armed with **Grunta-tongs**. On a 4+, the target's melee weapons have **Crit (Mortal)** until the start of your next turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="3bc-444a-5cf8-e4d" name="Guarded Hero" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this **^^Hero^^** is within the combat range of a friendly unit that is not a **^^Hero^^**:
• Subtract 1 from hit rolls for shooting attacks that target this Hero.
• If this **^^Hero^^** is **^^Infantry^^**, they cannot be picked as the target of shooting attacks made by models more than 12&quot; from them.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="p93q6g" name="Zoggrok Anvilsmasha" entryId="8627-4cd3-fc78-9e8c::7c7d-23f9-7593-d940" number="1" type="model" from="entry"><selections><selection id="palcd79" name="Skull-crushing Basha" entryId="8627-4cd3-fc78-9e8c::7a83-64e6-f12a-1fa5" number="1" type="upgrade" from="entry"><profiles><profile id="1ebb-28f2-83bc-6ac3" name="Skull-crushing Basha" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">5</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="paqoj6" name="Grunta-tongs" entryId="8627-4cd3-fc78-9e8c::c574-9001-e496-607c" entryGroupId="8627-4cd3-fc78-9e8c::4d33-dc6e-caeb-57e" number="1" type="upgrade" from="group" group="Wargear Options"><selections><selection id="pb4n70v" name="Grunta-tongs" entryId="8627-4cd3-fc78-9e8c::d803-1200-1b24-d083" number="1" type="upgrade" from="entry"><profiles><profile id="921a-56c0-a711-ad41" name="Grunta-tongs" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="160" /></costs><categories><category id="6e72-1656-d554-528a" entryId="6e72-1656-d554-528a" name="HERO" primary="true" /><category id="72ce-2188-70bf-2dbd" name="UNIQUE" entryId="72ce-2188-70bf-2dbd" primary="false" /><category id="9057-5a29-dda5-3c28" name="DESTRUCTION" entryId="9057-5a29-dda5-3c28" primary="false" /><category id="c1ca-4b17-3512-89f" name="IRONJAWZ" entryId="c1ca-4b17-3512-89f" primary="false" /><category id="75d6-6995-dfcc-3898" name="INFANTRY" entryId="75d6-6995-dfcc-3898" primary="false" /></categories></selection><selection id="prdvooeq" name="Ardboyz" entryId="7355-7efd-73c7-8cd7::f757-3f6b-a13a-546a" number="1" type="unit" from="entry"><profiles><profile id="50b6-e26b-7d7d-378" name="Ardboyz" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="bbd6-2236-da77-3f8b" name="Shield Bash" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit within 1&quot; of this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make a shield bash roll of D6 for each model in this unit that is within 3&quot; of the target. For each 6+, inflict 1 mortal damage on the target.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="ptuztb" name="Ardboy" entryId="7355-7efd-73c7-8cd7::a2ef-910f-edbf-dbb6" number="1" type="model" from="entry"><selections><selection id="pujw7a6" name="Choppa or Stikka" entryId="7355-7efd-73c7-8cd7::58ed-25ad-af05-8603" number="1" type="upgrade" from="entry"><profiles><profile id="3b35-41ac-88ac-5780" name="Choppa or Stikka" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-charge (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="purid57" name="Champion" entryId="7355-7efd-73c7-8cd7::5314-89ab-1db9-dc18::9c21-1746-9873-a5b5" entryGroupId="7355-7efd-73c7-8cd7::3b9f-2def-e0d5-9828" number="1" type="upgrade" from="group" group="Command Models"><profiles><profile id="cfed-845b-b46c-fc6d" name="Champion" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of weapons used by champions in this unit. If this unit is a **^^Beast^^**, this ability affects this unit's **Companion** weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><categories><category id="9c77-5e0b-a20f-d885" name="Command Model" entryId="9c77-5e0b-a20f-d885" primary="false" /></categories></selection></selections></selection><selection id="pvna9rf" name="Ardboy" entryId="7355-7efd-73c7-8cd7::a2ef-910f-edbf-dbb6" number="1" type="model" from="entry"><selections><selection id="pwsg8kq" name="Choppa or Stikka" entryId="7355-7efd-73c7-8cd7::58ed-25ad-af05-8603" number="1" type="upgrade" from="entry"><profiles><profile id="3b35-41ac-88ac-5780" name="Choppa or Stikka" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Anti-charge (+1 Rend)</characteristic></characteristics></profile></profiles></selection><selection id="pwbhr7q" name="Standard Bearer" entryId="7355-7efd-73c7-8cd7::add3-8fe5-ed29-430a::7f34-77c9-597-62c3" entryGroupId="7355-7efd-73c7-8cd7::3b9f-2def-e0d5-9828" number="1" type="upgrade" fr