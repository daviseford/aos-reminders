563-5e53-cb13-50e8" name="Man-skewer Crossbows" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this unit uses a **^^Shoot^^** ability, pick either the **Hasty Shot** or **Aimed Shot** weapon characteristics for all the attacks it makes with its **Man‑skewer Crossbows**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="f8a-df8a-b4fb-2217" name="Pick 'Em Off" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit has not used a **^^Move^^** ability this turn and was not set up this turn, add 1 to hit rolls for this unit's shooting attacks for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="4eu7zmc" name="Man-skewer Boltboy" entryId="f9a-7715-eb57-3e9f::51ec-c7c0-ca97-596e" number="1" type="model" from="entry"><selections><selection id="4fv6i3p" name="Jaggedy Blades" entryId="f9a-7715-eb57-3e9f::5e4c-db40-43a-2a0e" number="1