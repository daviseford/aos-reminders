 id="oo9oel" name="Auric Hearthguard" entryId="d1af-898a-68a4-d074::a968-db0-69a-93c2" number="4" type="model" from="entry"><selections><selection id="oo88g2" name="Magmapike" entryId="d1af-898a-68a4-d074::ad85-3aef-c6c6-be56" number="4" type="upgrade" from="entry"><profiles><profile id="5661-8ee4-9085-5e5d" name="Magmapike" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">1</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">3+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile><profile id="9f04-f592-4ef7-7c7f" name="Magmapike" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">2</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">4+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D3</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100" /></costs><categories><category id="75d6-6995-dfcc-3898" entryId="75d6-6995-dfcc-3898" name="INFANTRY" primary="true" /><category id="f679-3bcb-d664-9ac3" name="CHAMPION" entryId="f679-3bcb-d664-9ac3" primary="false" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="70a4-383f-421f-52cd" name="WARD (6+)" entryId="70a4-383f-421f-52cd" primary="false" /><category id="6a02-a995-fd92-d806" name="FYRESLAYERS" entryId="6a02-a995-fd92-d806" primary="false" /><category id="72e3-7b1b-cb94-4cbd" name="DUARDIN" entryId="72e3-7b1b-cb94-4cbd" primary="false" /><category id="eeed-ef77-b0d-fa9d" name="MUSICIAN (1/10)" entryId="eeed-ef77-b0d-fa9d" primary="false" /></categories></selection><selection id="ozp4qb" name="Hearthguard Berzerkers with Berzerker Broadaxes" entryId="e87a-97e2-a124-4a45::d6c7-9adb-d1fd-2446" number="1" type="unit" from="entry"><profiles><profile id="17ad-7bd8-dad0-85d4" name="Hearthguard Berzerkers with Berzerker Broadaxes" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="b572-2f2a-a51f-77dc" name="Duty Unto Death" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While any friendly **^^Fyreslayers Infantry Heroes^^** are wholly within this unit's combat range, both this unit and those friendly units have **^^Ward (5+)^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="d5cd-1e68-3a86-aac4" name="Fires of Vengeance" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit is within the combat ranges of any damaged friendly **^^Fyreslayers Heroes^^**, add 1 to the Attacks characteristic of this unit's melee weapons.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="p12rdia" name="Hearthguard Berzerkers with Berzerker Broadaxes" entryId="e87a-97e2-a124-4a45::53dd-11df-d64e-be8e" number="1" type="model" from="entry"><selections><selection id="p1fxu1m" name="Berzerker Broadaxe" entryId="e87a-97e2-a124-4a45::594c-fdcf-253e-b4e8" number="1" type="upgrade" from="entry"><profiles><profile id="3b98-229f-dc1e-318b" name="Berzerker Broadaxe" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</