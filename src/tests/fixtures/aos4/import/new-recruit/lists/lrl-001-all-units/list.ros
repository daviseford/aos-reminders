8" name="INFANTRY" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="879-a29f-5c33-2e92" name="LUMINETH REALM-LORDS" entryId="879-a29f-5c33-2e92" primary="false" /><category id="5ef2-db09-d3cc-4b27" name="AELF" entryId="5ef2-db09-d3cc-4b27" primary="false" /><category id="9958-c5c0-c246-8010" name="VANARI" entryId="9958-c5c0-c246-8010" primary="false" /></categories></selection><selection id="2fv7mr" name="Ydrilan Riverblades" entryId="fc79-62e1-45e2-dedd::6e14-dd31-2bf8-c9d3" number="1" type="unit" from="entry"><profiles><profile id="c3de-a2a0-8d2c-9000" name="Ydrilan Riverblades" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">7&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">1</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic></characteristics></profile><profile id="d2a4-c3b8-7540-3ede" name="Relentless as the Driving Current" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is in combat, it can move 2D6&quot;. It can pass through models in enemy units but must end that move in combat.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="dcb0-8779-2edb-4133" name="Travel the Waterways" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Movement Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove this unit from the battlefield and set it up again on the battlefield wholly within 6&quot; of a battlefield edge and more than 9&quot; from all enemy units.
If you picked to depict **Ydriliqui, Rune of the River** on your **battle scripture** this battle round, you can instead set up this unit anywhere on the battlefield more than 9&quot; from all enemy units.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile></profiles><selections><selection id="2hy6fl7" name="Ydrilan Riverblade" entryId="fc79-62e1-45e2-dedd::7be2-3919-3539-bc92" number="1" type="model" from="entry"><selections><selection id="2iep1ac" name="Ydrilan Blades" entryId="fc79-62e1-45e2-dedd::8e09-19a5-69d8-3b09" number="1" type="upgrade" from="entry"><profiles><profile id="f24c-ab6e-7623-2da3" name="Ydrilan Blades" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">1</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="2i62kmf" name="Ythara Darts" entryId="fc79-62e1-45e2-dedd::6721-19b6-2acb-4c66" number="1" type="upgrade" from="entry"><profiles><profile id="bac4-30c-9271-180e" name="Ythara Darts" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic><characteristic name