c-4c88-277c-ea0a" name="CHAMPION (1/10)" entryId="3a1c-4c88-277c-ea0a" primary="false" /><category id="12be-7436-531a-a449" name="YDRILAN" entryId="12be-7436-531a-a449" primary="false" /></categories></selection><selection id="2xvhtfo" name="Alarith Spirit of the Mountain" entryId="b936-72c2-9b0e-cb9f::7d2e-77e2-bf89-491c" number="1" type="unit" from="entry"><profiles><profile id="8a91-8ee6-8781-9f72" name="Alarith Spirit of the Mountain" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="ebe4-5140-d5bd-1f50" name="Battle Damaged" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Stoneheart Worldhammer** is 3.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="6991-4501-7520-7dca" name="Rain of Stone" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. Add 2 to the roll if the target charged this turn. On a 2+, inflict an amount of mortal damage on the target equal to the roll.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="0405-956c-eb14-4cfe" name="With the Force of a Landslide" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of this unit's **Stoneheart Worldhammer** for each instance of **Alaithi, Rune of the Mountain** depicted on your **battle scripture**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="2yzdqw3" name="Alarith Spirit of the Mountain" entryId="b936-72c2-9b0e-cb9f::808-eeb1-225c-90ff" number="1" type="model" from="entry"><selections><selection id="2zusuf" name="Geomantic Blast" entryId="b936-72c2-9b0e-cb9f::ee60-9e09-ffa6-d4df" number="1" type="upgrade" from="entry"><profiles><profile id="9dbb-68c2-6cc8-c860" name="Geomantic Blast" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">12&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">1</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">2+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">D6</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="2zkt5ps" name="Stoneheart Worldhammer" entryId="b936-72c2-9b0e-cb9f::89df-2131-ac4d-3aec" number="1" type="upgrade" from="entry"><profiles><profile id="2fb6-55bc-565d-d330" name="Stoneheart Worldhammer" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">4+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">2+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">2</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">5</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="310" /></costs><categories><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="879-a29f-5c33-2e92" name="LUMINETH REALM-LORDS" entryId="879-a29f-5c33-2e92" primary="false" /><category id="af2a-8b41-2cec-8287" name="ALARITH" entryId="af2a-8b41-2cec-8287" primary="false" /></categories></selection><selection id="3aqc5s" name="Hurakan Spirit of the Wind" entryId="98bd-19f6-d8ec-9be7::4f9b-c3fa-a07b-59b0" number="1" type="unit" from="entry"><profiles><profile id="4f98-6d65-9b4b-ead7" name="Hurakan Spirit of the Wind" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">18&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic></characteristics></profile><profile id="965b-3fe1-c946-840" name="Hunters of Majestic Beasts" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The Damage characteristic of this unit's **Bow of the Wind's Vengeance** is 3 for attacks that target **^^Monsters^^**.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="bbae-ee18-f5c3-dcfb" name="Spirit of the Wind" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit used a **^^Shoot^^** ability this phase, this unit can move D6&quot;. Add 2 to the roll for each instance of **Oreali, Rune of the Wind** depicted on your **battle scripture**. It cannot end that move in combat.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Move^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="72a2-7f6c-d0f1-17ab" name="Hurricane Winds" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit that had any damage points allocated to it this turn by this unit's shooting attacks  to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, the target has **^^Strike-last^^** for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="8e01-c601-8a44-8f74" name="Fly" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">As this unit moves, it ignores other models, terrain features and the combat ranges of enemy units. It cannot end its move in combat unless specified in the ability that allowed it to move. Ignore any vertical distance moved for this unit.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile><profile id="ed70-f30-2f5a-747f" name="Ward Save" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In step 1 of the damage sequence (see 18.0), make a **ward roll** of D6 for each **damage point** in this unit's **damage pool**. If the roll equals or exceeds this unit's **ward value**, remove that damage point from the damage pool.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="3b1s0t4" name="Hurakan Spirit of the Wind" entryId="98bd-19f6-d8ec-9be7::49af-decd-a213-1d08" number="1" type="model" from="entry"><selections><selection id="3bdppjn" name="Bow of the Wind's Vengeance" entryId="98bd-19f6-d8ec-9be7::b84a-697-70f9-ffcf" number="1" type="upgrade" from="entry"><profiles><profile id="7812-a329-a54b-423c" name="Bow of the Wind's Vengeance" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">15&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">4</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">2+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">2</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Anti‑**^^Monster^^** (+1 Rend), Shoot in Combat</characteristic></characteristics></profile></profiles></selection><selection id="3bztd4" name="Swirling Shards" entryId="98bd-19f6-d8ec-9be7::9d76-5990-5bff-7275" number="1" type="upgrade" from="entry"><profiles><profile id="4e6-e65b-bba-e5eb" name="Swirling Shards" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">6</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">2+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="270" /></costs><categories><category id="ee22-3575-6590-25c" name="ORDER" entryId="ee22-3575-6590-25c" primary="false" /><category id="879-a29f-5c33-2e92" name="LUMINETH REALM-LORDS" entryId="879-a29f-5c33-2e92" primary="false" /><category id="6d54-625c-d063-13e2" entryId="6d54-625c-d063-13e2" name="MONSTER" primary="true" /><category id="b979-4c3e-7d0e-6921" name="FLY" entryId="b979-4c3e-7d0e-6921" primary="false" /><category id="52cc-95fd-6cd3-8f72" name="WARD (5+)" entryId="52cc-95fd-6cd3-8f72" primary="false" /><category id="aa49-5f07-8920-b6f7" name="HURAKAN" entryId="aa49-5f07-8920-b6f7" primary="false" /></categories></selection><selection id="3nn4j6" name="Vanari Starshard Ballista" entryId="a432-89c4-e457-e433::ac41-4a7-88c5-9ab2" number="1" type="unit" from="entry"><profiles><profile id="1187-ba2-a37e-83d0" name="Vanari Starshard Ballista" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit" from="entry"><characteristics><characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic><characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic><characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic><characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic></characteristics></profile><profile id="828b-2328-c7a1-20aa" name="Blinding Bolts" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" from="entry"><characteristics><characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Shooting Phase</characteristic><characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit that was targeted by all this unit's shooting attacks this phase to be the target.</characteristic><characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. Add 1 to the roll if the target is a **^^Monster^^**. On a 3+, subtract 1 from hit rolls for the target's attacks for the rest of the turn.</characteristic><characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic><characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic></characteristics><attributes><attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute><attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute><attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa" /></attributes></profile><profile id="c482-2503-bb47-ebe6" name="Scryhawks" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" from="entry"><characteristics><characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic><characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 6&quot; to the Range characteristic of this unit's **Starshard Bolts** while it is wholly within 12&quot; of any friendly **Vanari Auralan Sentinels** units.</characteristic></characteristics><attributes><attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute><attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute><attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8" /></attributes></profile></profiles><selections><selection id="3nai06g" name="Vanari Starshard Ballista" entryId="a432-89c4-e457-e433::c972-b86-5973-a280" number="1" type="model" from="entry"><selections><selection id="3pqjkmk" name="Crew's Arming Swords" entryId="a432-89c4-e457-e433::2f15-7814-172e-cb64" number="1" type="upgrade" from="entry"><profiles><profile id="9cfc-4b31-5a1b-281e" name="Crew's Arming Swords" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" from="entry"><characteristics><characteristic name="Atk" typeId="60e-35aa-31ed-e488">2</characteristic><characteristic name="Hit" typeId="26dc-168-b2fd-cb93">3+</characteristic><characteristic name="Wnd" typeId="61c1-22cc-40af-2847">4+</characteristic><characteristic name="Rnd" typeId="eccc-10fa-6958-fb73">-</characteristic><characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">1</characteristic><characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic></characteristics></profile></profiles></selection><selection id="3p6veff" name="Starshard Bolts" entryId="a432-89c4-e457-e433::48bb-28d8-d90a-f29f" number="1" type="upgrade" from="entry"><profiles><profile id="9e36-87ad-a37d-28f5" name="Starshard Bolts" hidden="false" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" from="entry"><characteristics><characteristic name="Rng" typeId="c6b5-908c-a604-1a98">24&quot;</characteristic><characteristic name="Atk" typeId="aa17-4296-2887-e05d">4</characteristic><characteristic name="Hit" typeId="194d-aeb6-5ba7-83b4">3+</characteristic><characteristic name="Wnd" typeId="d3d5-9dc6-13de-8d1">3+</characteristic><characteristic name="Rnd" typeId="d03f-a9ae-3eec-755">1</characteristic><characteristic name="Dmg" typeId="96c2-d0a5-ea1e-653b">2</characteristic><characteristic name="Ability" typeId="d793-3dd7-9c13-741e">Anti-**^^Monster^^** (+1 Rend), Crit (2 Hits)</characteristic></characteristics></profile></profiles></selection></selections></selection></selections><costs><cost name="pts" typeId="points" value="100