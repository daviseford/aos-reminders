{
  "name": "aos-reminders",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@auth0/auth0-react": "2.22.1",
    "@hello-pangea/dnd": "18.0.1",
    "bootstrap": "5.3.8",
    "core-js": "^3.49.0",
    "deepmerge": "4.3.1",
    "eslint-plugin-import": "^2.32.0",
    "fflate": "0.8.3",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.2.108",
    "qs": "^6.15.3",
    "react": "19.2.8",
    "react-bootstrap": "2.10.10",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.0.0",
    "react-ga4": "^3.0.1",
    "react-icons": "^5.7.0",
    "react-modal": "3.16.3",
    "react-router": "8.3.0",
    "react-select": "5.10.2",
    "react-switch": "7.1.0",
    "sass": "^1.102.0",
    "string.prototype.matchall": "^4.0.12"
  },
  "scripts": {
    "build": "tsc && vite build",
    "corpus:listbot": "vite-node --script src/tests/support/listbotCorpusCommand.ts",
    "data:aos4:cache:pull": "vite-node --script src/aos4/data/cacheCommand.ts pull",
    "data:aos4:cache:push": "vite-node --script src/aos4/data/cacheCommand.ts push",
    "data:aos4:candidate": "vite-node --script src/aos4/data/candidateCommand.ts",
    "data:aos4:candidate:bsdata": "vite-node --script src/aos4/data/bsdata/acquireCommand.ts",
    "data:aos4:discover-official": "vite-node --script src/aos4/data/gamesWorkshop/catalogCommand.ts",
    "data:aos4:certify": "vite-node --script src/aos4/review/certificationCommand.ts",
    "data:aos4:certify:prepare": "vite-node --script src/aos4/review/certificationPrepareCommand.ts",
    "data:aos4:certify:full": "yarn data:aos4:generate:candidate && yarn data:aos4:review:prepare && yarn data:aos4:certify --current data/aos4/certifications/beta.json --full",
    "data:aos4:generate": "node --expose-gc node_modules/vite-node/dist/cli.mjs --script src/aos4/generate/corpusCommand.ts",
    "data:aos4:generate:candidate": "yarn data:aos4:generate --candidate",
    "data:aos4:generate:candidate:write": "yarn data:aos4:generate --candidate --write",
    "data:aos4:generate:write": "yarn data:aos4:generate --candidate --write",
    "data:aos4:inventory": "vite-node --script src/aos4/review/sourceInventoryCommand.ts",
    "data:aos4:inventory:observe-bsdata": "vite-node --script src/aos4/review/bsDataSourceObservationCommand.ts",
    "data:aos4:inventory:observe-official": "vite-node --script src/aos4/review/gamesWorkshopObservationCommand.ts",
    "data:aos4:inventory:observe-wahapedia": "vite-node --script src/aos4/review/wahapediaObservationCommand.ts",
    "data:aos4:radar:observe": "vite-node --script src/aos4/radar/observeCommand.ts",
    "data:aos4:radar:observe-bsdata": "vite-node --script src/aos4/radar/bsDataObservationCommand.ts",
    "data:aos4:radar": "vite-node --script src/aos4/radar/rulesRadarCommand.ts",
    "data:aos4:radar:notify": "vite-node --script src/aos4/radar/rulesRadarNotifyCommand.ts",
    "data:aos4:radar:watch-provisional": "vite-node --script src/aos4/radar/provisionalWatchCommand.ts",
    "data:aos4:review:adversarial": "vite-node --script src/aos4/review/adversarialReviewCommand.ts",
    "data:aos4:review:prepare": "vite-node --script src/aos4/review/packetCommand.ts",
    "data:aos4:sweep": "vite-node --script src/aos4/review/officialProfileSweepCommand.ts",
    "data:aos4:verify:beta": "yarn data:aos4:certify --current data/aos4/certifications/beta.json",
    "fixtures:official-app": "vite-node --script src/tests/support/officialAppFixturesCommand.ts",
    "fixtures:new-recruit": "vite-node --script src/tests/support/newRecruitManifestCommand.ts",
    "fixtures:new-recruit:ingest": "vite-node --script src/tests/support/newRecruitIngestCommand.ts --",
    "format": "yarn prettier --write \"**/*.*(js|jsx|mjs|cjs|ts|tsx|mts|cts|json|scss|css|yml|yaml|html)\"",
    "gitclean:win": "git branch | %{ $_.Trim() } | ?{ $_ -ne 'master' } | %{ git branch -D $_ }",
    "gitclean": "git branch | grep -v \"master\" | xargs git branch -D",
    "lint": "eslint src --max-warnings 0",
    "prepush": "yarn lint && yarn tsc --noEmit && yarn build && yarn test --run",
    "release:inspect-artifact": "vite-node --script scripts/validateDeploymentConfig.ts artifact dist",
    "release:validate-config": "vite-node --script scripts/validateDeploymentConfig.ts config",
    "prepare": "husky",
    "start": "vite",
    "test": "cross-env TZ=UTC vitest",
    "up": "yarn install && yarn upgrade-interactive --latest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 edge version",
      "last 1 explorer version",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/lodash": "4.17.25",
    "@types/luxon": "^3",
    "@types/node": "22.20.1",
    "@types/qs": "6.15.1",
    "@types/react": "19.2.18",
    "@types/react-copy-to-clipboard": "5.0.7",
    "@types/react-dom": "19.2.4",
    "@types/react-modal": "3.16.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "pretty-quick": "^4.2.2",
    "replace-in-file": "^9.0.0",
    "source-map-explorer": "2.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "resolutions": {
    "typescript": "5.9.3",
    "@typescript-eslint/parser": "^8.66.0",
    "autoprefixer": "10.4.27",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
