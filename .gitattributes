# Auto detect text files and perform LF normalization
* text=auto

# Bash entry points are executed from Windows via WSL in the deployment contract tests.
*.sh text eol=lf

# Husky v9 hook files are extensionless shell scripts and must retain LF endings
.husky/* text eol=lf

# Create-only completion markers are byte-exact and must retain LF endings
.complete.json text eol=lf

# Changelog ledger, acceptance records, and generated artifact are byte-compared LF content
data/aos4/changelog/**/*.json text eol=lf
src/aos4/generated/changelog/*.json text eol=lf

# Ignore fixture files when detecting languages for Github
src/tests/fixtures/* linguist-vendored

# Captured tournament roster text is byte-pinned provenance and must retain LF endings
src/tests/fixtures/aos4/import/tournament/**/list.txt text eol=lf
